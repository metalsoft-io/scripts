#!/usr/bin/env bash
# ms-upgrade — import an offline image bundle, then bump matching tags and apply.
# Two modes (auto-detected, can be overridden with --mode):
#   * k8s    — k3s/ctr/nerdctl  + manifest yamls            + kubectl apply
#   * docker — docker/podman    + .env or docker-compose    + compose down/up
#
# k8s mode accepts two bundle formats (auto-detected from the tar listing):
#   * flat image tar  — a single docker-image archive, imported directly (legacy)
#   * multi-folder    — a tar(.gz) whose top level contains any of:
#       run-pre/      scripts → executed first, before anything else in the bundle
#       registry/     image tar/tar.gz archives → imported into the image store
#       repo/         files → copied into the 'repo' deployment volume
#                     (PV hostPath write if resolvable, else kubectl cp/exec)
#       helpers-bin/  binaries → installed to /usr/local/bin (sudo fallback)
#       run-post/     scripts → executed last, after the apply phase
#     run-pre/ and run-post/ scripts run in lexical order; a script that exits
#     non-zero is reported and the upgrade continues.
#
# Detection (same shape as diagnostics-collector):
#   * docker — if /opt/metalsoft/agents/docker-compose.{yaml,yml} exists AND
#              docker or podman is installed
#   * k8s    — if kubectl, k3s or ctr is installed
#
# Install:
#   sudo install -m 0755 ms-upgrade /usr/local/bin/ms-upgrade
#
# Examples:
#   ms-upgrade /root/k8s-images/license-v7.3.5.tar.gz       # k8s, autodetect
#   ms-upgrade --mode docker /tmp/agents-v7.3.5.tar.gz      # force docker mode
#   ms-upgrade -y /tmp/bundle.tar
#   ms-upgrade --skip-import                                 # NewTag inferred from image store
#   ms-upgrade --skip-import --new-tag v7.3.5                # explicit override

set -Eeuo pipefail

# ── Defaults ─────────────────────────────────────────────────────────────
MODE=""
MODE_OVERRIDE=""
MANIFESTS_DIR="/root/manifests"
AGENTS_DIR="/opt/metalsoft/agents"
IMAGE_FILE=""
NAMESPACE=""
NEW_TAG_OVERRIDE=""
OLD_TAG_OVERRIDE=""
ASSUME_YES=0
SKIP_IMPORT=0
SKIP_MANIFEST_UPDATE=0
SKIP_APPLY=0
DRY_RUN=0
LICENSE_MATCH=""               # auto-defaulted by mode if --license-match not given
LICENSE_MATCH_USER_SET=0
TMPDIR_RUN=""
BUNDLE_DIR=""
REPO_NS=""
REPO_COPY_DEFERRED=0

# ── Logging ──────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    C_RED=$'\e[31m'; C_GRN=$'\e[32m'; C_YEL=$'\e[33m'; C_BOLD=$'\e[1m'; C_DIM=$'\e[2m'; C_RST=$'\e[0m'
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BOLD=""; C_DIM=""; C_RST=""
fi
log()   { printf '%s[i]%s %s\n' "$C_BOLD" "$C_RST" "$*"; }
ok()    { printf '%s[✓]%s %s\n' "$C_GRN" "$C_RST" "$*"; }
warn()  { printf '%s[!]%s %s\n' "$C_YEL" "$C_RST" "$*" >&2; }
err()   { printf '%s[e]%s %s\n' "$C_RED" "$C_RST" "$*" >&2; }
die()   { err "$*"; exit 1; }
step()  { printf '\n%s━━ %s %s\n' "$C_BOLD" "$*" "$C_RST"; }
yel()   { printf '%s%s%s' "$C_YEL" "$*" "$C_RST"; }

cleanup() {
    local rc=$?
    if [[ -n "$TMPDIR_RUN" && -d "$TMPDIR_RUN" ]]; then
        rm -rf "$TMPDIR_RUN" || true
    fi
    exit "$rc"
}
on_err() {
    local rc=$? line=${1:-?} cmd=${2:-?}
    err "Failed at line $line (rc=$rc): $cmd"
}
trap 'on_err "$LINENO" "$BASH_COMMAND"' ERR
trap cleanup EXIT INT TERM

# ── Help ─────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: $(basename "$0") [options] <image-file>

Imports an image tarball (.tar or .tar.gz), then bumps tags in
the relevant config (manifests in k8s mode, .env or docker-compose.yaml in docker
mode), then applies the change.

In k8s mode the tarball may also be a multi-folder bundle whose top level
contains any of (detected automatically):
  run-pre/       scripts executed first, before anything else in the bundle
  registry/      image tar/tar.gz archives, imported into the image store
  repo/          files copied into the 'repo' deployment volume
                 (PV hostPath write if resolvable, else kubectl cp/exec)
  helpers-bin/   binaries installed to /usr/local/bin (sudo fallback)
  run-post/      scripts executed last, after the apply phase
Folders that are absent are skipped. run-pre/ and run-post/ scripts run in
lexical order; a script that exits non-zero is reported and the run continues.

Mode is auto-detected:
  * docker — if $AGENTS_DIR/docker-compose.{yaml,yml} exists AND docker/podman is installed
  * k8s    — if kubectl/k3s/ctr is installed

Arguments:
  <image-file>                Path to the .tar or .tar.gz to import.
                              Required unless --skip-import is given.

Options:
      --mode k8s|docker       Override mode auto-detection
  -m, --manifests-dir DIR     [k8s]    Folder of manifests (default: $MANIFESTS_DIR)
      --agents-dir DIR        [docker] Compose folder      (default: $AGENTS_DIR)
  -n, --namespace NS          [k8s]    kubectl namespace  (default: auto-detect)
      --license-match TOKEN   Substring identifying the upgrade-target image
                              (default: 'license' for k8s, 'ms-agent' for docker)
      --new-tag TAG           Override NewTag (otherwise parsed from import output;
                              with --skip-import, falls back to highest tag in the
                              local image store that is != OldTag)
      --old-tag TAG           Override OldTag (defaults: k8s → running cluster, then
                              license-deployment.yaml; docker → .env TAG=, then
                              docker-compose.yaml)
      --skip-import           Skip image import phase (no <image-file> needed)
      --skip-manifest-update  Skip the in-place tag rewrite
      --skip-apply            Skip the apply phase
  -y, --yes                   Non-interactive: assume "yes" to all prompts
      --dry-run               Show what would be done without changing state
  -h, --help                  Show this help
      --completion            Print the bash completion script (as first arg)
      --install-completion    Install the bash completion (root, as first arg)

Examples:
  ms-upgrade /root/k8s-images/license-v7.3.5.tar.gz
  ms-upgrade --mode docker /tmp/agents-v7.3.5.tar.gz
  ms-upgrade -y /tmp/bundle.tar
  ms-upgrade --skip-import                  # NewTag inferred from image store
  ms-upgrade --skip-import --new-tag v7.3.5 # explicit override

Exit codes:
  0  success                  2  bad usage         3  prereq missing
  4  import failure           5  tag-rewrite failure
  6  apply failure            7  user declined
EOF
}

# ── Bash completion ──────────────────────────────────────────────────────
# Self-contained on purpose: the executable self-updates via metalsoft-updates,
# so completion shipped elsewhere would drift from it.

_ms_print_completion() {
    cat <<'EOCOMP'
# Tags known to the local image store, for --new-tag/--old-tag.
_ms_upgrade_tags()
{
    local all
    all="$( { ctr -n k8s.io images ls -q 2>/dev/null
              docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null
            } | grep -iE 'metalsoft|license' )"
    # Fall back to every image when nothing looks MetalSoft-ish.
    [ -n "$all" ] || all="$( { ctr -n k8s.io images ls -q 2>/dev/null
                               docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null
                             } )"
    printf '%s\n' "$all" | awk -F: 'NF > 1 {print $NF}' | grep -E '^v?[0-9]' | sort -uV
}

_ms_upgrade_completion()
{
    local cur prev opts list
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev=""
    ((COMP_CWORD > 0)) && prev="${COMP_WORDS[COMP_CWORD - 1]}"
    COMPREPLY=()

    opts='--mode -m --manifests-dir --agents-dir -n --namespace --license-match
          --new-tag --old-tag --skip-import --skip-manifest-update --skip-apply
          -y --yes --dry-run -h --help --completion --install-completion'

    case "$prev" in
        --mode)
            COMPREPLY=( $(compgen -W 'k8s docker' -- "$cur") ); return 0 ;;
        -m|--manifests-dir|--agents-dir)
            COMPREPLY=( $(compgen -d -- "$cur") ); return 0 ;;
        -n|--namespace)
            list="$(kubectl get ns --no-headers 2>/dev/null | awk '{print $1}')"
            COMPREPLY=( $(compgen -W "$list" -- "$cur") ); return 0 ;;
        --new-tag|--old-tag)
            COMPREPLY=( $(compgen -W "$(_ms_upgrade_tags)" -- "$cur") ); return 0 ;;
        --license-match)
            return 0 ;;
    esac

    case "$cur" in
        -*) COMPREPLY=( $(compgen -W "$opts" -- "$cur") ); return 0 ;;
    esac

    # Positional argument: the image tarball / bundle.
    COMPREPLY=( $(compgen -d -- "$cur") )
    COMPREPLY+=( $(compgen -f -- "$cur" | grep -E '\.(tar|tar\.gz)$') )
    # Nothing typed yet: list the options too, otherwise the only hint that they
    # exist is typing '-' first.
    [[ -n "$cur" ]] || COMPREPLY+=( $(compgen -W "$opts" -- "") )
    return 0
}
complete -o filenames -F _ms_upgrade_completion ms-upgrade
EOCOMP
}

_ms_install_completion() {
    if [ "$EUID" -ne 0 ]; then
        echo "[i] Error: --install-completion must run as root"
        return 1
    fi
    local dir=/usr/share/bash-completion/completions
    [ -d "$dir" ] || dir=/etc/bash_completion.d
    [ -d "$dir" ] || { echo "[i] Error: no bash-completion directory found"; return 1; }

    printf '%s\n' \
        '# managed by ms-upgrade --install-completion' \
        'source <(ms-upgrade --completion)' > "$dir/ms-upgrade" || return 1

    # Drop the stale eager-loaded copy once the lazy directory is in use.
    [ "$dir" != /etc/bash_completion.d ] && rm -f /etc/bash_completion.d/ms-upgrade
    echo "[i] Installed bash completion to $dir/ms-upgrade"
    return 0
}

case "${1:-}" in
    --completion)         _ms_print_completion; exit 0 ;;
    # && / || form on purpose: keeps a failed install off the ERR trap set above.
    --install-completion) _ms_install_completion && exit 0; exit 1 ;;
esac

# ── Args ─────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --mode)                 MODE_OVERRIDE="${2:-}"; shift 2 ;;
        -m|--manifests-dir)     MANIFESTS_DIR="${2:-}"; shift 2 ;;
        --agents-dir)           AGENTS_DIR="${2:-}"; shift 2 ;;
        -n|--namespace)         NAMESPACE="${2:-}"; shift 2 ;;
        --license-match)        LICENSE_MATCH="${2:-}"; LICENSE_MATCH_USER_SET=1; shift 2 ;;
        --new-tag)              NEW_TAG_OVERRIDE="${2:-}"; shift 2 ;;
        --old-tag)              OLD_TAG_OVERRIDE="${2:-}"; shift 2 ;;
        --skip-import)          SKIP_IMPORT=1; shift ;;
        --skip-manifest-update) SKIP_MANIFEST_UPDATE=1; shift ;;
        --skip-apply)           SKIP_APPLY=1; shift ;;
        -y|--yes)               ASSUME_YES=1; shift ;;
        --dry-run)              DRY_RUN=1; shift ;;
        -h|--help)              usage; exit 0 ;;
        --) shift; break ;;
        -*) err "Unknown option: $1"; usage; exit 2 ;;
        *)
            if [[ -n "$IMAGE_FILE" ]]; then
                err "Unexpected extra argument: $1 (only one image file is accepted)"
                usage; exit 2
            fi
            IMAGE_FILE="$1"; shift ;;
    esac
done
while [[ $# -gt 0 ]]; do
    if [[ -n "$IMAGE_FILE" ]]; then
        err "Unexpected extra argument: $1"
        exit 2
    fi
    IMAGE_FILE="$1"; shift
done

# ── Helpers ──────────────────────────────────────────────────────────────
confirm() {
    local prompt="$1"
    if (( ASSUME_YES )); then
        log "$prompt [auto-yes]"
        return 0
    fi
    local ans
    read -r -p "$prompt [Y/n] " ans || ans=""
    case "${ans,,}" in
        ""|y|yes) return 0 ;;
        *)        return 1 ;;
    esac
}

mktempdir_or_die() {
    local d
    if ! d="$(mktemp -d -t ms-upgrade.XXXXXX 2>/dev/null)"; then
        err "Failed to create scratch directory via mktemp."
        err "Check that \$TMPDIR (or /tmp) exists, is writable, and has free space."
        exit 3
    fi
    [[ -d "$d" && -w "$d" ]] || die "Scratch dir not usable: $d"
    printf '%s' "$d"
}

find_compose_file() {
    local f
    for f in "$AGENTS_DIR/docker-compose.yaml" "$AGENTS_DIR/docker-compose.yml" \
             "$AGENTS_DIR/compose.yaml" "$AGENTS_DIR/compose.yml"; do
        [[ -f "$f" ]] && { printf '%s' "$f"; return 0; }
    done
    return 1
}

# Escape a string for use as a sed BRE *pattern*.
# Tags like "v7.3.4" contain "." which is a sed wildcard; without escaping,
# "s/:v7.3.4/:.../g" also matches ":v7X3X4".
sed_escape_pattern() {
    printf '%s' "$1" | sed -e 's/[]\/$*.^[]/\\&/g'
}
# Escape a string for use as a sed *replacement*. \, /, & are special.
sed_escape_replacement() {
    printf '%s' "$1" | sed -e 's/[\/&]/\\&/g'
}

# ── Mode detection ───────────────────────────────────────────────────────
detect_mode() {
    if [[ -n "$MODE_OVERRIDE" ]]; then
        case "$MODE_OVERRIDE" in
            k8s|docker) MODE="$MODE_OVERRIDE" ;;
            *) die "Invalid --mode '$MODE_OVERRIDE' (must be 'k8s' or 'docker')." ;;
        esac
        return 0
    fi
    if find_compose_file >/dev/null \
       && (command -v docker >/dev/null 2>&1 || command -v podman >/dev/null 2>&1); then
        MODE="docker"
        return 0
    fi
    if command -v kubectl >/dev/null 2>&1 \
       || command -v k3s >/dev/null 2>&1 \
       || command -v ctr >/dev/null 2>&1; then
        MODE="k8s"
        return 0
    fi
    die "Could not auto-detect mode (no compose file under $AGENTS_DIR, and no kubectl/k3s/ctr). Pass --mode k8s|docker."
}

# ─────────────────────────────────────────────────────────────────────────
# k8s mode
# ─────────────────────────────────────────────────────────────────────────
RUNTIME_KIND=""
RUNTIME_BIN=()

# containerd namespace holding the images kubelet actually pulls from. Bare
# `ctr`/`nerdctl` default to "default", where kubelet never looks — an import
# there "succeeds" and the pod still ErrImagePulls. Always pass it explicitly.
# Honours containerd's own CONTAINERD_NAMESPACE env var as the escape hatch;
# unrelated to -n/--namespace, which is the *kubectl* namespace.
CTR_NAMESPACE="${CONTAINERD_NAMESPACE:-k8s.io}"

detect_k8s_runtime_quiet() {
    if [[ ${#RUNTIME_BIN[@]} -gt 0 ]]; then return 0; fi
    # -n precedes the subcommand for both ctr and nerdctl, so image import /
    # load / image ls all inherit it.
    if command -v k3s >/dev/null 2>&1 \
       && (systemctl is-active --quiet k3s 2>/dev/null \
           || [[ -S /run/k3s/containerd/containerd.sock ]]); then
        RUNTIME_KIND="k3s"; RUNTIME_BIN=(k3s ctr -n "$CTR_NAMESPACE"); return 0
    elif command -v ctr >/dev/null 2>&1; then
        RUNTIME_KIND="ctr"; RUNTIME_BIN=(ctr -n "$CTR_NAMESPACE"); return 0
    elif command -v nerdctl >/dev/null 2>&1; then
        RUNTIME_KIND="nerdctl"; RUNTIME_BIN=(nerdctl -n "$CTR_NAMESPACE"); return 0
    fi
    return 1
}

detect_k8s_runtime() {
    detect_k8s_runtime_quiet || die "No k8s runtime found (k3s ctr / ctr / nerdctl)."
    log "Runtime: ${RUNTIME_KIND} (${RUNTIME_BIN[*]})"
}

k8s_image_import() {
    local file="$1"
    if [[ "$RUNTIME_KIND" == "nerdctl" ]]; then
        "${RUNTIME_BIN[@]}" load -i "$file"
    else
        "${RUNTIME_BIN[@]}" image import "$file"
    fi
}

wait_k8s_runtime_ready() {
    log "Waiting for k8s runtime to be ready..."
    local i=0
    until "${RUNTIME_BIN[@]}" image ls >/dev/null 2>&1; do
        ((i++))
        if (( i > 60 )); then die "Runtime did not become ready after 5 minutes."; fi
        sleep 5
    done
    ok "Runtime is ready."
}

k8s_import_one() {
    local file="$1"
    [[ -f "$file" ]] || { err "Not a file: $file"; return 1; }

    if [[ "$file" == *.gz ]]; then
        command -v gunzip >/dev/null 2>&1 || { err "gunzip not installed but needed for $file"; return 1; }
        log "Decompressing: $file"
        if (( DRY_RUN )); then
            printf '%s[dry-run]%s gunzip -f %q\n' "$C_DIM" "$C_RST" "$file"
        else
            gunzip -f -- "$file" || { err "Decompression failed: $file"; return 1; }
        fi
        file="${file%.gz}"
    fi

    log "Importing: $file"
    if (( DRY_RUN )); then
        printf '%s[dry-run]%s %s image import %q\n' "$C_DIM" "$C_RST" "${RUNTIME_BIN[*]}" "$file"
        return 0
    fi
    if ! k8s_image_import "$file" 2>&1 | tee -a "$TMPDIR_RUN/import.log"; then
        err "Import failed: $file"; return 1
    fi
    return 0
}

phase_k8s_import() {
    step "Phase 1: import image (k8s)"
    [[ -n "$IMAGE_FILE" ]] || die "No image file given. Pass it as the last argument, or use --skip-import"
    [[ -f "$IMAGE_FILE" ]] || die "File not found: $IMAGE_FILE"
    : > "$TMPDIR_RUN/import.log"
    if is_multi_bundle "$IMAGE_FILE"; then
        # Runtime is only needed if the bundle ships registry/ archives;
        # phase_k8s_bundle detects it right before importing them.
        phase_k8s_bundle || return 1
    else
        detect_k8s_runtime
        wait_k8s_runtime_ready
        k8s_import_one "$IMAGE_FILE" || return 1
        ok "Imported: $IMAGE_FILE"
    fi
}

# ── Multi-folder bundle (k8s only) ───────────────────────────────────────
# A bundle tar(.gz) whose top level contains any of run-pre/, registry/, repo/,
# helpers-bin/ or run-post/.

BUNDLE_FOLDERS='registry|repo|helpers-bin|run-pre|run-post'

is_multi_bundle() {
    local file="$1" listing
    # tar -t auto-detects gzip, so one branch covers .tar/.tar.gz/.tgz and
    # oddly-named bundles. `|| true`: head closing the pipe early makes tar
    # exit 141 under pipefail, which must not be treated as "not a bundle".
    listing="$(tar -tf "$file" 2>/dev/null | head -200 || true)"
    [[ -n "$listing" ]] || return 1
    # Match nested too — `tar czf b.tgz mybundle/` wraps the folders one level down.
    printf '%s\n' "$listing" | grep -qE "(^|/)($BUNDLE_FOLDERS)/"
}

# Execute every regular file in a bundle scripts folder, lexical order.
# A script that fails is reported and the run continues — a broken hook must
# not strand a half-applied upgrade.
run_bundle_scripts() {
    local sub="$1" dir="$BUNDLE_DIR/$1"
    [[ -n "$BUNDLE_DIR" && -d "$dir" ]] || return 0
    # Collect first: the loop must not hand `find`'s output to the scripts as stdin.
    local files=() f rc
    while IFS= read -r f; do files+=("$f"); done < <(find "$dir" -maxdepth 1 -type f | sort)
    if (( ${#files[@]} == 0 )); then
        warn "$sub/ present but contains no files."
        return 0
    fi
    step "Running $sub/ scripts (${#files[@]})"
    for f in "${files[@]}"; do
        if (( DRY_RUN )); then
            printf '%s[dry-run]%s %q\n' "$C_DIM" "$C_RST" "$f"
            continue
        fi
        log "Running: $(basename "$f")"
        chmod +x "$f" 2>/dev/null || true
        # </dev/null: a hook that reads stdin would otherwise block the upgrade
        # forever, including under -y. Hooks are not interactive.
        rc=0; "$f" </dev/null || rc=$?
        if (( rc == 0 )); then
            ok "$(basename "$f") finished."
        else
            warn "$(basename "$f") exited $rc — continuing."
        fi
    done
}

phase_k8s_bundle() {
    log "Multi-folder bundle detected (run-pre/, registry/, repo/, helpers-bin/, run-post/)."
    BUNDLE_DIR="$TMPDIR_RUN/bundle"
    mkdir -p "$BUNDLE_DIR"
    # Extract even in --dry-run (scratch dir only, auto-cleaned) so every
    # phase can print the exact per-file actions it would take.
    log "Extracting bundle to $BUNDLE_DIR"
    tar -xf "$IMAGE_FILE" -C "$BUNDLE_DIR" || { err "Bundle extraction failed: $IMAGE_FILE"; return 1; }

    # The folders may sit one level down inside a wrapper dir; point BUNDLE_DIR
    # at wherever they actually landed. (`|| true`: head SIGPIPEs find.)
    local anchor
    anchor="$(find "$BUNDLE_DIR" -maxdepth 3 -type d 2>/dev/null \
              | grep -E "/($BUNDLE_FOLDERS)\$" | sort | head -1 || true)"
    if [[ -n "$anchor" ]]; then
        BUNDLE_DIR="$(dirname "$anchor")"
        log "Bundle root: $BUNDLE_DIR"
    fi

    run_bundle_scripts run-pre

    if [[ -d "$BUNDLE_DIR/registry" ]]; then
        detect_k8s_runtime
        wait_k8s_runtime_ready
        local f found=0
        while IFS= read -r f; do
            case "$f" in
                *.tar|*.tar.gz) found=1; k8s_import_one "$f" || return 1 ;;
                # Loud, not silent: an unimportable archive here means NewTag
                # discovery later fails with a much more confusing message.
                *) warn "Ignoring unrecognized file in registry/: $(basename "$f")" ;;
            esac
        done < <(find "$BUNDLE_DIR/registry" -maxdepth 1 -type f | sort)
        if (( found )); then
            ok "Imported registry/ archives."
        else
            warn "registry/ present but contains no .tar/.tar.gz files."
        fi
    else
        log "No registry/ folder in bundle; skipping image import."
    fi

    # helpers-bin before repo: repo delivery can die on an unresolvable
    # namespace, and losing the local install to that would be gratuitous.
    if [[ -d "$BUNDLE_DIR/helpers-bin" ]]; then
        phase_helpers_install
    else
        log "No helpers-bin/ folder in bundle; skipping helpers install."
    fi

    if [[ -d "$BUNDLE_DIR/repo" ]]; then
        phase_repo_copy || warn "repo/ delivery failed; deliver manually (see above)."
    else
        log "No repo/ folder in bundle; skipping repo copy."
    fi
}

repo_resolve_ns() {
    if [[ -n "$REPO_NS" ]]; then return 0; fi
    command -v kubectl >/dev/null 2>&1 || die "kubectl not found in PATH (needed for repo/ delivery)."
    local ns
    ns="$(detect_namespace)"
    if [[ -z "$ns" ]] && kubectl get namespace demo-metalsoft >/dev/null 2>&1; then
        ns="demo-metalsoft"
    fi
    [[ -n "$ns" ]] || die "Could not determine namespace for repo operations; pass -n NAMESPACE."
    REPO_NS="$ns"
}

# Resolve where repo/ files should land. Prints "host <path>" or "pod <path>".
# Chain: repo-pvc → PV hostPath (direct host write) → deploy repo volumeMount
# 'repo-volume' → nginx-config ConfigMap 'alias' under /_internal/ → /mnt.
repo_resolve_dest() {
    local ns="$REPO_NS" pv hostPath mnt
    pv="$(kubectl -n "$ns" get pvc repo-pvc -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
    if [[ -n "$pv" ]]; then
        hostPath="$(kubectl get pv "$pv" -o jsonpath='{.spec.hostPath.path}' 2>/dev/null || true)"
        if [[ -n "$hostPath" && -d "$hostPath" ]]; then
            printf 'host %s' "$hostPath"; return 0
        fi
    fi
    mnt="$(kubectl -n "$ns" get deploy repo \
        -o jsonpath='{range .spec.template.spec.containers[*].volumeMounts[*]}{.name}{" "}{.mountPath}{"\n"}{end}' \
        2>/dev/null | awk '$1=="repo-volume"{print $2; exit}' || true)"
    if [[ -z "$mnt" ]]; then
        mnt="$(kubectl -n "$ns" get cm nginx-config -o jsonpath='{.data.nginx\.conf}' 2>/dev/null \
                | awk '/location \/_internal\//,/}/' \
                | grep -oE 'alias [^;]+' | head -1 \
                | sed -E 's/^alias +//; s:/+$::')" || true
    fi
    [[ -n "$mnt" ]] || mnt="/mnt"
    printf 'pod %s' "$mnt"
}

phase_repo_copy() {
    step "Phase 1b: deliver repo/ bundle files${1:+ ($1)}"
    repo_resolve_ns
    local mode dest
    read -r mode dest <<<"$(repo_resolve_dest)"
    log "Repo destination: $mode:$dest (namespace: $REPO_NS)"
    log "Files to deliver (relative paths preserved):"
    ( cd "$BUNDLE_DIR/repo" && find . ! -type d | sed 's|^\./|       - |' )

    if [[ "$mode" == "host" ]]; then
        if (( DRY_RUN )); then
            printf '%s[dry-run]%s cp -a %q/. %q/\n' "$C_DIM" "$C_RST" "$BUNDLE_DIR/repo" "$dest"
            return 0
        fi
        cp -a "$BUNDLE_DIR/repo/." "$dest/" || { err "Host-path copy to $dest failed."; return 1; }
        ok "Copied repo/ contents to $dest."
        return 0
    fi

    local pod
    pod="$(kubectl -n "$REPO_NS" get pod -l app.kubernetes.io/name=repo \
            -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
    if (( DRY_RUN )); then
        printf '%s[dry-run]%s kubectl -n %s cp %q/. %s:%s/\n' \
            "$C_DIM" "$C_RST" "$REPO_NS" "$BUNDLE_DIR/repo" "${pod:-<repo-pod>}" "$dest"
        return 0
    fi
    if [[ -z "$pod" ]] \
       || ! kubectl -n "$REPO_NS" wait --for=condition=ready "pod/$pod" --timeout=120s >/dev/null 2>&1; then
        warn "repo pod not ready; will retry repo/ delivery after the apply phase."
        REPO_COPY_DEFERRED=1
        return 0
    fi
    if kubectl -n "$REPO_NS" cp "$BUNDLE_DIR/repo/." "$pod:$dest/" 2>/dev/null; then
        ok "Copied repo/ contents into $pod:$dest."
        return 0
    fi
    warn "kubectl cp failed; trying kubectl exec tar stream..."
    if tar -C "$BUNDLE_DIR/repo" -cf - . | kubectl -n "$REPO_NS" exec -i "$pod" -- tar -xf - -C "$dest"; then
        ok "Copied repo/ contents into $pod:$dest (exec tar)."
        return 0
    fi
    err "Failed to deliver repo/ contents to $pod:$dest."
    warn "Manual: kubectl -n $REPO_NS cp $BUNDLE_DIR/repo/. $pod:$dest/"
    return 1
}

phase_helpers_install() {
    step "Phase 1c: install helpers-bin/ to /usr/local/bin"
    local f base
    for f in "$BUNDLE_DIR/helpers-bin"/*; do
        [[ -f "$f" ]] || continue
        base="$(basename "$f")"
        if (( DRY_RUN )); then
            printf '%s[dry-run]%s install -m 0755 %q /usr/local/bin/%s\n' "$C_DIM" "$C_RST" "$f" "$base"
            continue
        fi
        if install -m 0755 "$f" /usr/local/bin/ 2>/dev/null; then
            ok "Installed /usr/local/bin/$base"
        elif command -v sudo >/dev/null 2>&1 && sudo install -m 0755 "$f" /usr/local/bin/; then
            ok "Installed /usr/local/bin/$base (via sudo)"
        else
            warn "Could not install $base to /usr/local/bin (permissions?)."
        fi
    done
}

extract_old_tag_from_cluster() {
    command -v kubectl >/dev/null 2>&1 || return 1
    local images tags count
    images="$(kubectl get deploy -A \
        -o jsonpath='{range .items[*]}{range .spec.template.spec.containers[*]}{.image}{"\n"}{end}{range .spec.template.spec.initContainers[*]}{.image}{"\n"}{end}{end}' \
        2>/dev/null)" || return 1
    [[ -n "$images" ]] || return 1
    tags="$(printf '%s\n' "$images" \
        | grep -oE "${LICENSE_MATCH}:[A-Za-z0-9._+-]+" \
        | sed "s/^${LICENSE_MATCH}://" | sort -u)"
    count="$(printf '%s\n' "$tags" | grep -c . || true)"
    if [[ "$count" == "1" ]]; then
        printf '%s' "$tags"; return 0
    elif [[ "$count" -gt 1 ]]; then
        warn "Multiple '${LICENSE_MATCH}' tags running in cluster:"
        printf '%s\n' "$tags" | sed 's/^/        - /' >&2
        warn "Will fall through to manifest file; use --old-tag to override."
        return 1
    fi
    return 1
}

extract_old_tag_from_manifest() {
    local file="$MANIFESTS_DIR/license-deployment.yaml"
    [[ -f "$file" ]] || return 1
    grep 'image:' "$file" \
        | grep -oE "${LICENSE_MATCH}:[A-Za-z0-9._+-]+" \
        | head -1 | sed "s/^${LICENSE_MATCH}://"
}

rewrite_manifests() {
    local oldTag="$1" newTag="$2"
    local oldEsc newEsc
    oldEsc="$(sed_escape_pattern "$oldTag")"
    newEsc="$(sed_escape_replacement "$newTag")"
    local matched=()
    while IFS= read -r f; do matched+=("$f"); done < <(
        grep -lF ":${oldTag}" "$MANIFESTS_DIR"/*.yaml 2>/dev/null || true
    )
    if (( ${#matched[@]} == 0 )); then
        warn "No manifests in $MANIFESTS_DIR contain ':$oldTag'."
        return 0
    fi
    log "Files to rewrite (${#matched[@]}):"
    printf '       - %s\n' "${matched[@]}"
    local m
    for m in "${matched[@]}"; do
        if (( DRY_RUN )); then
            printf '%s[dry-run]%s sed -i "s/:%s/:%s/g" %q\n' "$C_DIM" "$C_RST" "$oldTag" "$newTag" "$m"
        else
            sed -i "s/:${oldEsc}/:${newEsc}/g" "$m" || { err "sed failed on $m"; return 1; }
        fi
    done
    ok "Rewrote ${#matched[@]} manifest(s)."
}

detect_namespace() {
    if [[ -n "$NAMESPACE" ]]; then
        printf '%s' "$NAMESPACE"; return 0
    fi
    local nsFile="$MANIFESTS_DIR/namespace.yaml" ns=""
    if [[ -f "$nsFile" ]]; then
        ns="$(awk '
            /^kind:[[:space:]]*Namespace/ {inNs=1; next}
            inNs && /^[[:space:]]*name:/ {gsub(/[\047\042 ]/,"",$2); print $2; exit}
        ' "$nsFile" || true)"
    fi
    if [[ -z "$ns" ]]; then
        ns="$(grep -hE '^[[:space:]]*namespace:[[:space:]]*' "$MANIFESTS_DIR"/*.yaml 2>/dev/null \
              | head -1 | awk '{print $2}' | tr -d "'\"")" || true
    fi
    printf '%s' "$ns"
}

phase_k8s_apply() {
    local ns="$1"
    [[ -n "$ns" ]] || die "Could not determine namespace; pass -n NAMESPACE."
    command -v kubectl >/dev/null 2>&1 || die "kubectl not found in PATH."
    if (( DRY_RUN )); then
        printf '%s[dry-run]%s kubectl -n %s apply -f %q\n' "$C_DIM" "$C_RST" "$ns" "$MANIFESTS_DIR"
        return 0
    fi
    # kubectl apply against the whole dir may flag non-manifest files (e.g. helm
    # values yamls). Don't treat that as fatal — partial applies are normal.
    ( cd "$MANIFESTS_DIR" && kubectl -n "$ns" apply -f . ) || true
}

# ─────────────────────────────────────────────────────────────────────────
# docker mode
# ─────────────────────────────────────────────────────────────────────────
DOCKER_BIN=""
COMPOSE_CMD=()

# Engine and compose are detected separately:
#   - the heuristic NewTag fallback only needs the engine (docker images)
#   - the apply phase additionally needs compose
# Conflating them blocks engine-only operations when compose is absent.

detect_engine_quiet() {
    if [[ -n "$DOCKER_BIN" ]]; then return 0; fi
    if command -v docker >/dev/null 2>&1; then
        DOCKER_BIN="docker"; return 0
    fi
    if command -v podman >/dev/null 2>&1; then
        DOCKER_BIN="podman"; return 0
    fi
    return 1
}

detect_compose_quiet() {
    if (( ${#COMPOSE_CMD[@]} > 0 )); then return 0; fi
    detect_engine_quiet || return 1
    if [[ "$DOCKER_BIN" == "docker" ]]; then
        if docker compose version >/dev/null 2>&1; then
            COMPOSE_CMD=(docker compose); return 0
        elif command -v docker-compose >/dev/null 2>&1; then
            COMPOSE_CMD=(docker-compose); return 0
        fi
    elif [[ "$DOCKER_BIN" == "podman" ]]; then
        if command -v podman-compose >/dev/null 2>&1; then
            COMPOSE_CMD=(podman-compose); return 0
        elif podman compose version >/dev/null 2>&1; then
            COMPOSE_CMD=(podman compose); return 0
        fi
    fi
    return 1
}

detect_docker_runtime() {
    detect_engine_quiet || die "Neither docker nor podman is installed."
    detect_compose_quiet || die "Found '$DOCKER_BIN' but no compose plugin or '${DOCKER_BIN}-compose' binary."
    log "Container engine: $DOCKER_BIN; compose: ${COMPOSE_CMD[*]}"
}

phase_docker_import() {
    step "Phase 1: import image (docker/podman)"
    [[ -n "$IMAGE_FILE" ]] || die "No image file given. Pass it as the last argument, or use --skip-import."
    [[ -f "$IMAGE_FILE" ]] || die "File not found: $IMAGE_FILE"
    if is_multi_bundle "$IMAGE_FILE"; then
        die "Multi-folder bundles (run-pre/, registry/, repo/, helpers-bin/, run-post/) are only supported in k8s mode."
    fi

    : > "$TMPDIR_RUN/import.log"

    if (( DRY_RUN )); then
        printf '%s[dry-run]%s %s load -i %q\n' "$C_DIM" "$C_RST" "$DOCKER_BIN" "$IMAGE_FILE"
        return 0
    fi

    log "Loading image: $IMAGE_FILE"
    # Recent docker/podman handle .tar.gz natively; try a direct load first.
    if "$DOCKER_BIN" load -i "$IMAGE_FILE" 2>&1 | tee -a "$TMPDIR_RUN/import.log"; then
        ok "Loaded: $IMAGE_FILE"
        return 0
    fi

    # Fallback: if it's a .gz, decompress and retry.
    if [[ "$IMAGE_FILE" == *.gz ]]; then
        warn "Direct load failed; decompressing $IMAGE_FILE and retrying..."
        command -v gunzip >/dev/null 2>&1 || die "gunzip needed but not installed."
        gunzip -f -- "$IMAGE_FILE" || die "Decompression failed: $IMAGE_FILE"
        IMAGE_FILE="${IMAGE_FILE%.gz}"
        log "Retrying with: $IMAGE_FILE"
        if "$DOCKER_BIN" load -i "$IMAGE_FILE" 2>&1 | tee -a "$TMPDIR_RUN/import.log"; then
            ok "Loaded: $IMAGE_FILE"
            return 0
        fi
    fi
    err "Failed to load image: $IMAGE_FILE"
    return 1
}

extract_old_tag_from_env() {
    local envfile="$AGENTS_DIR/.env"
    [[ -f "$envfile" ]] || return 1
    # Match TAG= or `export TAG=`, ignore comment lines, take the last definition.
    grep -E '^[[:space:]]*(export[[:space:]]+)?TAG=' "$envfile" \
        | grep -v '^[[:space:]]*#' \
        | tail -1 \
        | sed -E 's/^[[:space:]]*(export[[:space:]]+)?TAG=//' \
        | sed -E 's/[[:space:]]+#.*$//' \
        | sed -E 's/^["'"'"']//; s/["'"'"']$//' \
        | sed -E 's/[[:space:]]+$//'
}

extract_old_tag_from_compose() {
    local file
    file="$(find_compose_file)" || return 1
    grep 'image:' "$file" \
        | grep -oE "${LICENSE_MATCH}:[A-Za-z0-9._+-]+" \
        | head -1 | sed "s/^${LICENSE_MATCH}://"
}

docker_rewrite() {
    local oldTag="$1" newTag="$2"
    local oldEsc newEsc
    oldEsc="$(sed_escape_pattern "$oldTag")"
    newEsc="$(sed_escape_replacement "$newTag")"
    local envfile="$AGENTS_DIR/.env"
    if [[ -f "$envfile" ]]; then
        # Confirm a TAG= line actually exists before claiming an update.
        if ! grep -qE '^[[:space:]]*(export[[:space:]]+)?TAG=' "$envfile"; then
            err "$envfile has no TAG= line; can't rewrite. Add 'TAG=$oldTag' or use --skip-manifest-update."
            return 1
        fi
        log "Rewriting $envfile: TAG=${oldTag} → TAG=${newTag}"
        if (( DRY_RUN )); then
            printf '%s[dry-run]%s sed -i -E "s/^([[:space:]]*(export[[:space:]]+)?)TAG=.*/\\1TAG=%s/" %q\n' \
                "$C_DIM" "$C_RST" "$newTag" "$envfile"
        else
            sed -i -E "s/^([[:space:]]*(export[[:space:]]+)?)TAG=.*/\\1TAG=${newEsc}/" "$envfile" \
                || { err "sed on .env failed"; return 1; }
            local actual; actual="$(extract_old_tag_from_env || true)"
            if [[ "$actual" != "$newTag" ]]; then
                err ".env update verification failed: TAG= now reads '$actual', expected '$newTag'."
                err "Inspect $envfile manually."
                return 1
            fi
        fi
        ok "Updated $envfile."
        return 0
    fi
    local compose
    if compose="$(find_compose_file)"; then
        if grep -qF ":${oldTag}" "$compose"; then
            log "Rewriting $compose: :${oldTag} → :${newTag}"
            if (( DRY_RUN )); then
                printf '%s[dry-run]%s sed -i "s/:%s/:%s/g" %q\n' "$C_DIM" "$C_RST" "$oldTag" "$newTag" "$compose"
            else
                sed -i "s/:${oldEsc}/:${newEsc}/g" "$compose" || { err "sed on $compose failed"; return 1; }
            fi
            ok "Updated $compose."
            return 0
        fi
        warn "No occurrences of :${oldTag} in $compose."
        return 0
    fi
    err "Neither $envfile nor a compose file exists under $AGENTS_DIR."
    return 1
}

docker_apply() {
    if (( DRY_RUN )); then
        printf '%s[dry-run]%s ( cd %q && %s down && %s up -d )\n' \
            "$C_DIM" "$C_RST" "$AGENTS_DIR" "${COMPOSE_CMD[*]}" "${COMPOSE_CMD[*]}"
        return 0
    fi
    log "Running: cd $AGENTS_DIR && ${COMPOSE_CMD[*]} down"
    ( cd "$AGENTS_DIR" && "${COMPOSE_CMD[@]}" down ) || warn "compose down failed; continuing."
    log "Running: cd $AGENTS_DIR && ${COMPOSE_CMD[*]} up -d"
    ( cd "$AGENTS_DIR" && "${COMPOSE_CMD[@]}" up -d ) || warn "compose up -d failed."
    sleep 2
    log "Containers:"
    "$DOCKER_BIN" ps || true
}

# ─────────────────────────────────────────────────────────────────────────
# Shared tag discovery — branches on $MODE
# ─────────────────────────────────────────────────────────────────────────
OLD_TAG=""
OLD_TAG_SOURCE=""
NEW_TAG=""
NEW_TAG_SOURCE=""
NEW_TAG_CANDIDATES=""

extract_old_tag() {
    OLD_TAG=""; OLD_TAG_SOURCE=""
    if [[ -n "$OLD_TAG_OVERRIDE" ]]; then
        OLD_TAG="$OLD_TAG_OVERRIDE"
        OLD_TAG_SOURCE="--old-tag override"
        return 0
    fi
    local tag
    if [[ "$MODE" == "k8s" ]]; then
        tag="$(extract_old_tag_from_cluster || true)"
        if [[ -n "$tag" ]]; then
            OLD_TAG="$tag"; OLD_TAG_SOURCE="running cluster"; return 0
        fi
        tag="$(extract_old_tag_from_manifest || true)"
        if [[ -n "$tag" ]]; then
            OLD_TAG="$tag"; OLD_TAG_SOURCE="$MANIFESTS_DIR/license-deployment.yaml"; return 0
        fi
    elif [[ "$MODE" == "docker" ]]; then
        tag="$(extract_old_tag_from_env || true)"
        if [[ -n "$tag" ]]; then
            OLD_TAG="$tag"; OLD_TAG_SOURCE="$AGENTS_DIR/.env (TAG=)"; return 0
        fi
        tag="$(extract_old_tag_from_compose || true)"
        if [[ -n "$tag" ]]; then
            local cf; cf="$(find_compose_file 2>/dev/null || echo "$AGENTS_DIR/docker-compose.yaml")"
            OLD_TAG="$tag"; OLD_TAG_SOURCE="$cf"; return 0
        fi
    fi
    return 1
}

extract_new_tag() {
    NEW_TAG=""; NEW_TAG_SOURCE=""
    local oldTag="${1:-}"

    if [[ -n "$NEW_TAG_OVERRIDE" ]]; then
        NEW_TAG="$NEW_TAG_OVERRIDE"
        NEW_TAG_SOURCE="--new-tag override"
        return 0
    fi

    if [[ -s "${TMPDIR_RUN:-/dev/null}/import.log" ]]; then
        # A bundle's registry/ may ship several archives; take the highest tag,
        # not whichever archive happened to be imported first.
        local fromLog
        fromLog="$(grep -oE "${LICENSE_MATCH}:[A-Za-z0-9._+-]+" "$TMPDIR_RUN/import.log" \
                    | sed "s/^${LICENSE_MATCH}://" | sort -uV | tail -1)"
        if [[ -n "$fromLog" ]]; then
            NEW_TAG="$fromLog"
            NEW_TAG_SOURCE="import output"
            return 0
        fi
    fi

    # Heuristic fallback: highest tag in the local image store, excluding OldTag.
    local lsOut tags candidate
    if [[ "$MODE" == "k8s" ]]; then
        detect_k8s_runtime_quiet || return 1
        lsOut="$("${RUNTIME_BIN[@]}" image ls 2>/dev/null)"
    elif [[ "$MODE" == "docker" ]]; then
        detect_engine_quiet || return 1
        lsOut="$("$DOCKER_BIN" images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null)"
    else
        return 1
    fi

    tags="$(printf '%s\n' "$lsOut" \
            | grep -oE "${LICENSE_MATCH}:[A-Za-z0-9._+-]+" \
            | sed "s/^${LICENSE_MATCH}://" | sort -uV)"
    [[ -n "$tags" ]] || return 1
    candidate="$(printf '%s\n' "$tags" | tail -1)"
    [[ -n "$candidate" ]] || return 1

    NEW_TAG="$candidate"
    NEW_TAG_SOURCE="image store (highest semver, heuristic)"
    # Stash candidates so main() can print them — useful to spot wrong picks
    # when tags are non-semver (e.g. "develop-monorepo" sort-Vs below "v7.3.5").
    NEW_TAG_CANDIDATES="$tags"
    return 0
}

# ─────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────
main() {
    TMPDIR_RUN="$(mktempdir_or_die)"

    detect_mode
    if (( ! LICENSE_MATCH_USER_SET )); then
        if [[ "$MODE" == "k8s" ]]; then LICENSE_MATCH="license"; else LICENSE_MATCH="ms-agent"; fi
    fi
    log "Mode: $(yel "$MODE")  match-token: $(yel "$LICENSE_MATCH")"

    # ── Phase 1: import ──────────────────────────────────────────────────
    if (( SKIP_IMPORT )); then
        warn "Skipping import phase (--skip-import)."
    else
        if [[ "$MODE" == "k8s" ]]; then
            phase_k8s_import || die "Image import phase failed (rc=4)."
        else
            detect_docker_runtime
            phase_docker_import || die "Image import phase failed (rc=4)."
        fi
    fi

    if (( SKIP_MANIFEST_UPDATE && SKIP_APPLY )); then
        run_bundle_scripts run-post
        if (( REPO_COPY_DEFERRED )); then
            warn "repo/ delivery was deferred (pod not ready); deliver manually:"
            warn "  kubectl -n $REPO_NS cp <bundle>/repo/. <repo-pod>:<dest>/"
        fi
        ok "All remaining phases skipped. Done."
        exit 0
    fi

    local oldTag="" newTag=""

    # Tag discovery is only needed when we will actually rewrite (Phase 4).
    # If --skip-manifest-update is set we skip directly to Phase 5 (apply).
    if (( ! SKIP_MANIFEST_UPDATE )); then
        # ── Phase 2: OldTag ──────────────────────────────────────────────
        step "Phase 2: discover OldTag (current '$LICENSE_MATCH' tag)"
        if [[ "$MODE" == "k8s" ]]; then
            [[ -d "$MANIFESTS_DIR" ]] || die "Manifests dir not found: $MANIFESTS_DIR"
        else
            [[ -d "$AGENTS_DIR" ]] || die "Agents dir not found: $AGENTS_DIR"
        fi
        extract_old_tag || true
        oldTag="$OLD_TAG"
        if [[ -z "$oldTag" ]]; then
            if [[ "$MODE" == "k8s" ]]; then
                err "Could not determine OldTag (checked: --old-tag, running cluster, $MANIFESTS_DIR/license-deployment.yaml)."
            else
                err "Could not determine OldTag (checked: --old-tag, $AGENTS_DIR/.env TAG=, $AGENTS_DIR/docker-compose.{yaml,yml})."
            fi
            err "Pass --old-tag <tag> to set it explicitly."
            exit 5
        fi
        ok "OldTag: $(yel "$oldTag")  ${C_DIM}(from: $OLD_TAG_SOURCE)${C_RST}"

        # ── Phase 3: NewTag ──────────────────────────────────────────────
        step "Phase 3: discover NewTag (just-imported '$LICENSE_MATCH' image)"
        extract_new_tag "$oldTag" || true
        newTag="$NEW_TAG"
        if [[ -z "$newTag" ]]; then
            if (( SKIP_IMPORT )); then
                err "Could not determine NewTag (checked: --new-tag, import log, image store)."
                err "Pass --new-tag <tag> explicitly."
            else
                err "Could not determine NewTag from import output. Was a '$LICENSE_MATCH' image in the bundle?"
                err "You can override with --new-tag <tag>."
            fi
            exit 5
        fi
        ok "NewTag: $(yel "$newTag")  ${C_DIM}(from: $NEW_TAG_SOURCE)${C_RST}"
        if [[ "$NEW_TAG_SOURCE" == "image store"* ]]; then
            warn "NewTag was guessed by picking the highest semver from the local image store."
            warn "This is wrong if you are downgrading, OR if your tags aren't semver"
            warn "(e.g. 'develop-monorepo' sort-Vs below 'v7.3.5'). Pass --new-tag to override."
            if [[ -n "$NEW_TAG_CANDIDATES" ]]; then
                warn "Candidates considered (sorted -V):"
                printf '%s\n' "$NEW_TAG_CANDIDATES" | sed 's/^/        - /' >&2
            fi
        fi

        if [[ "$oldTag" == "$newTag" ]]; then
            ok "OldTag == NewTag ($oldTag); nothing to upgrade."
            run_bundle_scripts run-post
            exit 0
        fi

        # This script upgrades. Never downgrade unless the user said so explicitly.
        if [[ "$NEW_TAG_SOURCE" != "--new-tag override" ]]; then
            if [[ "$(printf '%s\n%s\n' "$oldTag" "$newTag" | sort -V | tail -1)" == "$oldTag" ]]; then
                err "NewTag ($newTag) is older than OldTag ($oldTag) — refusing to downgrade."
                err "If a downgrade is really intended, pass --new-tag $newTag explicitly."
                exit 5
            fi
        fi

        # ── Phase 4: rewrite ─────────────────────────────────────────────
        step "Phase 4: rewrite tags"
        local where
        if [[ "$MODE" == "k8s" ]]; then where="$MANIFESTS_DIR"; else where="$AGENTS_DIR"; fi
        if confirm "In $where I see the deploys, and I can upgrade the tag from $(yel "$oldTag") to $(yel "$newTag"), should I proceed?"; then
            if [[ "$MODE" == "k8s" ]]; then
                rewrite_manifests "$oldTag" "$newTag" || { err "Manifest rewrite failed."; exit 5; }
            else
                docker_rewrite "$oldTag" "$newTag" || { err "Rewrite failed."; exit 5; }
            fi
        else
            warn "User declined rewrite."
            exit 7
        fi
    else
        warn "Skipping tag discovery + rewrite (--skip-manifest-update)."
    fi

    # ── Phase 5: apply ───────────────────────────────────────────────────
    if (( SKIP_APPLY )); then
        warn "Skipping apply (--skip-apply)."
        run_bundle_scripts run-post
        if (( REPO_COPY_DEFERRED )); then
            warn "repo/ delivery was deferred (pod not ready) and apply is skipped; deliver manually:"
            warn "  kubectl -n $REPO_NS cp <bundle>/repo/. <repo-pod>:<dest>/"
        fi
        exit 0
    fi
    step "Phase 5: apply"
    if confirm "Should I apply the changes?"; then
        if [[ "$MODE" == "k8s" ]]; then
            local ns
            ns="$(detect_namespace)"
            [[ -n "$ns" ]] || die "Auto-detect failed; pass -n NAMESPACE."
            log "Namespace: $ns"
            phase_k8s_apply "$ns"
            if (( REPO_COPY_DEFERRED )); then
                REPO_COPY_DEFERRED=0
                phase_repo_copy "retry after apply" || true
                if (( REPO_COPY_DEFERRED )); then
                    warn "repo pod still not ready; deliver repo/ files manually:"
                    warn "  kubectl -n $REPO_NS cp <bundle>/repo/. <repo-pod>:<dest>/"
                fi
            fi
            run_bundle_scripts run-post
            ok "Done."
            log "To check pod status, run: $(yel "kw") or $(yel "kubectl -n $ns get pods")"
        else
            detect_docker_runtime
            docker_apply
            ok "Upgrade is done."
            log "To follow logs: $(yel "$DOCKER_BIN logs -f ms-agent")"
        fi
    else
        warn "User declined apply."
        if (( REPO_COPY_DEFERRED )); then
            warn "repo/ delivery was deferred (pod not ready); deliver manually:"
            warn "  kubectl -n $REPO_NS cp <bundle>/repo/. <repo-pod>:<dest>/"
        fi
        exit 7
    fi
}

main "$@"
