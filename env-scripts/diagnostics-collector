#!/bin/bash
# vi: et st=2 sts=2 ts=2 sw=2 cindent bg=dark ft=bash

# How to install:
# wget -q https://raw.githubusercontent.com/metalsoft-io/scripts/main/env-scripts/diagnostics-collector -O /usr/local/bin/diagnostics-collector && chmod +x /usr/local/bin/diagnostics-collector

if tput sgr0 &>/dev/null; then
	nc=$(tput sgr0)
	bold=$(tput bold)
	orange=$(tput setaf 3)
	lightred=$(tput setaf 9)
	lightgreen=$(tput setaf 10)
	gray=$(tput setaf 8)
else
	nc='' bold='' orange='' lightred='' lightgreen='' gray=''
fi

# DEBUG:
which tee &>/dev/null || { echo "ERROR: Please install 'tee'. Exiting..."; exit 1; }

# https://askubuntu.com/a/1001404/1113727
bash_log=$(mktemp)
exec 19> "$bash_log"
exec   > >(tee -ia "$bash_log")
exec  2> >(tee -ia "$bash_log" >&19)
# For trace output
export BASH_XTRACEFD="19"
export PS4='+[${SECONDS}s] '
set -x

#test "$EUID" -ne 0 && { echo -e "[\e[1;31m✗\e[0m] Please run as root"; exit 1; }
thedate="$(date +"%F-%H%M")"
backupFolder=/var/backups/metalsoft
backupFolder="${backupFolder%/}"

function usage {
	echo -e "[i] $( basename "$0") gathers diagnostics for MetalSoft. Optional parameters:
	${bold}-n${nc} ${orange}(Required)${nc} ${gray}specify a namespace [ -n demo-metalsoft ]${nc}
	${bold}-k${nc} ${gray}specify an alternative kubectl [ -k microk8s.kubectl ]${nc}
	${bold}-b${nc} ${gray}specify a backup folder [ -b /var/backups/metalsoft ]${nc}
	${bold}-c${nc} ${gray}Flag [ Use for Global Controller ]${nc}
	${bold}-a${nc} ${gray}Flag [ Use for Site Controller or Agent ]${nc}
	${bold}-d${nc} ${gray}Flag [ skip disk latency check ]${nc}
	${bold}-p${nc} ${gray}Flag [ Push the diagnostics to MetalSoft via HTTPS ]${nc}
	${bold}-e${nc} ${gray}Flag [ Extended collection of k8s resources and DBs ]${nc}"
	exit 0
}

# Push a diagnostics file to MetalSoft. Args: $1=url, $2=file, $3=trace_log_path.
# Echoes HTTP code on stdout; preserves curl's exit status.
# --speed-time/--speed-limit is a stall detector, NOT a max-time: aborts only on 120s of zero throughput.
function push_diag {
	curl --connect-timeout 10 \
		--speed-time 120 --speed-limit 1 \
		-v --trace-time \
		-sk -o /dev/null -w '%{http_code}' \
		"$1" -F diag=@"$2" 2>"$3"
}

#auto determine if we are on sc or gc:
gather=""
envname=""
k=""
test -f /opt/metalsoft/agents/docker-compose.yaml && type docker &>/dev/null && gather='sc' && envname="$(grep -oP '\s+- URL=.*' /opt/metalsoft/agents/docker-compose.yaml|tail -1 |cut -d/ -f3)"
type kubectl &>/dev/null && gather='gc' && k='kubectl '
type microk8s &>/dev/null && gather='gc' && k='microk8s.kubectl '
test "$gather" == 'gc' && test -n "${ns:-}" && envname="$ns"
pushfile=
extended=
pushfileFromArg=""
sqlUpgradeLogs=""
doNotAutoSend=""
debugOn=""
SKIP_DISK_LATENCY_CHECK=""
curl_no_proxy=""
newbackupFolder=""
mysqldump_exitcode_error=""
kubeconfig=""
ms_version=""
bsi_present=""

while getopts ":k:n:b:P:capezsxd" flag
do
	case "${flag}" in
		p) pushfile="1" ;;
		P) pushfileFromArg="${OPTARG}" ;;
		c) gather='gc' ;;
		a) gather='sc' ;;
		k) k="${OPTARG}" ;;
		n) envname="${OPTARG}" ;;
		b) backupFolder="${OPTARG}" ;;
		e) extended=1 ;;
		s) sqlUpgradeLogs=1 ;;
		z) doNotAutoSend=1 ;;
		x) debugOn=1 ;;
		d) SKIP_DISK_LATENCY_CHECK=1 ;;
		:) echo "Error: -${OPTARG} requires an argument." && exit 1;;
		h | *) usage;;
	esac
done
shift "$(( OPTIND - 1 ))"

if [ -n "$pushfileFromArg" ];then
	test -f "$pushfileFromArg" || { echo -e "[\e[1;31m✗\e[0m] File '$pushfileFromArg' does not exist"; exit 1; }
	curl_log="/tmp/diagnostics-collector-curl-${thedate}.log"
	echo -n "[i] Trying to auto-push the diagnostics file '$pushfileFromArg' to MetalSoft [HTTPS] ... "
	http_code="$(push_diag "https://diagnostics-report.metalsoft.io/?a=121&f=992&pushfromarg=1&ns=${envname}" "$pushfileFromArg" "$curl_log")"
	curl_exit=$?
	if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
		echo -e " Done (HTTP $http_code)\n"
		rm -f "$curl_log"
		exit 0
	else
		echo -e "\n[\e[1;31m✗\e[0m] Push failed (HTTP ${http_code:-000}, curl exit ${curl_exit}). Trace: $curl_log"
		exit 1
	fi
fi

test -n "$gather" && echo "[i] Collecting diagnostics for: ${gather^}" || { echo -e "[\e[1;31m✗\e[0m] please specify parameter -c [for Global Controller] or -a [for Site Controller or Agent]"; exit 1; }
test -z "$envname" && test "$gather" == 'gc' && echo "${lightred}[e] Please use -n to specify namespace${nc}" && exit 10;
set -u
originalBackupFolder=${backupFolder}
backupFolder=${backupFolder}/ms-diagnostics-${thedate}_${envname}__${gather}

function finish {
	echo "[i] cleaning up.."
	rm -rf "${backupFolder}"
	test -n "$newbackupFolder" && test "$newbackupFolder" != "$backupFolder" && rm -rf "${newbackupFolder}"
	exit 3
}
trap finish INT TERM
test -n "$debugOn" && set -x
mkdir -p "${backupFolder}" || { echo -e "[\e[1;31m✗\e[0m] ${backupFolder} could not be created. Please check path, permissions and available disk space"; exit 2; }

env | grep -qi _proxy && echo -e "${lightred}PROXY setup:" && env|grep -i _proxy && echo -ne "${nc}"

# --- Shared functions ---

# Echo the path of a kubeconfig that actually talks to the cluster.
# kubectl finds its own config, but helm (and other tools) only honour
# $KUBECONFIG / ~/.kube/config, so on k3s/rke2/microk8s/kubeadm nodes where
# root has no ~/.kube/config they fall back to localhost:8080 and fail.
# The probe is 'get ns', not 'get --raw /version': /version answers for any
# authenticated identity, so a node-level kubeconfig would pass the probe and then
# be rejected by RBAC on the real call. Returns 1 if no candidate works.
function detect_kubeconfig ()
{
	local c
	for c in "${KUBECONFIG:-}" \
		"${HOME:-/root}/.kube/config" \
		/etc/rancher/k3s/k3s.yaml \
		/etc/rancher/rke2/rke2.yaml \
		/etc/kubernetes/admin.conf \
		/var/snap/microk8s/current/credentials/client.config \
		/var/lib/rancher/k3s/server/cred/admin.kubeconfig
	do
		test -n "$c" && test -r "$c" || continue
		if timeout 20 $k_orig --kubeconfig "$c" get ns &>/dev/null; then
			echo "$c"
			return 0
		fi
	done
	return 1
}

# Dump the pre-restart logs of every container in a pod, one container at a time.
# `kubectl logs --all-containers --previous` aborts with a single BadRequest as soon as
# ONE container has no previous state - which is the normal case here, because every
# MetalSoft pod has a completed '<svc>-depends-on-license' init container. The result is
# zero log lines for the container that actually crashed, which is the whole point of
# asking for --previous. Verified on the demo controller: 4 of 7 pods produced nothing
# but "Error from server (BadRequest): previous terminated container ... not found".
function previous_logs ()   # $1=namespace  $2=pod
{
	local c containers
	containers="$(timeout 30 $k_orig -n "$1" get pod "$2" \
		-o jsonpath='{range .spec.initContainers[*]}{.name}{" "}{end}{range .spec.containers[*]}{.name}{" "}{end}' 2>/dev/null)"
	if [ -z "$containers" ];then
		echo ":: could not list containers of ${1}/${2} (pod gone, or API unreachable)"
		return 0
	fi
	# 60s, not 120: this runs once per container of every unhealthy pod, so the worst
	# case multiplies. A --previous log is read off the node's disk - it arrives fast or
	# it is not coming, and stalling here delays the whole collection on a broken cluster.
	for c in $containers;do
		echo ":::: previous log, container ${c}"
		timeout 60 $k_orig -n "$1" logs "$2" -c "$c" --timestamps --previous 2>&1
	done
}

# Filter `kubectl get pod[s] --no-headers` on stdin down to the pods worth looking at.
# 'grep -vw Running' is not enough: a pod can sit in Running with 0/1 or 2/4 ready
# containers forever (crashlooping sidecar, failing probe) and never show up.
# The READY column is found by pattern (m/n) so this works with and without -A:
# it echoes "<namespace> <name>" for -A input and "<name>" without.
function unhealthy_pods ()
{
	awk '{
		ri=0
		for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+\/[0-9]+$/) { ri=i; break }
		if (!ri) next                                  # no READY column, e.g. an error line
		status=$(ri+1)
		if (status=="Completed" || status=="Succeeded") next   # finished Jobs are not broken
		split($ri,r,"/")
		if (status!="Running" || r[1]!=r[2]) {
			out=$1
			for (i=2;i<ri;i++) out=out" "$i
			print out
		}
	}'
}

# Echo `kubectl get events -A -o wide`, newest last, plus any extra args ($@).
# Sorting cannot be done with a bare '--sort-by || fallback': when kubectl cannot
# resolve the sort field it prints "No resources found" and exits 0 - verified on k3s
# v1.36.2, where `get pods -A --sort-by=.bogusField` reported no resources for 38
# running pods. An exit-code fallback never fires and the file ships up empty. Compare
# row counts instead and keep the sorted output only when it did not swallow anything.
function get_events_wide ()
{
	local unsorted sorted
	unsorted="$(timeout 60 $k_orig get events -A -o wide "$@" 2>&1)"
	sorted="$(timeout 60 $k_orig get events -A -o wide "$@" --sort-by=.lastTimestamp 2>&1)"
	if [ "$(printf '%s\n' "$sorted" | wc -l)" -ge "$(printf '%s\n' "$unsorted" | wc -l)" ];then
		printf '%s\n' "$sorted"
	else
		echo ":: (--sort-by=.lastTimestamp dropped rows on this kubectl; showing unsorted)"
		printf '%s\n' "$unsorted"
	fi
}

# version_ge 7.4.3 7.0.0 -> true when $1 >= $2 (dotted versions, sort -V)
function version_ge ()
{
	test -n "$1" && test -n "$2" || return 1
	test "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" == "$2"
}

function create_dirs ()
{
	mkdir -p "${backupFolder}/system"
	mkdir -p "${backupFolder}/disk"
	mkdir -p "${backupFolder}/network"
	mkdir -p "${backupFolder}/ssl"
	if [ "$gather" == 'gc' ];then
		mkdir -p "${backupFolder}/k8s/cluster"
		mkdir -p "${backupFolder}/k8s/resources"
		mkdir -p "${backupFolder}/k8s/ingress"
		mkdir -p "${backupFolder}/k8s/logs"
		mkdir -p "${backupFolder}/k8s/bsi/varlog"
		mkdir -p "${backupFolder}/k8s/api_resources"
		mkdir -p "${backupFolder}/mysql"
		mkdir -p "${backupFolder}/couchdb"
	fi
	if [ "$gather" == 'sc' ];then
		mkdir -p "${backupFolder}/docker/agents"
		mkdir -p "${backupFolder}/docker/agents-logs"
		mkdir -p "${backupFolder}/docker/logs"
		mkdir -p "${backupFolder}/nfs"
	fi
}

function get_system ()
{
	cat /etc/environment 2>/dev/null > "${backupFolder}/system/environment.txt"
	env > "${backupFolder}/system/env.txt"
	test -f /etc/metalsoft && cp /etc/metalsoft "${backupFolder}/system/etc_metalsoft" 2>/dev/null
	stat "$(realpath "$0")" > "${backupFolder}/system/stat.txt" 2>&1 || true
	uptime > "${backupFolder}/system/uptime.txt" 2>&1 || true
	cat /etc/os-release > "${backupFolder}/system/os-release" 2>&1 || true
	uname -a > "${backupFolder}/system/uname.txt" 2>&1 || true
	free -h > "${backupFolder}/system/memory.txt" 2>&1 || true
	# Whole ring buffer, not tail -500: kernel messages that matter (martian source,
	# conntrack table full, OOM, EXT4 errors, link flaps) are usually older than the
	# last 500 lines. Timestamped where util-linux supports it, plain otherwise.
	dmesg --time-format iso > "${backupFolder}/system/dmesg.txt" 2>/dev/null \
		|| dmesg -T > "${backupFolder}/system/dmesg.txt" 2>/dev/null \
		|| dmesg > "${backupFolder}/system/dmesg.txt" 2>&1 || true
	# The ring buffer wraps; journald keeps kernel history across that (and reboots).
	# On a containerd host every container start emits apparmor= audit records; they were
	# ~100% of 90k lines on the demo controller and say nothing about the cluster. Drop
	# AppArmor records specifically, NOT all 'audit: type=1400': on RHEL/SELinux hosts
	# that is where 'avc: denied' appears, which is worth keeping. tail bounds what a
	# pathologically noisy host can add to the archive.
	command -v journalctl &>/dev/null && journalctl -k --no-pager --since "-14 days" -n 100000 2>&1 \
		| grep -v -e 'apparmor="' -e 'kauditd_printk_skb' | tail -n 20000 \
		> "${backupFolder}/system/journalctl_kernel.txt" || true
	command -v timedatectl &>/dev/null && timedatectl > "${backupFolder}/system/timedatectl.txt" 2>&1 || true
	cat /etc/hosts > "${backupFolder}/system/hosts" 2>&1 || true
	cat /etc/resolv.conf > "${backupFolder}/system/resolv.conf" 2>&1 || true
}

function get_network ()
{
	ip a > "${backupFolder}/network/ip_addr.txt" 2>&1 || true
	ip r > "${backupFolder}/network/ip_route.txt" 2>&1 || true
	ip link > "${backupFolder}/network/ip_link.txt" 2>&1 || true
	command -v iptables &>/dev/null && iptables -t filter -vxnL > "${backupFolder}/network/iptables.txt" 2>&1 || true
	ss -tlnp > "${backupFolder}/network/ss.txt" 2>&1 || true
	command -v nft &>/dev/null && nft list ruleset > "${backupFolder}/network/nftables.txt" 2>&1 || true
}

function get_ssl ()
{
	ls -laR /etc/ssl/certs/ &> "${backupFolder}/ssl/ls_etc_ssl_certs.txt" || true
	test -d /etc/pki/tls/certs/ && ls -laR /etc/pki/tls/certs/ &> "${backupFolder}/ssl/ls_etc_pki_tls_certs.txt" || true
	test -d /etc/pki/ca-trust/source/anchors/ && ls -laR /etc/pki/ca-trust/source/anchors/ &> "${backupFolder}/ssl/ls_etc_pki_ca_trust_anchors.txt" || true
	test -d /usr/local/share/ca-certificates/ && ls -laR /usr/local/share/ca-certificates/ &> "${backupFolder}/ssl/ls_usr_local_share_ca_certs.txt" || true
	test -f /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem && grep "^# " /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem > "${backupFolder}/ssl/ca_bundle_headers.txt" || true
	test -d /etc/ssl/certs/ && tar czf "${backupFolder}/ssl/etc_ssl_certs.tar.gz" /etc/ssl/certs/ &>/dev/null
	test -f /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem && cp /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem "${backupFolder}/ssl/ca_bundle.pem" || true
	test -d /etc/pki/ca-trust/source/anchors/ && \ls /etc/pki/ca-trust/source/anchors/|while read -r z;do echo ":::: $z";openssl x509 -noout -subject -in "/etc/pki/ca-trust/source/anchors/$z";done > "${backupFolder}/ssl/anchor_subjects.txt" || true
	test -f /etc/ssl/certs/ca-certificates.crt && cp /etc/ssl/certs/ca-certificates.crt "${backupFolder}/ssl/ca_certificates.crt" || true
}

function get_disks ()
{
	df -h > "${backupFolder}/disk/df.txt" 2>&1 || true
	lsblk > "${backupFolder}/disk/lsblk.txt" 2>&1 || true
	fdisk -l > "${backupFolder}/disk/fdisk.txt" 2>&1 || true
}

function get_k8s_cluster ()
{
	timeout 60 $k_orig version > "${backupFolder}/k8s/cluster/version.txt" 2>&1 || true
	timeout 120 $k_orig describe nodes > "${backupFolder}/k8s/cluster/nodes.txt" 2>&1 || true
	timeout 60 $k_orig top nodes > "${backupFolder}/k8s/cluster/top_nodes.txt" 2>&1 || true
	timeout 60 $k_orig top pods -A > "${backupFolder}/k8s/cluster/top_pods.txt" 2>&1 || true

	# Events are pruned by kube-apiserver --event-ttl (1h by default), so this is a
	# narrow window no matter what we do. Widen what we can: -o wide adds the source
	# and object, the yaml keeps firstTimestamp/count/series (a 1h-old event with
	# count=80514 tells you it has been failing for weeks), and a Warning-only view
	# makes the file scannable.
	{
		echo ":: NOTE: the API only retains events for ~1h (kube-apiserver --event-ttl)."
		echo ":: For older history use the 'count'/'firstTimestamp' fields in events.yaml,"
		echo ":: the Events section of k8s/logs/describe_pod_*.txt, and container restart counts."
		echo
		get_events_wide
	} > "${backupFolder}/k8s/cluster/events.txt" 2>&1 || true
	timeout 60 $k_orig get events -A -o yaml > "${backupFolder}/k8s/cluster/events.yaml" 2>&1 || true
	get_events_wide --field-selector type=Warning > "${backupFolder}/k8s/cluster/events_warnings.txt" 2>&1 || true

	if command -v helm &>/dev/null; then
		{
			echo ":: kubeconfig used: ${kubeconfig:-<none found, helm used its own defaults>}"
			echo
			if [ -n "$kubeconfig" ]; then
				KUBECONFIG="$kubeconfig" timeout 60 helm list -A 2>&1
			else
				timeout 60 helm list -A 2>&1
			fi
		} > "${backupFolder}/k8s/cluster/helm_releases.txt" || true
	fi
}

function get_k8s ()
{
	{
		echo -e "\n:: kubectl get node -o wide\n"
		$k get node -o wide 2>&1 || true
		echo -e "\n:: kubectl get pod -A\n"
		$k get pod -A -o wide 2>&1 || true
		echo -e "\n:: kubectl get svc -A\n"
		$k get svc -A 2>&1 || true
		echo -e "\n:: kubectl get deploy -A -o wide\n"
		$k get deploy -A -o wide 2>&1 || true
		echo -e "\n:: kubectl get pv -A\n"
		$k get pv -A 2>&1 || true
		echo -e "\n:: kubectl get pvc -A\n"
		$k get pvc -A 2>&1 || true
		echo -e "\n:: kubectl get ipaddresspool -A\n"
		$k get ipaddresspool -A 2>&1 || true
		echo -e "\n:: kubectl -n metallb-system get pods\n"
		$k -n metallb-system get pods 2>&1 || true
	} >> "${backupFolder}/k8s/resources/stats.txt"

	$k_orig -n metallb-system get pods --no-headers | unhealthy_pods | while read -r pod
do
	echo -e "\n:: Logs for metallb-system $pod\n" >> "${backupFolder}/k8s/resources/metallb_logs.txt"
	timeout 120 $k_orig -n metallb-system logs "$pod" --timestamps --all-containers=true --prefix=true >> "${backupFolder}/k8s/resources/metallb_logs.txt" 2>&1 || true
done

	$k get ingressroute --no-headers|awk '{print $1}'|while read -r z;do $k get ingressroute "$z" -o yaml > "${backupFolder}/k8s/ingress/ingressroute_${z}.yaml";done || true
	$k get ingressroutetcp --no-headers|awk '{print $1}'|while read -r z;do $k get ingressroutetcp "$z" -o yaml > "${backupFolder}/k8s/ingress/ingressroutetcp_${z}.yaml";done || true
	$k get ingressrouteudp --no-headers|awk '{print $1}'|while read -r z;do $k get ingressrouteudp "$z" -o yaml > "${backupFolder}/k8s/ingress/ingressrouteudp_${z}.yaml";done || true

	{
		echo ":: pods that are not Running, or Running with containers not ready (READY m/n, m<n)."
		echo ":: Completed/Succeeded pods are skipped."
		$k_orig get pod -A --no-headers | unhealthy_pods | while read -r pns pname;do
			echo -e "\n:::: k describe pod -n ${pns} ${pname}\n"
			timeout 60 $k_orig describe pod -n "$pns" "$pname" 2>&1 || true
			echo -e "\n:::: previous (pre-restart) logs for ${pns}/${pname}, tail\n"
			previous_logs "$pns" "$pname" 2>&1 | tail -300 || true
		done
	} &> "${backupFolder}/k8s/resources/not_running.txt" || true
}

if [ "$gather" == 'gc' ];then
	# Extract hostname from configuration files
	config_hostname=""
	if [ -f /root/manifests/configmaps.yaml ]; then
		config_hostname="$(grep -oP 'cookie_domain: "\.\K.*[^"]' /root/manifests/configmaps.yaml 2>/dev/null | head -1)"
	fi
	if [ -z "$config_hostname" ] && [ -f /root/manifests/ingressroutes.yaml ]; then
		config_hostname="$(grep replacement: /root/manifests/ingressroutes.yaml 2>/dev/null | cut -d/ -f3 | head -1)"
	fi

	# Use extracted hostname if available, otherwise fall back to envname
	if [ -n "$config_hostname" ]; then
		envnamelabel="-${envname}-${config_hostname}-gc"
	else
		envnamelabel="-${envname}-gc"
	fi
    test -n "$config_hostname" && newbackupFolder="$(echo "${backupFolder}"|sed "s/__/-${config_hostname}-/")"

	if ! type $k >/dev/null 2>&1 ;then echo -e "[\e[1;31m✗\e[0m] ${bold}$k${nc} was not found. Exiting.."; exit 1;fi
	# Store original k for operations that don't need namespace
	k_orig="$k"
	test -z "$envname" && envname=$($k_orig get pod -A|grep -v '^default'|grep mysql|head -1|awk '{print $1}') && test -z "$config_hostname" && envnamelabel="-${envname}-gc"
	test -n "$envname" && echo -e "[i] Namespace [-n]: \e[1;31m${envname}\e[0m"

	# Update k to include namespace
	k="$k -n $envname"

	# TODO: in cases where env is not found, we should still collect info on what went wrong
	if ! $k_orig get ns|grep -q "$envname" ;then echo -e "[\e[1;31m✗\e[0m] Namespace \e[1;31m${envname}\e[0m not found. Exiting..";$k_orig get ns;exit 1;fi
	#mysql_pod="$($k -n $envname get pods --no-headers|grep mysql-|awk '{print $1}' | head -n 1)"

	kubeconfig="$(detect_kubeconfig || true)"
	test -n "$kubeconfig" && echo -e "[i] kubeconfig: ${kubeconfig}" || echo -e "${orange}[!] no working kubeconfig found; helm output may be empty${nc}"

	# MetalSoft version, read off the license deployment image tag (present in every release).
	ms_version="$(timeout 30 $k get deploy license -o jsonpath='{.spec.template.spec.containers[*].image}' 2>/dev/null \
		| tr ' ' '\n' | grep -oP ':v?\K[0-9]+\.[0-9]+\.[0-9]+[^ ]*' | head -1)"
	# bsi was removed in 7.0.0. Gate on the deployment actually existing (authoritative,
	# also covers unparsable tags like :latest) and keep the version for the report.
	timeout 30 $k get deploy bsi &>/dev/null && bsi_present=1
	test -n "$ms_version" && echo -e "[i] MetalSoft version: \e[1;32m${ms_version}\e[0m"
	if [ -z "$bsi_present" ];then
		if version_ge "${ms_version:-0}" 7.0.0; then
			echo "[i] bsi deployment absent (expected on >= 7.0.0): skipping BSI checks"
		elif [ -n "$ms_version" ];then
			# bsi should exist below 7.0.0 - its absence is itself a finding, not a skip.
			echo -e "${orange}[!] bsi deployment MISSING on MetalSoft ${ms_version} (< 7.0.0), where it is expected: skipping BSI checks${nc}"
		else
			echo "[i] bsi deployment absent (MetalSoft version undetermined): skipping BSI checks"
		fi
	fi

	create_dirs
	get_system
	get_network
	get_disks
	get_ssl
	get_k8s_cluster

	if [ -z "$SKIP_DISK_LATENCY_CHECK" ];then
		echo "[i] checking disk latency [100mb temp file] .."
		if [ -n "$bsi_present" ];then
			echo -e "\n:: BSI: df -h\n" >> "${backupFolder}/disk/bsi_df.txt"
			timeout 60 $k exec -it deploy/bsi -- bash -c "df -h" >> "${backupFolder}/disk/bsi_df.txt" 2>&1
			echo -e "\n:: time dd if=/dev/zero of=/testfile bs=4096 count=24400 oflag=direct status=progress\n" >> "${backupFolder}/disk/latency.txt"
			timeout 300 $k exec -it deploy/bsi -- bash -c "time dd if=/dev/zero of=/testfile bs=4096 count=24400 oflag=direct status=progress;rm -f /testfile" >> "${backupFolder}/disk/latency.txt" 2>&1
			echo -e "\n:: time dd if=/dev/zero of=/var/log/testfile bs=4096 count=24400 oflag=direct status=progress\n" >> "${backupFolder}/disk/latency.txt"
			timeout 300 $k exec -it deploy/bsi -- bash -c "time dd if=/dev/zero of=/var/log/testfile bs=4096 count=24400 oflag=direct status=progress;rm -f /var/log/testfile" >> "${backupFolder}/disk/latency.txt" 2>&1
		else
			# No bsi container to write into (>= 7.0.0). Measure the node's own disks
			# instead, otherwise every 7.x dump ships an empty latency.txt.
			echo "############ bsi deployment absent${ms_version:+ (MetalSoft ${ms_version})}: measured on the node instead of inside bsi" >> "${backupFolder}/disk/bsi_df.txt"
			for _dlpath in "${backupFolder}" /var/log;do
				echo -e "\n:: node: time dd if=/dev/zero of=${_dlpath}/testfile bs=4096 count=24400 oflag=direct status=progress\n" >> "${backupFolder}/disk/latency.txt"
				{ time timeout 300 dd if=/dev/zero of="${_dlpath}/testfile" bs=4096 count=24400 oflag=direct status=progress ; } >> "${backupFolder}/disk/latency.txt" 2>&1
				rm -f "${_dlpath}/testfile"
			done
			unset _dlpath
		fi
	else
		echo "[-] Skipping disk latency check"
		echo "############ disk latency check skipped" >> "${backupFolder}/disk/latency.txt"
	fi
	get_k8s

	mkdir -p "${backupFolder}/mysql"
	if [ "$extended" == '1' ];then
		echo "[i] backing up mysql databases.."
		#backup all mysql DBs:
		mysqldump_opts='--skip-comments'
		all_dbs="$(timeout 60 $k exec deploy/mysql -- mysql -AN $mysqldump_opts -e 'show databases' | grep -Ev "^(Database|performance_schema|information_schema|sys)$")"
		while read -r z;do
			_outfile="${backupFolder}/mysql/mysqldatabase_${z}_${envname}.sql.gz"
			if [ "$z" == "mysql" ];then
				timeout 1800 $k exec deploy/mysql -- mysqldump $mysqldump_opts --set-gtid-purged=OFF --databases "$z" --triggers --routines --events --add-drop-table --add-drop-database --single-transaction| sed '/.*DROP DATABASE IF EXISTS `mysql`/d' |gzip > "$_outfile"
			else
				timeout 1800 $k exec deploy/mysql -- mysqldump $mysqldump_opts --set-gtid-purged=OFF --databases "$z" --triggers --routines --events --add-drop-table --add-drop-database --single-transaction|gzip > "$_outfile"
			fi
			_pipe_rc=("${PIPESTATUS[@]}")
			if (( ${_pipe_rc[0]} + ${_pipe_rc[1]:-0} + ${_pipe_rc[2]:-0} )) || ! gzip -t "$_outfile" 2>/dev/null; then
				echo "${lightred}[!] mysqldump warning for '$z': exit codes=${_pipe_rc[*]}, gzip integrity=$(gzip -t "$_outfile" 2>&1 || echo FAILED). File may be incomplete.${nc}"
			fi
		done <<< "$all_dbs"
	fi

	echo "[i] backing up mysql locks.."
	# get information_schema.innodb_trx
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SHOW ENGINE INNODB STATUS\G' &> "${backupFolder}/mysql/mysql_show_engine_innodb_status" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'show full processlist' &> "${backupFolder}/mysql/mysql_show_full_processlist" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'show global variables\G' &> "${backupFolder}/mysql/mysql_show_global_variables" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'show session variables\G' &> "${backupFolder}/mysql/mysql_show_session_variables" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SELECT * FROM information_schema.innodb_trx\G' &> "${backupFolder}/mysql/mysql_information_schema.innodb_trx" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SELECT * FROM performance_schema.data_locks' &> "${backupFolder}/mysql/mysql_performance_schema.data_locks" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SELECT TABLE_SCHEMA,table_comment FROM INFORMATION_SCHEMA.TABLES WHERE table_name = "_database_version"' &> "${backupFolder}/mysql/mysql_database_version" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SELECT table_schema "DB Name", ROUND(SUM(data_length + index_length) / 1024 / 1024, 1) "DB Size in MB" FROM information_schema.tables GROUP BY table_schema' &> "${backupFolder}/mysql/mysql_database_size" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'select * from events order by event_occurred_timestamp desc limit 2000' metalsoft &> "${backupFolder}/mysql/mysql_metalsoft_events_latest" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'select * from afc_queue_exception_history order by afc_exception_id desc limit 2000\G' metalsoft &> "${backupFolder}/mysql/mysql_metalsoft_afc_queue_exception_history" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'select * from afc_queue_debug_log where datacenter_name <> "master" order by afc_updated_timestamp desc limit 2000\G' metalsoft &> "${backupFolder}/mysql/mysql_metalsoft_afc_queue_debug_log" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'select * from afc_queue where datacenter_name <> "master" order by afc_updated_timestamp desc limit 2000\G' metalsoft &> "${backupFolder}/mysql/mysql_metalsoft_afc_queue" || true
	echo "[i] backing up mysql schema.."
	mysql_start="$SECONDS"
	timeout 180 $k exec deploy/mysql -- mysqldump --add-drop-table --no-data --single-transaction --skip-comments --triggers --routines --events metalsoft &> "${backupFolder}/mysql/mysql_database_schema.sql"
	mysqldump_exitcode="$?"
	test $mysqldump_exitcode -ne "0" && mysqldump_exitcode_error="${lightred}[mysqldump failed with exit code $mysqldump_exitcode]${nc}"
	mysql_end="$SECONDS"
	mysql_elapsed=$((mysql_end-mysql_start))
	echo "[+] ${mysql_elapsed} sec $mysqldump_exitcode_error"
	#backup all couchdb DBs:
	couchdbUrl="$($k get svc|grep couchdb|awk '{print $3":"$5}'|sed 's/ /:/g'|cut -d/ -f1)"
	test -n "${HTTP_PROXY:-}" && test -n "$couchdbUrl" && curl_no_proxy="env NO_PROXY=$(echo -n "$couchdbUrl"|cut -d: -f1)"
	test -n "${http_proxy:-}" && test -n "$couchdbUrl" && curl_no_proxy="env no_proxy=$(echo -n "$couchdbUrl"|cut -d: -f1)"

    if [ "$($curl_no_proxy curl -s -o /dev/null -w "%{http_code}" "${couchdbUrl}/_all_dbs")" != "200" ];then
      couchdb_admin_user="$($k get configmap common -o json|jq -r .data.couchdb_admin_user)"
      couchdb_admin_password="$($k get configmap common -o json|jq -r .data.couchdb_admin_password)"
      if [ -n "$couchdb_admin_user" ] && [ -n "$couchdb_admin_password" ];then
        couchdbUrl="${couchdb_admin_user}:${couchdb_admin_password}@${couchdbUrl}"
      fi
    fi

	mkdir -p "${backupFolder}/couchdb"
	if [[ "$couchdbUrl" =~ ^([^:]+):([^@]*)@(.+)$ ]]; then
		echo "[i] backing up couchdb: [${BASH_REMATCH[1]}:${BASH_REMATCH[2]:0:4}****@${BASH_REMATCH[3]}]"
	else
		echo "[i] backing up couchdb: [${couchdbUrl}]"
	fi
	if ! $curl_no_proxy curl -sS "http://${couchdbUrl}/_all_dbs" | jq -rce . &>/dev/null; then
		echo "CouchDB: $curl_no_proxy http://${couchdbUrl}/_all_dbs did not return valid JSON. Is proxy being used?" > "${backupFolder}/couchdb/couchdb_pull_failed"
	fi
	test -n "$couchdbUrl" && $curl_no_proxy curl -sk "http://${couchdbUrl}/_all_dbs" |jq -r ".[]"|while read -r z;do $curl_no_proxy curl -sk "http://${couchdbUrl}/$z/_all_docs?include_docs=true"|jq '{"docs": [.rows[].doc]}' | jq 'del(.docs[]._rev)'|jq -c .|gzip > "${backupFolder}/couchdb/couchdb_backup_${z}.gz";done || true

	echo "[i] backing up k8s pod runtime logs.."
	# --all-containers + --prefix so init-container output is captured too (kubectl
	# otherwise silently picks one container: "Defaulted container X out of: X, Y (init)").
	# --timestamps because plenty of containers log without a clock of their own, which
	# makes them impossible to line up against events/dmesg.
	# --previous for anything that has restarted: the current log only shows the newest
	# crash cycle, and the interesting failure is usually in the one before.
	$k get pod --no-headers|awk '{print $1" "$4+0}'|while read -r z restarts;do
		timeout 300 $k logs "$z" --timestamps --all-containers=true --prefix=true > "${backupFolder}/k8s/logs/pod_${z}.log" 2>&1
		if [ "${restarts:-0}" -gt 0 ] 2>/dev/null;then
			previous_logs "$envname" "$z" > "${backupFolder}/k8s/logs/pod_${z}_previous.log" 2>&1
		fi
		timeout 60 $k describe pod "$z" > "${backupFolder}/k8s/logs/describe_pod_${z}.txt" 2>&1
	done
	# bsi was dropped in MetalSoft 7.0.0; skip its checks entirely when it is not deployed.
	if [ -n "$bsi_present" ];then
	timeout 60 $k exec -it deploy/bsi -- bash -c 'supervisorctl status all' > "${backupFolder}/k8s/bsi/supervisorctl.txt" 2>&1
	bsipod="$($k get pod --no-headers|grep ^bsi|awk '{print $1}')"
	test -n "$bsipod" && while read -r bsi;do
	if [ -z "$sqlUpgradeLogs" ];then
		varlogs="$(timeout 120 $k exec -it "$bsi" -- bash -c 'find /var/log/ExportVHosts/bsi/ \( -path "/var/log/ExportVHosts/bsi/BSI/Endpoints/JSONRPC/*" -or -path "/var/log/ExportVHosts/bsi/PHP_*" -or -path "/var/log/ExportVHosts/bsi/switchDevices/*" \) -type f -iname "*.log"' 2>/dev/null|tr -d '\r')"
	else
		varlogs="$(timeout 120 $k exec -it "$bsi" -- bash -c 'find /var/log/ExportVHosts/bsi/ \( -path "/var/log/ExportVHosts/bsi/BSI/Endpoints/JSONRPC/*" -or -path "/var/log/ExportVHosts/bsi/PHP_*" -or -path "/var/log/ExportVHosts/bsi/SQLUpgrader/*/finished_logs/*" -or -path "/var/log/ExportVHosts/bsi/switchDevices/*"  \) -type f -iname "*.log" -or -iname "*.sql"' 2>/dev/null|tr -d '\r')"
	fi

	test -n "$varlogs" && while read -r z;do timeout 120 $k cp "$bsi:${z}" "${backupFolder}/k8s/bsi/varlog/${bsi}_${z//\//_}" &>/dev/null;done <<< "$varlogs"

	varlogsbsi="$(timeout 120 $k exec -it "$bsi" -- bash -c 'find /var/log/ -maxdepth 1 -type f -iname "bsi-*.log"' 2>/dev/null|tr -d '\r')"
	test -n "$varlogsbsi" && while read -r z;do timeout 120 $k cp "$bsi:${z}" "${backupFolder}/k8s/bsi/varlog/${bsi}_${z//\//_}" &>/dev/null;done <<< "$varlogsbsi"
done <<< "$bsipod"
	else
		echo "bsi deployment not present${ms_version:+ (MetalSoft ${ms_version})}: BSI checks skipped (bsi was removed in 7.0.0)" > "${backupFolder}/k8s/bsi/supervisorctl.txt"
	fi

$k get secret --no-headers|awk '{print $1}'|while read -r z;do echo -e '\n---';$k get secret "$z" -o yaml;done > "${backupFolder}/k8s/resources/secrets.yaml"
$k get cm --no-headers|awk '{print $1}'|while read -r z;do echo -e '\n---';$k get cm "$z" -o yaml;done > "${backupFolder}/k8s/resources/configmaps.yaml"

	# GC-specific SSL: TLS secret expiry
	{
		$k_orig get secrets -A -o json 2>/dev/null | jq -r '.items[] | select(.type=="kubernetes.io/tls") | .metadata.namespace + "/" + .metadata.name' 2>/dev/null | while read -r secret; do
			ns_name="${secret%%/*}"
			sec_name="${secret##*/}"
			echo ":::: $ns_name/$sec_name"
			$k_orig -n "$ns_name" get secret "$sec_name" -o jsonpath='{.data.tls\.crt}' 2>/dev/null | base64 -d 2>/dev/null | openssl x509 -noout -subject -enddate 2>/dev/null || echo "  (unable to decode)"
		done
	} > "${backupFolder}/ssl/k8s_tls_certs.txt" 2>&1 || true
	# GC-specific SSL: traefik cert logs.
	# There is no 'traefik' namespace: traefik is deployed per environment inside the
	# environment's own namespace (traefik-<ns>), so a cluster can hold several. Select
	# by chart label in the namespace being collected, and fall back to a name match.
	{
		traefik_deploys="$(timeout 30 $k get deploy -l app.kubernetes.io/name=traefik -o name 2>/dev/null)"
		test -z "$traefik_deploys" && traefik_deploys="$(timeout 30 $k get deploy -o name 2>/dev/null | grep traefik)"
		if [ -z "$traefik_deploys" ];then
			echo ":: no traefik deployment found in namespace ${envname}"
		else
			while read -r tdeploy;do
				test -n "$tdeploy" || continue
				echo ":::: ${envname}/${tdeploy} (cert lines only; full log in k8s/logs/pod_traefik-*.log)"
				# Piping kubectl's stderr straight into 'grep -i cert' turns a failed
				# fetch into "(no cert lines)" and hides it - that invisibility is what
				# kept the old '-n traefik' bug alive. Check PIPESTATUS instead of
				# buffering the log in a variable: traefik access logs can be huge.
				timeout 120 $k logs "$tdeploy" --timestamps 2>&1 | grep -i cert
				_trc=("${PIPESTATUS[@]}")
				if [ "${_trc[0]}" -ne 0 ];then
					echo "  (log fetch failed, kubectl/timeout exit ${_trc[0]})"
				elif [ "${_trc[1]}" -ne 0 ];then
					echo "  (log fetched, no cert-related lines)"
				fi
			done <<< "$traefik_deploys"
			unset _trc
		fi
	} > "${backupFolder}/ssl/traefik_certs.txt" 2>&1 || true

if [ "$extended" == '1' ];then
	echo "[i] backing up k8s resources.."
	# k8s backups
	$k api-resources --no-headers|awk '{print $1}'|while read -r z;do mkdir -p "${backupFolder}/k8s/api_resources/${z}";$k get "$z" --no-headers 2>/dev/null|awk '{print $1}'|while read -r a;do $k get "$z" "$a" -o yaml > "${backupFolder}/k8s/api_resources/${z}/${z}_${a}.yaml" 2>/dev/null;done;done || true

	echo "[i] backing up k8s container logs.."
	test -d /var/log/containers && mkdir -p "${backupFolder}/container_logs" && rsync -azL /var/log/containers/* "${backupFolder}/container_logs/" || true
fi

else # if gather=sc
	envname="$(grep -oP '\s+- URL=.*' /opt/metalsoft/agents/docker-compose.yaml|tail -1 |cut -d/ -f3)"

	# Extract hostname from docker-compose.yaml
	config_hostname=""
	if [ -f /opt/metalsoft/agents/docker-compose.yaml ]; then
		config_hostname="$(grep CONTROLLER_WS_URI= /opt/metalsoft/agents/docker-compose.yaml 2>/dev/null | cut -d/ -f3 | head -1)"
		if [ -z "$config_hostname" ]; then
			config_hostname="$(grep CONTROLLER_REMOTE_CONSOLE_URI= /opt/metalsoft/agents/docker-compose.yaml 2>/dev/null | cut -d/ -f3 | head -1)"
		fi
		if [ -z "$config_hostname" ]; then
			config_hostname="$(grep CONTROLLER_TCP_ADDRESS= /opt/metalsoft/agents/docker-compose.yaml 2>/dev/null | cut -d= -f2 | cut -d: -f1 | head -1)"
		fi
	fi

	# Use extracted hostname if available, otherwise fall back to envname
	if [ -n "$config_hostname" ]; then
		envnamelabel="${envname}-${config_hostname}-sc"
	else
		envnamelabel="-${envname}-sc"
	fi
	test -n "$config_hostname" && newbackupFolder="$(echo "${backupFolder}"|sed "s/__/-${config_hostname}/")"

	create_dirs
	get_system
	get_network
	get_disks
	get_ssl

	echo "[i] backing up docker stats.."
	test -f /opt/metalsoft/agents/docker-compose.yaml && rsync -a /opt/metalsoft/agents/ "${backupFolder}/docker/agents/" || true
	test -d /opt/metalsoft/nfs-storage && ls -lahR /opt/metalsoft/nfs-storage/ > "${backupFolder}/nfs/storage_ls.txt" || true
	systemctl status docker > "${backupFolder}/docker/status.txt" || true
	docker ps -a > "${backupFolder}/docker/ps.txt" || true
	docker ps|grep Restarting > "${backupFolder}/docker/restarting.txt" || true
	docker ps|grep Restarting|awk '{print $1}'|while read -r z;do docker logs "$z" --tail=1000 > "${backupFolder}/docker/restarting_${z}.txt";done || true
	docker images -a > "${backupFolder}/docker/images.txt" || true
	docker info > "${backupFolder}/docker/info.txt" 2>&1 || true
	docker system df > "${backupFolder}/docker/system_df.txt" 2>&1 || true
	docker network ls > "${backupFolder}/docker/networks.txt" 2>&1 || true
	docker volume ls > "${backupFolder}/docker/volumes.txt" 2>&1 || true
	test -f /etc/docker/daemon.json && cp /etc/docker/daemon.json "${backupFolder}/docker/daemon.json" || true
	journalctl -u docker -n 500 --no-pager > "${backupFolder}/docker/journalctl.txt" 2>&1 || true
	test -f /opt/metalsoft/agents/docker-compose.yaml && grep -oP '\s+\-\s+\K/opt/metalsoft/logs[^\:]*' /opt/metalsoft/agents/docker-compose.yaml|while read -r z;do echo "$z"|while read -r f;do find "$f" -type f \( -iname "*.log" -o -iname "*.log.1" \) -exec cp {} "${backupFolder}/docker/agents-logs/" \;;done;done
	test -f /opt/metalsoft/agents/docker-compose.yaml && docker ps -a --format '{{.Names}}.{{.ID}}'|while read -r z;do docker logs "${z%%.*}" > "${backupFolder}/docker/logs/${z}.log" 2>&1;done
	# SC-specific SSL: openssl to GC
	GCURL="$(grep -oP 'CONTROLLER_TCP_ADDRESS=\K[^\:]+' /opt/metalsoft/agents/docker-compose.yaml)"
	test -n "$GCURL" && which openssl &>/dev/null && openssl s_client -connect "$GCURL:443" -servername "$GCURL" -tlsextdebug -status -bugs < /dev/null > "${backupFolder}/ssl/openssl_443.txt" 2>&1
	test -n "$GCURL" && which openssl &>/dev/null && openssl s_client -connect "$GCURL:9091" -servername "$GCURL" -tlsextdebug -status -bugs < /dev/null > "${backupFolder}/ssl/openssl_9091.txt" 2>&1
	test -d /opt/metalsoft/ansible-jobs && tar czf "${backupFolder}/ansible-jobs.tar.gz" /opt/metalsoft/ansible-jobs &>/dev/null
fi

echo "[i] creating an archive.."
test -f "$bash_log" && mv "$bash_log" "${backupFolder}/bash_log.txt" &>/dev/null
resultFilename="${originalBackupFolder}/ms-diagnostics-${thedate}${envnamelabel}.tar.gz"
test -z "$newbackupFolder" && newbackupFolder="$backupFolder"
test "$backupFolder" != "$newbackupFolder" && mv "${backupFolder}" "${newbackupFolder}"
tar czf "${resultFilename}" -C "$(dirname "${newbackupFolder%*/}")" "${newbackupFolder##*/}" >/dev/null 2>&1 && \
	rm -rf "$newbackupFolder" && {
	filesize="$(du -h "${resultFilename}" | awk '{print $1}')"
	echo -e "[\e[1;32m✓\e[0m][$filesize][${SECONDS}s] Please provide the following file to MetalSoft Team:\n${lightgreen}${resultFilename}${nc}"
} || { echo -e "[\e[1;31m✗\e[0m] Error: Unable to create: ${resultFilename}"; exit 2; }

	curl_log="${originalBackupFolder}/diagnostics-collector-curl-${thedate}.log"
	if [ "$pushfile" == "1" ];then
		echo -n "[i] Trying to auto-push the diagnostics file to MetalSoft [HTTPS]...${orange} "
		http_code="$(push_diag "https://diagnostics-report.metalsoft.io/?a=121&f=992&pushparam=1&ns=${envname}" "$resultFilename" "$curl_log")"
		curl_exit=$?
		if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
			echo -e "${nc}Done (HTTP $http_code)\n"
			rm -f "$curl_log"
		else
			echo -e "${nc}\n[\e[1;31m✗\e[0m] Push failed (HTTP ${http_code:-000}, curl exit ${curl_exit}). Trace: $curl_log"
			exit 1
		fi
	else
		if timeout 3 bash -c "</dev/tcp/176.223.248.10/443" 2>/dev/null; then
			if [ -z "$doNotAutoSend" ]; then
				http_code="$(push_diag "https://diagnostics-report.metalsoft.io/?a=121&f=992&autopush=1&ns=${envname}" "$resultFilename" "$curl_log")"
				curl_exit=$?
				if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
					rm -f "$curl_log"
					sleep 3
					echo -e "[${lightgreen}✓${nc}] File auto-uploaded to MetalSoft. No further action needed."
					exit 0
				else
					echo -e "${orange}[!] Auto-upload failed (HTTP ${http_code:-000}, curl exit ${curl_exit}). Trace: ${curl_log}${nc}"
				fi
			fi
		fi
		if [ -z "$doNotAutoSend" ];then
			# stderr is redirected into bash_log via tee; route prompt to /dev/tty so the user can see it.
			read -r -p "${orange}[?] Send the file to MetalSoft Team via HTTPS POST? [y/N]${nc} " yn </dev/tty 2>/dev/tty
			case $yn in
				[Yy]* )
					echo -n "[i] Trying to push the diagnostics file to MetalSoft [HTTPS]...${orange} "
					http_code="$(push_diag "https://diagnostics-report.metalsoft.io/?a=121&f=992&promptedpush=1&ns=${envname}" "$resultFilename" "$curl_log")"
					curl_exit=$?
					if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
						echo -e "${nc}Done (HTTP $http_code)\n"
						rm -f "$curl_log"
					else
						echo -e "${nc}\n[\e[1;31m✗\e[0m] Push failed (HTTP ${http_code:-000}, curl exit ${curl_exit}). Trace: $curl_log"
					fi
					;;
				* ) exit;;
			esac
		fi
	fi
