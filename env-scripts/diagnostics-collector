#!/bin/bash
# vi: et st=2 sts=2 ts=2 sw=2 cindent bg=dark ft=bash

# How to install:
# wget -q https://raw.githubusercontent.com/metalsoft-io/scripts/main/env-scripts/diagnostics-collector -O /usr/local/bin/diagnostics-collector && chmod +x /usr/local/bin/diagnostics-collector

if tput sgr0 &>/dev/null; then
	nc=$(tput sgr0)
	bold=$(tput bold)
	orange=$(tput setaf 3)
	lightred=$(tput setaf 9)
	lightgreen=$(tput setaf 10)
	gray=$(tput setaf 8)
else
	nc='' bold='' orange='' lightred='' lightgreen='' gray=''
fi

# DEBUG:
which tee &>/dev/null || { echo "ERROR: Please install 'tee'. Exiting..."; exit 1; }
# Same check for mktemp, and for it actually working: an unwritable TMPDIR makes the
# next line yield an empty path, and the script then dies at the exec below with
# "Bad file descriptor" and "tee: ''" instead of saying what is wrong.
which mktemp &>/dev/null || { echo "ERROR: Please install 'mktemp'. Exiting..."; exit 1; }
# 129 calls in this script are wrapped in `timeout`, and several of them swallow their own
# stderr, so without it the collection does not fail loudly - it produces a bundle that is
# largely empty with nothing in it saying why. Same coreutils package as the two above.
which timeout &>/dev/null || { echo "ERROR: Please install 'timeout' (coreutils). Exiting..."; exit 1; }

# https://askubuntu.com/a/1001404/1113727
bash_log=$(mktemp)
test -n "$bash_log" && test -w "$bash_log" || { echo "ERROR: mktemp could not create a temporary file (is ${TMPDIR:-/tmp} writable and not full?). Exiting..."; exit 1; }
exec 19> "$bash_log"
exec   > >(tee -ia "$bash_log")
exec  2> >(tee -ia "$bash_log" >&19)
# For trace output
export BASH_XTRACEFD="19"
export PS4='+[${SECONDS}s] '
set -x

# Nothing in this script may ever read the terminal, except the explicit send-to-MetalSoft
# prompt at the very end (which reads </dev/tty). Without this, a kubeconfig that has no
# usable credentials makes kubectl print "Please enter Username:" and block FOREVER -
# verified: `kubectl get ns` against a credential-less kubeconfig hangs, while the same
# call with </dev/null fails instantly with "error: EOF". A diagnostics collector that
# waits on stdin on a broken cluster is worse than one that fails.
exec 0</dev/null

#test "$EUID" -ne 0 && { echo -e "[\e[1;31m✗\e[0m] Please run as root"; exit 1; }
thedate="$(date +"%F-%H%M")"
backupFolder=/var/backups/metalsoft
backupFolder="${backupFolder%/}"

function usage {
	echo -e "[i] $( basename "$0") gathers diagnostics for MetalSoft. Optional parameters:
	${bold}-n${nc} ${orange}(Required)${nc} ${gray}specify a namespace [ -n demo-metalsoft ]${nc}
	${bold}-k${nc} ${gray}specify an alternative kubectl [ -k /usr/local/bin/kubectl ]${nc}
	${bold}-b${nc} ${gray}specify a backup folder [ -b /var/backups/metalsoft ]${nc}
	${bold}-c${nc} ${gray}Flag [ Use for Global Controller ]${nc}
	${bold}-a${nc} ${gray}Flag [ Use for Site Controller or Agent ]${nc}
	${bold}-d${nc} ${gray}Flag [ skip disk latency check ]${nc}
	${bold}-p${nc} ${gray}Flag [ Push the diagnostics to MetalSoft via HTTPS ]${nc}
	${bold}-e${nc} ${gray}Flag [ Extended collection of k8s resources and DBs ]${nc}
	${bold}-j${nc} ${gray}parallel workers for per-pod/per-DB collection, default 4 [ -j 1 = fully serial ]${nc}"
	exit 0
}

# Push a diagnostics file to MetalSoft. Args: $1=url, $2=file, $3=trace_log_path.
# Echoes HTTP code on stdout; preserves curl's exit status.
# --speed-time/--speed-limit is a stall detector, NOT a max-time: aborts only on 120s of zero throughput.
function push_diag {
	curl --connect-timeout 10 \
		--speed-time 120 --speed-limit 1 \
		-v --trace-time \
		-sk -o /dev/null -w '%{http_code}' \
		"$1" -F diag=@"$2" 2>"$3"
}

#auto determine if we are on sc or gc:
gather=""
envname=""
k=""
test -f /opt/metalsoft/agents/docker-compose.yaml && type docker &>/dev/null && gather='sc' && envname="$(grep -oP '\s+- URL=.*' /opt/metalsoft/agents/docker-compose.yaml|tail -1 |cut -d/ -f3)"
type kubectl &>/dev/null && gather='gc' && k='kubectl '
test "$gather" == 'gc' && test -n "${ns:-}" && envname="$ns"
pushfile=
extended=
pushfileFromArg=""
sqlUpgradeLogs=""
doNotAutoSend=""
debugOn=""
SKIP_DISK_LATENCY_CHECK=""
curl_no_proxy=""
newbackupFolder=""
mysqldump_exitcode_error=""
cluster_unreachable=""
tls_secrets=""
ns_list=""
ns_rc=0
autopush_tried=""
mysql_total_mb=""
mysqldump_timeout=1800
_dlfile="ms-diag-latency.$$"
kubeconfig=""
ms_version=""
bsi_present=""
parallel=4
have_wait_n=""
# Captured before getopts shifts them away: collection_info.txt records how the
# collector was actually invoked, which decides what is legitimately absent (-e, -d).
invocationArgs="$*"

while getopts ":k:n:b:P:j:capezsxd" flag
do
	case "${flag}" in
		p) pushfile="1" ;;
		P) pushfileFromArg="${OPTARG}" ;;
		c) gather='gc' ;;
		a) gather='sc' ;;
		k) k="${OPTARG}" ;;
		n) envname="${OPTARG}" ;;
		b) backupFolder="${OPTARG}" ;;
		e) extended=1 ;;
		s) sqlUpgradeLogs=1 ;;
		z) doNotAutoSend=1 ;;
		x) debugOn=1 ;;
		d) SKIP_DISK_LATENCY_CHECK=1 ;;
		j) parallel="${OPTARG}" ;;
		:) echo "Error: -${OPTARG} requires an argument." && exit 1;;
		h | *) usage;;
	esac
done
shift "$(( OPTIND - 1 ))"

# -j must be a positive integer. A bad value silently serialising (or forking wildly)
# is worse than refusing, so fall back to 1 and say so.
if ! [[ "$parallel" =~ ^[0-9]+$ ]] || [ "$parallel" -lt 1 ];then
	echo "[!] -j '${parallel}' is not a positive integer; using -j 1 (serial)"
	parallel=1
fi

if [ -n "$pushfileFromArg" ];then
	test -f "$pushfileFromArg" || { echo -e "[\e[1;31m✗\e[0m] File '$pushfileFromArg' does not exist"; exit 1; }
	curl_log="/tmp/diagnostics-collector-curl-${thedate}.log"
	echo -n "[i] Trying to auto-push the diagnostics file '$pushfileFromArg' to MetalSoft [HTTPS] ... "
	http_code="$(push_diag "https://diagnostics-report.metalsoft.io/?a=121&f=992&pushfromarg=1&ns=${envname}" "$pushfileFromArg" "$curl_log")"
	curl_exit=$?
	if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
		echo -e " Done (HTTP $http_code)\n"
		rm -f "$curl_log"
		exit 0
	else
		echo -e "\n[\e[1;31m✗\e[0m] Push failed (HTTP ${http_code:-000}, curl exit ${curl_exit}). Trace: $curl_log"
		exit 1
	fi
fi

test -n "$gather" && echo "[i] Collecting diagnostics for: ${gather^}" || { echo -e "[\e[1;31m✗\e[0m] please specify parameter -c [for Global Controller] or -a [for Site Controller or Agent]"; exit 1; }
test -z "$envname" && test "$gather" == 'gc' && echo "${lightred}[e] Please use -n to specify namespace${nc}" && exit 10;
set -u
originalBackupFolder=${backupFolder}
backupFolder=${backupFolder}/ms-diagnostics-${thedate}_${envname}__${gather}

function finish {
	echo "[i] cleaning up.."
	# the disk-latency probe writes outside backupFolder (into /var/log), so clear that
	# too - matched by pid, so a concurrent run's probe is never touched
	rm -f "/var/log/${_dlfile}"
	rm -rf "${backupFolder}"
	test -n "$newbackupFolder" && test "$newbackupFolder" != "$backupFolder" && rm -rf "${newbackupFolder}"
	exit 3
}
trap finish INT TERM
test -n "$debugOn" && set -x
mkdir -p "${backupFolder}" || { echo -e "[\e[1;31m✗\e[0m] ${backupFolder} could not be created. Please check path, permissions and available disk space"; exit 2; }

env | grep -qi _proxy && echo -e "${lightred}PROXY setup:" && env|grep -i _proxy && echo -ne "${nc}"

# --- Shared functions ---

# Echo the path of a kubeconfig that actually talks to the cluster.
# kubectl finds its own config, but helm (and other tools) only honour
# $KUBECONFIG / ~/.kube/config, so on k3s/rke2/kubeadm nodes where
# root has no ~/.kube/config they fall back to localhost:8080 and fail.
# The probe is 'get ns', not 'get --raw /version': /version answers for any
# authenticated identity, so a node-level kubeconfig would pass the probe and then
# be rejected by RBAC on the real call. Returns 1 if no candidate works.
function detect_kubeconfig ()
{
	local c
	for c in "${KUBECONFIG:-}" \
		"${HOME:-/root}/.kube/config" \
		/etc/rancher/k3s/k3s.yaml \
		/etc/rancher/rke2/rke2.yaml \
		/etc/kubernetes/admin.conf \
		/var/lib/rancher/k3s/server/cred/admin.kubeconfig
	do
		test -n "$c" && test -r "$c" || continue
		if timeout 20 $k_orig --kubeconfig "$c" get ns &>/dev/null; then
			echo "$c"
			return 0
		fi
	done
	return 1
}

# Dump the pre-restart logs of every container in a pod, one container at a time.
# `kubectl logs --all-containers --previous` aborts with a single BadRequest as soon as
# ONE container has no previous state - which is the normal case here, because every
# MetalSoft pod has a completed '<svc>-depends-on-license' init container. The result is
# zero log lines for the container that actually crashed, which is the whole point of
# asking for --previous. Verified on the demo controller: 4 of 7 pods produced nothing
# but "Error from server (BadRequest): previous terminated container ... not found".
function previous_logs ()   # $1=namespace  $2=pod
{
	local c containers
	containers="$(timeout 30 $k_orig -n "$1" get pod "$2" \
		-o jsonpath='{range .spec.initContainers[*]}{.name}{" "}{end}{range .spec.containers[*]}{.name}{" "}{end}' 2>/dev/null)"
	if [ -z "$containers" ];then
		echo ":: could not list containers of ${1}/${2} (pod gone, or API unreachable)"
		return 0
	fi
	# 60s, not 120: this runs once per container of every unhealthy pod, so the worst
	# case multiplies. A --previous log is read off the node's disk - it arrives fast or
	# it is not coming, and stalling here delays the whole collection on a broken cluster.
	for c in $containers;do
		echo ":::: previous log, container ${c}"
		timeout 60 $k_orig -n "$1" logs "$2" -c "$c" --timestamps --previous 2>&1
	done
}

# Filter `kubectl get pod[s] --no-headers` on stdin down to the pods worth looking at.
# 'grep -vw Running' is not enough: a pod can sit in Running with 0/1 or 2/4 ready
# containers forever (crashlooping sidecar, failing probe) and never show up.
# The READY column is found by pattern (m/n) so this works with and without -A:
# it echoes "<namespace> <name>" for -A input and "<name>" without.
function unhealthy_pods ()
{
	awk '{
		ri=0
		for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+\/[0-9]+$/) { ri=i; break }
		if (!ri) next                                  # no READY column, e.g. an error line
		status=$(ri+1)
		if (status=="Completed" || status=="Succeeded") next   # finished Jobs are not broken
		split($ri,r,"/")
		if (status!="Running" || r[1]!=r[2]) {
			out=$1
			for (i=2;i<ri;i++) out=out" "$i
			print out
		}
	}'
}

# Echo `kubectl get events -A -o wide`, newest last, plus any extra args ($@).
# Sorting cannot be done with a bare '--sort-by || fallback': when kubectl cannot
# resolve the sort field it prints "No resources found" and exits 0 - verified on k3s
# v1.36.2, where `get pods -A --sort-by=.bogusField` reported no resources for 38
# running pods. An exit-code fallback never fires and the file ships up empty. Compare
# row counts instead and keep the sorted output only when it did not swallow anything.
function get_events_wide ()
{
	local unsorted sorted
	unsorted="$(timeout 60 $k_orig get events -A -o wide "$@" 2>&1)"
	sorted="$(timeout 60 $k_orig get events -A -o wide "$@" --sort-by=.lastTimestamp 2>&1)"
	if [ "$(printf '%s\n' "$sorted" | wc -l)" -ge "$(printf '%s\n' "$unsorted" | wc -l)" ];then
		printf '%s\n' "$sorted"
	else
		echo ":: (--sort-by=.lastTimestamp dropped rows on this kubectl; showing unsorted)"
		printf '%s\n' "$unsorted"
	fi
}

# host_cmd <outfile> <timeout> <binary> [args...]
# Run a host command into a file. If the binary is not installed the file SAYS so
# rather than being absent or empty - a missing file cannot be told apart from a failed
# collection, which is how the old empty traefik_certs.txt hid a bug for months.
# Never returns non-zero: a missing tool must never stop the collector.
function host_cmd ()
{
	local out="$1" t="$2" bin="$3"; shift 3
	if ! command -v "$bin" &>/dev/null; then
		printf ':: skipped: %s is not installed on this host\n' "$bin" > "$out"
		return 0
	fi
	if ! timeout "$t" "$bin" "$@" > "$out" 2>&1; then
		printf '\n:: (%s exited non-zero or timed out after %ss - output above may be partial)\n' "$bin" "$t" >> "$out"
	fi
	return 0
}

# k_cmd <outfile> <timeout> [kubectl args...] - same contract as host_cmd, for $k_orig.
function k_cmd ()
{
	local out="$1" t="$2"; shift 2
	if ! timeout "$t" $k_orig "$@" > "$out" 2>&1; then
		printf '\n:: (kubectl %s exited non-zero or timed out after %ss)\n' "$*" "$t" >> "$out"
	fi
	return 0
}

# The probe body, shared by the k8s and docker DNS probes so the two cannot drift.
# Pure POSIX sh, and single-quoted here so OUR shell expands nothing - it is interpreted
# by the target container's shell. Names to resolve arrive as positional arguments
# rather than interpolated into the text, so a name containing a quote or ';' cannot
# inject into the command that runs inside the container.
function dns_probe_script ()
{
	cat <<'MSDNSPROBE'
echo "--- id: $(id -u 2>/dev/null) ---"
echo "--- /etc/resolv.conf ---"; cat /etc/resolv.conf 2>&1
echo "--- /etc/nsswitch.conf ---"; cat /etc/nsswitch.conf 2>&1 || echo "(absent)"
echo "--- tools present ---"; for t in getent nslookup dig host node python3; do
  p=$(command -v $t 2>/dev/null) && echo "  $t: $p" || echo "  $t: -"
done
for n in "$@"; do
  echo "--- resolving $n ---"
  if command -v getent >/dev/null 2>&1; then
    getent hosts "$n" 2>&1 || echo "  getent: FAILED (rc=$?)"
  fi
  if command -v nslookup >/dev/null 2>&1; then
    nslookup "$n" 2>&1 | tail -6 || echo "  nslookup: FAILED"
  fi
  if command -v node >/dev/null 2>&1; then
    node -e "const d=require(\"dns\");const n=process.argv[1];
      d.lookup(n,{all:true},(e,r)=>console.log(\"  getaddrinfo:\",e?e.code:JSON.stringify(r)));
      d.resolve4(n,(e,r)=>console.log(\"  A  via c-ares:\",e?e.code:String(r)));
      d.resolve6(n,(e,r)=>console.log(\"  AAAA via c-ares:\",e?e.code:String(r)));" "$n" 2>&1 || echo "  node: FAILED"
  fi
done
MSDNSPROBE
}

# In-cluster DNS probe, by exec-ing into pods that are ALREADY running. Deliberately
# creates nothing: a fresh probe pod gets a fresh sandbox, and a fresh sandbox is the
# one thing that resolved fine on the customer cluster where every existing pod failed -
# so a probe pod would have reported all-green while the environment was broken.
# Every step tolerates an image with no shell and no DNS tooling.
function dns_probe ()
{
	local out="${backupFolder}/k8s/dns/probe.txt" pods p names script
	# Up to 3 Running pods in our namespace, oldest sandbox first: those have been alive
	# longest and are the most likely to have drifted (a pod's netns state survives every
	# container restart). Default `get pod` order is alphabetical, not by age, so the sort
	# is explicit - and it falls back to unsorted because a --sort-by kubectl cannot
	# resolve returns "No resources found" with exit 0 rather than an error.
	pods="$(timeout 60 $k get pod --no-headers --sort-by=.metadata.creationTimestamp 2>/dev/null \
		| awk '$3=="Running"{print $1}' | head -3)"
	test -n "$pods" || pods="$(timeout 60 $k get pod --no-headers 2>/dev/null | awk '$3=="Running"{print $1}' | head -3)"
	names="kubernetes.default.svc.cluster.local mysql-service mysql-service.${envname}.svc.cluster.local"
	script="$(dns_probe_script)"
	mkdir -p "${backupFolder}/k8s/dns"
	{
		echo ":: In-cluster DNS as seen from pods that are already running (nothing was created)."
		echo ":: getaddrinfo failing while c-ares succeeds = resolver/NSS issue inside the image."
		echo ":: AAAA erroring while A succeeds = glibc returns EAI_AGAIN even though A worked."
		echo ":: Everything timing out = the pod's egress is broken, DNS is only the symptom."
		echo ":: CAVEAT: the c-ares lines do NOT apply the pod's search/ndots list, so a SHORT"
		echo ":: name (no dots) returning ENOTFOUND there while getaddrinfo succeeds is normal."
		echo ":: Judge c-ares only on the fully-qualified names. ENODATA on AAAA is also normal"
		echo ":: for an IPv4-only Service; SERVFAIL or a timeout on AAAA is NOT."
		echo
		if [ -z "$pods" ];then
			echo ":: no Running pods found in namespace ${envname}; nothing to probe."
		fi
		for p in $pods;do
			echo "================================================================"
			echo ":::: pod ${envname}/${p}"
			# $names must word-split into separate argv entries, one per name
			# shellcheck disable=SC2086
			timeout 90 $k exec "$p" -- sh -c "$script" _ $names 2>&1 \
				|| echo ":: (exec failed - image may have no shell, or the pod is not execable)"
		done
	} > "$out" 2>&1 || true
	return 0
}

# version_ge 7.4.3 7.0.0 -> true when $1 >= $2 (dotted versions, sort -V)
function version_ge ()
{
	test -n "$1" && test -n "$2" || return 1
	test "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" == "$2"
}

# throttle <max> - block until fewer than <max> background jobs of THIS shell remain.
# Used to fan out loops whose iterations each write their OWN file. Loops that append
# to a shared file (stats.txt, not_running.txt, metallb_logs.txt, pod_netns.txt) are
# deliberately NOT parallelised: concurrent appends interleave and corrupt them.
# With max=1 this blocks until the previous job finished, i.e. exactly serial - so -j 1
# reproduces the old behaviour without a second code path.
#
# NEVER use a bare `wait` to join these jobs. This script redirects stdout/stderr into
# `tee` process substitutions at startup; those are children that never exit while the
# script runs, and a bare `wait` waits for them too - verified hanging forever on bash
# 5.2.21 (it happens to return on 5.3.9, which is why a single test host can hide it).
# `jobs -rp` does NOT list process substitutions, so `throttle 1` is the safe join.
#
# Portability: `wait -n` needs bash 4.3 (2014). RHEL 7 ships bash 4.2, so on those
# hosts we poll the job table instead - same semantics, just a 0.2s granularity. The
# version is checked once here rather than letting `wait -n` fail on every call.
# (The script as a whole already requires bash 4.0+ for ${gather^}.)
if [ "${BASH_VERSINFO[0]}" -gt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 3 ]; };then
	have_wait_n=1
else
	have_wait_n=""
fi
function throttle ()
{
	local max="$1"
	while [ "$(jobs -rp | grep -c .)" -ge "$max" ];do
		if [ -n "$have_wait_n" ];then
			wait -n 2>/dev/null || true
		else
			sleep 0.2
		fi
	done
}

function create_dirs ()
{
	mkdir -p "${backupFolder}/system"
	mkdir -p "${backupFolder}/disk"
	mkdir -p "${backupFolder}/network"
	mkdir -p "${backupFolder}/ssl"
	if [ "$gather" == 'gc' ];then
		mkdir -p "${backupFolder}/k8s/cluster"
		mkdir -p "${backupFolder}/k8s/resources"
		mkdir -p "${backupFolder}/k8s/ingress"
		mkdir -p "${backupFolder}/k8s/logs"
		mkdir -p "${backupFolder}/k8s/dns"
		mkdir -p "${backupFolder}/k8s/bsi/varlog"
		# api_resources is populated only under -e. Creating it unconditionally shipped an
		# empty directory on every normal run, which reads as a failed collection rather
		# than one that was never asked for - the same ambiguity host_cmd exists to avoid.
		test "$extended" == '1' && mkdir -p "${backupFolder}/k8s/api_resources"
		mkdir -p "${backupFolder}/mysql"
		mkdir -p "${backupFolder}/couchdb"
	fi
	if [ "$gather" == 'sc' ];then
		mkdir -p "${backupFolder}/docker/agents"
		mkdir -p "${backupFolder}/docker/agents-logs"
		mkdir -p "${backupFolder}/docker/logs"
		mkdir -p "${backupFolder}/nfs"
	fi
}

function get_system ()
{
	cat /etc/environment 2>/dev/null > "${backupFolder}/system/environment.txt"
	env > "${backupFolder}/system/env.txt"
	test -f /etc/metalsoft && cp /etc/metalsoft "${backupFolder}/system/etc_metalsoft" 2>/dev/null
	stat "$(realpath "$0")" > "${backupFolder}/system/stat.txt" 2>&1 || true
	uptime > "${backupFolder}/system/uptime.txt" 2>&1 || true
	cat /etc/os-release > "${backupFolder}/system/os-release" 2>&1 || true
	uname -a > "${backupFolder}/system/uname.txt" 2>&1 || true
	free -h > "${backupFolder}/system/memory.txt" 2>&1 || true
	# Whole ring buffer, not tail -500: kernel messages that matter (martian source,
	# conntrack table full, OOM, EXT4 errors, link flaps) are usually older than the
	# last 500 lines. Timestamped where util-linux supports it, plain otherwise.
	dmesg --time-format iso > "${backupFolder}/system/dmesg.txt" 2>/dev/null \
		|| dmesg -T > "${backupFolder}/system/dmesg.txt" 2>/dev/null \
		|| dmesg > "${backupFolder}/system/dmesg.txt" 2>&1 || true
	# The ring buffer wraps; journald keeps kernel history across that (and reboots).
	# On a containerd host every container start emits apparmor= audit records; they were
	# ~100% of 90k lines on the demo controller and say nothing about the cluster. Drop
	# AppArmor records specifically, NOT all 'audit: type=1400': on RHEL/SELinux hosts
	# that is where 'avc: denied' appears, which is worth keeping. tail bounds what a
	# pathologically noisy host can add to the archive.
	command -v journalctl &>/dev/null && journalctl -k --no-pager --since "-14 days" -n 100000 2>&1 \
		| grep -v -e 'apparmor="' -e 'kauditd_printk_skb' | tail -n 20000 \
		> "${backupFolder}/system/journalctl_kernel.txt" || true
	# Runtime journals. The GC side collected none at all, while the SC side already
	# collects docker's - so a k3s/containerd crash left no trace. Only units that
	# actually exist on this host are touched; k3s embeds containerd and kubelet, so
	# most of these are legitimately inactive.
	if command -v journalctl &>/dev/null && command -v systemctl &>/dev/null;then
		for _u in k3s k3s-agent rke2-server rke2-agent containerd crio kubelet docker;do
			systemctl list-unit-files "${_u}.service" &>/dev/null || continue
			test -n "$(systemctl show -p LoadState --value "${_u}.service" 2>/dev/null | grep -x loaded)" || continue
			# Filter before the tail, not after: on our own demo controller 89% of 20000
			# k3s lines were two repeating shapes - kube-router's "Ignoring IPv6 ... IP
			# blocks" warning and kine's COMPACT bookkeeping - which do not just waste
			# space, they EVICT real history out of the line budget. Matched on message
			# text, not source file, so a genuine policy.go error still survives.
			timeout 180 journalctl -u "${_u}" --no-pager -n 100000 --since "-14 days" 2>&1 \
				| grep -v -e 'Ignoring IPv6 dest IP blocks' -e 'Ignoring IPv6 source IP blocks' \
					-e 'msg="COMPACT ' -e 'msg="COMPACT$' \
				| tail -n 20000 > "${backupFolder}/system/journalctl_${_u}.txt" \
				|| echo ":: (journalctl -u ${_u} failed or timed out)" >> "${backupFolder}/system/journalctl_${_u}.txt"
		done
		unset _u
	fi
	command -v timedatectl &>/dev/null && timedatectl > "${backupFolder}/system/timedatectl.txt" 2>&1 || true
	cat /etc/hosts > "${backupFolder}/system/hosts" 2>&1 || true
	cat /etc/resolv.conf > "${backupFolder}/system/resolv.conf" 2>&1 || true
	# SELinux. A denial is invisible everywhere else in this archive: the container simply
	# fails to start and the pod event blames the runtime. Mode alone is not enough - the
	# k3s-selinux package is what supplies the container policy, and a host that is
	# Enforcing without it mislabels everything under the data-dir. Not present on
	# Debian/Ubuntu, where the file says so rather than being empty.
	{
		if command -v sestatus &>/dev/null || command -v getenforce &>/dev/null;then
			echo ":: sestatus"
			timeout 15 sestatus 2>&1 || true
			echo; echo ":: getenforce"
			timeout 15 getenforce 2>&1 || true
			echo; echo ":: policy packages"
			if command -v rpm &>/dev/null;then
				# rpm -q waits on the rpmdb lock behind a running dnf/yum transaction, which is
				# a normal state on a host someone is mid-patching when support asks for a bundle.
				timeout 30 rpm -q k3s-selinux container-selinux 2>&1 || true
			else
				echo ":: skipped: rpm is not installed on this host"
			fi
			echo; echo ":: labels on the runtime and storage paths"
			timeout 15 ls -Zd /var/lib/rancher/k3s /var/lib/rancher/rke2 /var/lib/kubelet \
				/var/lib/containerd /var/lib/docker /var/lib/containers /var/lib/etcd \
				/etc/kubernetes /var/log 2>&1 || true
			echo; echo ":: recent AVC denials (ausearch -m AVC,USER_AVC -ts today, last 200)"
			if command -v ausearch &>/dev/null;then
				# Scans every rotated audit.log, so it grows with the audit configuration, not
				# with the window asked for: -ts today does not stop it reading the old files.
				# No `|| true` on the pipeline: it would run `true`, whose own PIPESTATUS then
				# overwrites the 124 the check below reads. The enclosing group already tolerates
				# a failure here.
				timeout 60 ausearch -m AVC,USER_AVC -ts today 2>&1 | tail -n 200
				# PIPESTATUS, as in disk/usage_breakdown.txt: tail prints whatever arrived before
				# the kill, so a timed-out scan otherwise reads as a host with few denials.
				test "${PIPESTATUS[0]}" -eq 124 && echo ":: (ausearch timed out after 60s - the list above is partial)"
			else
				echo ":: skipped: ausearch is not installed on this host"
			fi
		else
			echo ":: skipped: SELinux tooling (sestatus/getenforce) is not installed on this host"
		fi
	} > "${backupFolder}/system/selinux.txt" 2>&1 || true
}

# k3s/RKE2 runtime configuration. Each of these is read at startup and nothing else in
# the archive reproduces it:
#   - agent/etc/resolv.conf is GENERATED by k3s and is what CoreDNS forwards to. When the
#     host's /etc/resolv.conf lists only a loopback resolver, k3s substitutes a public one
#     instead; on an air-gapped site that resolves nothing, and the symptom is cluster-wide
#     DNS timeouts sitting behind a CoreDNS pod that is 1/1 Running with zero restarts.
#   - registries.yaml is the mirror/rewrite config, i.e. the reason one workload pulls from
#     an internal registry while its neighbour still reaches for a public one.
#   - containerd config.toml carries the same for the runtime itself.
# Tolerates a missing cluster: the node-args lookup is the only part that needs kubectl.
function get_runtime_config ()
{
	local out="${backupFolder}/system/runtime_config.txt" f
	{
		# /etc/cni/net.d is empty on k3s - verified on k3s v1.36: the conflist, flannel's
		# net-conf.json (pod CIDR and backend) and the kubelet drop-ins that carry the
		# eviction thresholds all live under the agent dir instead, so both are listed.
		for f in /etc/rancher/k3s/config.yaml \
			/etc/rancher/k3s/config.yaml.d/* \
			/etc/rancher/k3s/registries.yaml \
			/etc/rancher/rke2/config.yaml \
			/etc/rancher/rke2/config.yaml.d/* \
			/etc/rancher/rke2/registries.yaml \
			/var/lib/rancher/k3s/agent/etc/resolv.conf \
			/var/lib/rancher/k3s/agent/etc/containerd/config.toml \
			/var/lib/rancher/rke2/agent/etc/resolv.conf \
			/var/lib/rancher/rke2/agent/etc/containerd/config.toml \
			/var/lib/kubelet/config.yaml \
			/var/lib/kubelet/kubeadm-flags.env \
			/etc/kubernetes/manifests/*.yaml \
			/etc/containerd/config.toml \
			/etc/containerd/certs.d/*/hosts.toml \
			/var/lib/rancher/k3s/agent/etc/cni/net.d/* \
			/var/lib/rancher/k3s/agent/etc/flannel/* \
			/var/lib/rancher/k3s/agent/etc/kubelet.conf.d/* \
			/var/lib/rancher/rke2/agent/etc/cni/net.d/* \
			/etc/crio/crio.conf \
			/etc/crio/crio.conf.d/* \
			/etc/docker/daemon.json \
			/etc/cni/net.d/*;do
			echo -e "\n:::: ${f}\n"
			if [ -f "$f" ];then
				cat "$f" 2>&1
			elif [ -d "$f" ];then
				# Reachable: net.d/ and crio.conf.d/ can hold subdirectories, and calling a
				# path that exists "not present" sends the reader after the wrong thing.
				echo ":: is a directory, not a file - not shown"
			elif [[ "$f" == *'*'* ]];then
				# Unmatched glob: bash leaves the pattern literal, so say that rather than
				# claiming a specific file is missing.
				echo ":: no files match this pattern on this host"
			else
				echo ":: not present on this host"
			fi
		done
		if command -v systemctl &>/dev/null;then
			for f in k3s k3s-agent rke2-server rke2-agent kubelet containerd crio docker;do
				# Both bounded. Measured against a bus socket that accepts and never answers:
				# `systemctl cat` was STILL blocked at 60s (rc=124 under timeout) - it does
				# NOT inherit a dbus timeout - while list-unit-files self-bounds at ~29s.
				# A wedged systemd is a normal state on a host someone collects a bundle
				# from, and 8 units x an unbounded call is the shape that produces no archive
				# at all.
				timeout 30 systemctl list-unit-files "${f}.service" &>/dev/null
				_slrc=$?
				# One message, then stop: systemd that did not answer for the first unit will
				# not answer for the other seven, and saying so once beats 8x30s of silence
				# followed by a file that looks like a host with no runtime units.
				test "$_slrc" -eq 124 && { echo -e "\n:: systemd did not answer within 30s - no unit definitions were collected"; break; }
				test "$_slrc" -eq 0 || continue
				echo -e "\n:::: systemctl cat ${f}\n"
				timeout 30 systemctl cat "${f}" 2>&1 || echo ":: (systemctl cat exited non-zero or timed out after 30s)"
			done
			unset _slrc
		fi
		# k3s/RKE2 record the server flags on the node object; kubeadm has no equivalent
		# annotation, and the static pod manifests above carry the same information there.
		echo -e "\n:::: node annotations: k3s.io/node-args, kubeadm.alpha.kubernetes.io/cri-socket\n"
		# Gated, because this function now also runs on a Site Controller, where there is no
		# kubectl at all: an empty $k_orig would expand to `timeout 60 get nodes ...` and
		# write "timeout: failed to run command 'get'" into the archive, which reads as a
		# broken collector rather than a host that has no cluster. Also skipped when the
		# cluster is known unreachable - the 60s would be spent to reprint what
		# CLUSTER_UNREACHABLE.txt already says.
		if [ -z "${k_orig:-}" ];then
			echo ":: skipped: no kubectl on this host, so there is no node object to read"
		elif [ -n "${cluster_unreachable:-}" ];then
			echo ":: skipped: the cluster is unreachable (see CLUSTER_UNREACHABLE.txt)"
		else
			timeout 60 $k_orig get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.annotations.k3s\.io/node-args}{"\t"}{.metadata.annotations.kubeadm\.alpha\.kubernetes\.io/cri-socket}{"\n"}{end}' 2>&1 || true
		fi
	} > "$out" 2>&1 || true
}

# Registry/egress reachability. "The site is air-gapped" is otherwise an inference drawn
# from a single i/o timeout in one pod event. This measures it, and splits DNS resolution
# from the TCP connect so a name that resolves but cannot be reached (firewall) is
# distinguishable from one that never resolved (DNS). Targets come from the images this
# cluster's own pods reference, so the list stays correct as the deployment changes.
function get_egress ()
{
	local out="${backupFolder}/network/egress_reachability.txt" hosts h t=2 tmpd i=0 maxhosts=20 found=0 ctrl
	# Two steps, not ${config_hostname%%:*} directly: that form aborts the whole run under
	# set -u if the variable is ever unset, and a collector must not die over a target list.
	ctrl="${config_hostname:-}"
	ctrl="${ctrl%%:*}"
	hosts="$(
		{
			# Defaults FIRST, and deduped with awk rather than sort -u, so that the order is
			# priority order: a cluster referencing dozens of registries can never push the
			# MetalSoft endpoints past the cap below. (An image with no registry prefix
			# implies Docker Hub, which is why it is in this list.)
			printf 'registry.metalsoft.dev\nrepo.metalsoft.io\ndiagnostics-report.metalsoft.io\nregistry-1.docker.io\nquay.io\n'
			# 15s, not the usual 60: these calls only ENRICH the target list, the defaults
			# above stand on their own, and a black-holed apiserver (or a wedged dockerd) is
			# exactly when someone runs diagnostics - it must not stall the whole check.
			if [ "$gather" == 'gc' ];then
				timeout 15 $k_orig get pods -A -o jsonpath='{range .items[*]}{range .spec.containers[*]}{.image}{"\n"}{end}{range .spec.initContainers[*]}{.image}{"\n"}{end}{end}' 2>/dev/null \
					| awk -F/ 'NF>1 && $1 ~ /[.:]/ {print $1}' | cut -d: -f1
			else
				# SC: the registries this host actually pulls from, plus the controller it
				# talks to - which is the one endpoint an agent cannot work without, and the
				# thing the existing openssl s_client check cannot distinguish a DNS failure
				# from a connect failure on.
				command -v docker &>/dev/null && timeout 15 docker images --format '{{.Repository}}' 2>/dev/null \
					| awk -F/ 'NF>1 && $1 ~ /[.:]/ {print $1}' | cut -d: -f1
				# $ctrl is config_hostname with any port stripped: cut -d/ -f3 on a
				# CONTROLLER_*_URI yields host:port when the URI carries one, and the
				# hostname allowlist below would reject that outright, silently dropping
				# the single endpoint an agent cannot work without.
				printf '%s\n' "$ctrl"
			fi
		} | grep -v '^$' | awk '!seen[$0]++'
	)"
	# Host count is the one input here that is not otherwise bounded, and it multiplies
	# runtime: ceil(N/8) waves x 2 probes x ${t}s. Cap it, and say so rather than
	# truncating silently.
	found="$(printf '%s\n' "$hosts" | grep -c . || true)"
	test "$found" -gt "$maxhosts" && hosts="$(printf '%s\n' "$hosts" | head -n "$maxhosts")"
	# Probes run concurrently, so the whole check costs about one host's worth of timeout
	# (two probes x ${t}s) no matter how many registries the cluster references - serial,
	# ten hosts on a firewalled site would add minutes to the run. Each job writes its own
	# file so the output cannot interleave; they are concatenated in host order.
	# Write the file even here: an absent file cannot be told apart from a collection that
	# was never attempted, which is the ambiguity host_cmd exists to prevent.
	if ! tmpd="$(mktemp -d)";then
		echo ":: skipped: could not create a temporary directory (mktemp -d failed)" > "$out" 2>&1
		return 0
	fi
	while read -r h;do
		test -n "$h" || continue
		i=$((i+1))
		# These hostnames come from pod .spec.*.image, which the API stores as a free-form
		# string - untrusted input, and this script runs as root. Reject anything that is
		# not a bare DNS name BEFORE it reaches any command.
		case "$h" in
			-*|*[!A-Za-z0-9.-]*)
				printf ':::: %s\n  skipped: not a plain hostname (rejected before use)\n' "$h" > "${tmpd}/$(printf '%03d' $i)"
				continue;;
		esac
		if [ "${#h}" -gt 253 ];then
			printf ':::: %s\n  skipped: longer than the 253-character DNS limit\n' "$h" > "${tmpd}/$(printf '%03d' $i)"
			continue
		fi
		(
			printf ':::: %s\n' "$h"
			if command -v getent &>/dev/null;then
				# Report the failure explicitly: an empty "DNS:" line cannot be told apart
				# from a lookup that succeeded and returned nothing.
				_dns="$(timeout "$t" getent hosts "$h" 2>&1 | head -3 | tr '\n' ' ')"
				echo "  DNS: ${_dns:-FAILED to resolve}"
			else
				echo "  DNS: skipped: getent is not installed on this host"
			fi
			# Passed as an argument, never interpolated into the -c string: interpolating
			# "</dev/tcp/${h}/443" would execute any shell metacharacter in an image name.
			if timeout "$t" bash -c 'exec 3<>"/dev/tcp/$1/443"' _ "$h" 2>/dev/null;then
				echo "  TCP/443 direct: open"
			else
				echo "  TCP/443 direct: BLOCKED or timed out after ${t}s"
			fi
			# curl honours http_proxy/https_proxy, so it answers the question the TCP probe
			# cannot: whether this host reaches the registry THROUGH the proxy. A site with
			# proxy-only egress shows direct BLOCKED here and curl succeeding.
			if command -v curl &>/dev/null;then
				# Keep curl's own message, not just the write-out: a TLS-interception CA the
				# runtime does not trust and a firewall drop both write http_code 000, and
				# only the error text ("SSL certificate problem: ...") separates them. The
				# exit code is the compact form of the same answer - 6 DNS, 7 refused,
				# 28 timeout, 60 certificate. Collapsed to one bounded line.
				_cout="$(curl -sS -o /dev/null --max-time "$t" -w 'http %{http_code} in %{time_total}s' "https://${h}/v2/" 2>&1)"
				_crc=$?
				echo "  HTTPS via curl: exit=${_crc} $(printf '%s' "$_cout" | tr '\n' ' ' | tr -s ' ' | cut -c1-180)"
			fi
		) > "${tmpd}/$(printf '%03d' $i)" 2>&1 &
		# Deliberately NOT -j: that caps kubectl log fetches, which are heavy, and at the
		# default of 4 a typical six-registry list would take two waves and blow the time
		# budget for this check. But not unbounded either - each host costs two DNS
		# lookups (getent, then curl's own), and on a site where the resolver is the fault
		# being investigated a wide fan-out can time out lookups that would have answered
		# serially, i.e. the probe corrupts its own measurement. 8 covers the usual list in
		# one wave and halves the queries in flight.
		throttle 8
	done <<< "$hosts"
	throttle 1
	{
		echo ":: Registry reachability from this node: DNS, a direct TCP/443 connect, and a"
		echo ":: curl over HTTPS (which follows any proxy below). Each probe is capped at ${t}s"
		echo ":: and up to 8 hosts are probed at a time, so a typical list costs ~$((2*t))s,"
		echo ":: plus up to 15s for the kubectl call that builds the target list."
		if [ "$found" -gt "$maxhosts" ];then
			echo ":: NOTE: ${found} distinct registries were found; only the first ${maxhosts} were"
			echo ":: probed. The MetalSoft endpoints are ordered first and are always included."
		fi
		echo ":: Targets are the registries this cluster's pods reference, plus the MetalSoft"
		echo ":: endpoints."
		echo
		echo ":::: proxy environment"
		env | grep -iE '_proxy=' || echo ":: no *_proxy variables set for this shell"
		echo
		cat "${tmpd}"/* 2>/dev/null
	} > "$out" 2>&1 || true
	rm -rf "$tmpd"
}

# DNS as the CONTAINERS see it - the SC counterpart to dns_probe. Not redundant with the
# host's /etc/resolv.conf: on a user-defined network Docker puts its own embedded resolver
# at 127.0.0.11 inside the container and forwards from there, so the host can resolve
# perfectly while every agent container fails. Same discipline as dns_probe: exec only
# into containers that are ALREADY running, create nothing, and share the probe body.
function docker_dns_probe ()
{
	local out="${backupFolder}/docker/dns_probe.txt" ctrs c names script ctrl
	if ! command -v docker &>/dev/null;then
		echo ":: skipped: docker is not installed on this host" > "$out" 2>&1
		return 0
	fi
	# Oldest sandbox first, for the same reason dns_probe sorts pods by creationTimestamp:
	# the longest-lived containers are the ones most likely to have drifted. `docker ps`
	# defaults to NEWEST first, which would pick exactly the wrong three.
	ctrs="$(timeout 60 docker ps --format '{{.CreatedAt}}	{{.Names}}' 2>/dev/null | sort | head -3 | cut -f2)"
	# The controller is the one name an agent MUST resolve; the registries are what it
	# pulls from. config_hostname is derived from the compose file earlier in the sc block,
	# and %%:* strips a port: the CONTROLLER_WS_URI / REMOTE_CONSOLE_URI branches take
	# `cut -d/ -f3`, which yields host:port when the URI carries one, and
	# `getent hosts gc.example.com:9001` fails - reporting the controller as unresolvable
	# when it resolves perfectly well.
	ctrl="${config_hostname:-}"
	names="${ctrl%%:*} registry.metalsoft.dev repo.metalsoft.io"
	script="$(dns_probe_script)"
	{
		echo ":: DNS as seen from containers that are already running (nothing was created)."
		echo ":: Docker attaches an embedded resolver at 127.0.0.11 on user-defined networks,"
		echo ":: so a container's view differs from the host's - compare against"
		echo ":: system/resolv.conf before concluding the host DNS is fine."
		echo ":: getaddrinfo failing while c-ares succeeds = resolver/NSS issue inside the image."
		echo ":: Everything timing out = the container's egress is broken, DNS is the symptom."
		echo ":: CAVEAT: the c-ares lines do NOT apply any search list, so a SHORT name"
		echo ":: returning ENOTFOUND there while getaddrinfo succeeds is normal."
		echo
		if [ -z "$ctrs" ];then
			echo ":: no running containers; nothing to probe."
		fi
		for c in $ctrs;do
			echo "================================================================"
			echo ":::: container ${c}"
			# $names must word-split into separate argv entries, one per name
			# shellcheck disable=SC2086
			timeout 90 docker exec "$c" sh -c "$script" _ $names 2>&1 \
				|| echo ":: (exec failed - image may have no shell, or the container is not execable)"
		done
	} > "$out" 2>&1 || true
	return 0
}

# Docker state, the SC counterpart to get_k8s/get_k8s_cluster. `docker ps -a` is one line
# per container; everything that explains a failure - restart policy, health, OOMKilled,
# exit code, mounts, DNS config, a network's subnet - lives in inspect output.
function get_docker ()
{
	local d="${backupFolder}/docker" ctrs nets dfcap f
	if ! command -v docker &>/dev/null;then
		# Every file this function is expected to produce, not just the first one: an
		# absent file cannot be told apart from a collection that was never attempted.
		for f in version.txt stats.txt system_df_v.txt events.txt network_inspect.json \
			inspect.json compose_config.yaml;do
			echo ":: skipped: docker is not installed on this host" > "${d}/${f}" 2>/dev/null || true
		done
		return 0
	fi
	host_cmd "${d}/version.txt"     30 docker version
	host_cmd "${d}/stats.txt"       60 docker stats --no-stream
	host_cmd "${d}/system_df_v.txt" 60 docker system df -v
	# Measured 6007 lines / 536KB on a host with many anonymous volumes, ~95% of it the
	# Local Volumes tail. Images and Containers are printed first, so a head-cap keeps
	# what matters - and this says so rather than truncating silently.
	# wc -l, not grep -c .: head counts ALL lines, so counting only non-empty ones would
	# cap at a different threshold than the one being applied. Staged through a file in
	# TMPDIR rather than beside the target, so a failed rewrite cannot leave a stray
	# .part inside the archive.
	if [ "$(wc -l < "${d}/system_df_v.txt" 2>/dev/null || echo 0)" -gt 2000 ];then
		dfcap="$(mktemp 2>/dev/null)" || dfcap=""
		if [ -n "$dfcap" ];then
			{
				head -n 2000 "${d}/system_df_v.txt"
				echo
				echo ":: (truncated to 2000 lines - the per-volume tail was dropped."
				echo ":: Summary totals are in docker/system_df.txt)"
			} > "$dfcap" && mv -f "$dfcap" "${d}/system_df_v.txt"
			rm -f "$dfcap"
		fi
	fi
	# Restart, OOM and health-transition history: the SC counterpart to kubectl events,
	# and it reaches further back than the k8s API's 1h event TTL. --until is REQUIRED -
	# without it `docker events` streams and never returns (verified: rc=124 under
	# timeout). "now" is rejected by the parser ("failed to parse value as time or
	# duration"); 0s is accepted. The exec_* lines are healthcheck bookkeeping and on a
	# host with 5s healthchecks they are almost all of the output, evicting real events.
	{
		echo ":: docker events --since 24h --until 0s"
		_evt="$(mktemp 2>/dev/null)" || _evt=""
		if [ -z "$_evt" ];then
			echo ":: skipped: could not create a temporary file"
		else
			# Via a file, not a variable: a busy daemon can emit six figures of events in
			# 24h and holding that in shell memory is not free.
			timeout 90 docker events --since 24h --until 0s > "$_evt" 2>&1 || true
			echo ":: $(grep -c . "$_evt") events in the window, $(grep -cE ' container exec_(create|start|die)' "$_evt") of them healthcheck exec_* bookkeeping (removed below)"
			echo
			grep -vE ' container exec_(create|start|die)' "$_evt" | tail -n 2000 || true
			rm -f "$_evt"
		fi
		unset _evt
	} > "${d}/events.txt" 2>&1 || true
	# Networks in full: subnet, gateway, driver, attached containers. `network ls` gives
	# names only, and a container that cannot reach its peers is usually explained here.
	{
		echo ":: docker network inspect, every network"
		echo
		nets="$(timeout 30 docker network ls -q 2>/dev/null | tr '\n' ' ')"
		if [ -n "$nets" ];then
			# shellcheck disable=SC2086
			timeout 60 docker network inspect $nets 2>&1 || true
		else
			echo ":: no networks listed, or the listing failed"
		fi
	} > "${d}/network_inspect.json" 2>&1 || true
	# Every container in ONE call, not one call per container: `docker inspect` accepts
	# many names, whereas a loop is N timeouts deep - 30 containers against a wedged
	# daemon would be 30x30s. One call is bounded whatever the container count, and it
	# also avoids shipping an empty inspect/ directory when there are none.
	{
		echo ":: docker inspect, every container from docker ps -a"
		echo
		ctrs="$(timeout 30 docker ps -a --format '{{.Names}}' 2>/dev/null | tr '\n' ' ')"
		if [ -n "$ctrs" ];then
			# Docker restricts names to [a-zA-Z0-9][a-zA-Z0-9_.-]*, so the split is safe
			# shellcheck disable=SC2086
			timeout 90 docker inspect $ctrs 2>&1 || true
		else
			echo ":: no containers listed, or the listing failed"
		fi
	} > "${d}/inspect.json" 2>&1 || true
	# The RESOLVED compose config - variables interpolated, defaults applied - as opposed
	# to the raw file rsynced into docker/agents/.
	{
		if [ ! -f /opt/metalsoft/agents/docker-compose.yaml ];then
			echo ":: /opt/metalsoft/agents/docker-compose.yaml is not present on this host"
		elif docker compose version &>/dev/null;then
			timeout 60 docker compose -f /opt/metalsoft/agents/docker-compose.yaml config 2>&1
		elif command -v docker-compose &>/dev/null;then
			timeout 60 docker-compose -f /opt/metalsoft/agents/docker-compose.yaml config 2>&1
		else
			echo ":: skipped: neither 'docker compose' nor 'docker-compose' is available"
		fi
	} > "${d}/compose_config.yaml" 2>&1 || true
	return 0
}

# Per-container netns: the SC counterpart to get_pod_netns. Read from the host with
# nsenter against the container's PID rather than `docker exec ip addr`, so it works on
# images that carry no 'ip' binary. Needs root; says so when it cannot.
function get_container_netns ()
{
	local out="${backupFolder}/docker/container_netns.txt" cids cmap
	{
		echo ":: Network namespace of each running container: addresses, routes, neighbours."
		echo ":: Unobtainable after the fact - a stale gateway ARP entry or a half-built veth"
		echo ":: only shows here."
		echo
		if ! command -v docker &>/dev/null;then
			echo ":: skipped: docker is not installed on this host"
		elif ! command -v nsenter &>/dev/null;then
			echo ":: skipped: nsenter is not installed on this host (util-linux)"
		else
			# Names and PIDs in ONE docker call. A per-container `docker inspect` is N
			# timeouts deep against a wedged daemon; after this, nsenter only touches
			# /proc, which cannot hang on the daemon. get_pod_netns takes the same shape on
			# the GC side by reading /run/netns instead of calling kubectl per pod.
			cids="$(timeout 60 docker ps -q 2>/dev/null | tr '\n' ' ')"
			if [ -z "$cids" ];then
				echo ":: no running containers, or the listing failed"
			else
				# container ids are hex, so the split is safe
				# shellcheck disable=SC2086
				cmap="$(timeout 60 docker inspect -f '{{.Name}} {{.State.Pid}}' $cids 2>&1)"
				if [ -z "$cmap" ];then
					echo ":: docker inspect returned nothing for the running containers"
				else
					printf '%s\n' "$cmap" | while read -r _cn _cpid;do
						test -n "$_cn" || continue
						# {{.Name}} carries a leading slash
						echo -e "\n:::: ${_cn#/} (pid ${_cpid:-unknown})\n"
						if [ -z "$_cpid" ] || [ "$_cpid" = "0" ];then
							echo ":: no PID - the container is not running"
							continue
						fi
						echo "-- ip -o addr"; timeout 10 nsenter -t "$_cpid" -n ip -o addr 2>&1 || echo "   (failed)"
						echo "-- ip route";   timeout 10 nsenter -t "$_cpid" -n ip route 2>&1 || echo "   (failed)"
						echo "-- ip neigh";   timeout 10 nsenter -t "$_cpid" -n ip neigh 2>&1 || echo "   (failed)"
					done
				fi
			fi
		fi
	} > "$out" 2>&1 || true
	return 0
}

function get_network ()
{
	ip a > "${backupFolder}/network/ip_addr.txt" 2>&1 || true
	ip r > "${backupFolder}/network/ip_route.txt" 2>&1 || true
	ip link > "${backupFolder}/network/ip_link.txt" 2>&1 || true
	command -v iptables &>/dev/null && iptables -t filter -vxnL > "${backupFolder}/network/iptables.txt" 2>&1 || true
	# -tulnp, not -tlnp: without -u there is not a single UDP listener in the archive,
	# and DNS - the most common thing to debug here - is UDP.
	host_cmd "${backupFolder}/network/ss.txt" 60 ss -tulnp
	host_cmd "${backupFolder}/network/ss_summary.txt" 30 ss -s
	command -v nft &>/dev/null && nft list ruleset > "${backupFolder}/network/nftables.txt" 2>&1 || true
	# The nat table is where kube-proxy's service DNAT lives in iptables mode (the k3s
	# default). nftables.txt covers it on iptables-nft hosts, but not iptables-legacy.
	host_cmd "${backupFolder}/network/iptables_nat.txt" 60 iptables -t nat -vxnL
	# ...but a kube-proxy in IPVS mode - common on kubeadm-built clusters, never on k3s -
	# keeps almost nothing in the nat table: the service backends live in the IPVS table
	# instead, and without this the whole service datapath is invisible on those clusters.
	host_cmd "${backupFolder}/network/ipvsadm.txt" 60 ipvsadm -Ln

	# Kernel networking knobs that silently break pod networking when wrong.
	{
		for _s in net.ipv4.ip_forward net.ipv4.conf.all.rp_filter net.ipv4.conf.default.rp_filter \
			net.ipv4.conf.all.arp_ignore net.ipv4.conf.all.arp_announce net.ipv4.conf.all.log_martians \
			net.bridge.bridge-nf-call-iptables net.bridge.bridge-nf-call-ip6tables \
			net.netfilter.nf_conntrack_max net.netfilter.nf_conntrack_count \
			net.netfilter.nf_conntrack_udp_timeout net.netfilter.nf_conntrack_buckets
		do
			printf '%-52s = %s\n' "$_s" "$(cat "/proc/sys/${_s//.//}" 2>/dev/null || echo '(unreadable/not loaded)')"
		done
		unset _s
		echo
		echo ":: per-interface rp_filter (strict=1 breaks pod networking on some CNIs)"
		for _f in /proc/sys/net/ipv4/conf/*/rp_filter;do
			test -r "$_f" && printf '%-52s = %s\n' "$_f" "$(cat "$_f" 2>/dev/null)"
		done
		unset _f
	} > "${backupFolder}/network/sysctl_net.txt" 2>&1 || true

	# conntrack-tools is frequently absent (it is NOT installed on our own demo
	# controller), so the counters above come from /proc and this is a bonus.
	if command -v conntrack &>/dev/null;then
		{
			echo ":: conntrack -S"
			timeout 30 conntrack -S 2>&1 || echo ":: (conntrack -S failed)"
			echo
			echo ":: conntrack -L -p udp --dport 53 (first 200 DNS flows)"
			timeout 60 conntrack -L -p udp --dport 53 2>&1 | head -200 || echo ":: (conntrack -L failed)"
		} > "${backupFolder}/network/conntrack.txt" 2>&1 || true
	else
		echo ":: skipped: conntrack is not installed on this host (counts in sysctl_net.txt come from /proc)" \
			> "${backupFolder}/network/conntrack.txt"
	fi
}

function get_ssl ()
{
	ls -laR /etc/ssl/certs/ &> "${backupFolder}/ssl/ls_etc_ssl_certs.txt" || true
	test -d /etc/pki/tls/certs/ && ls -laR /etc/pki/tls/certs/ &> "${backupFolder}/ssl/ls_etc_pki_tls_certs.txt" || true
	test -d /etc/pki/ca-trust/source/anchors/ && ls -laR /etc/pki/ca-trust/source/anchors/ &> "${backupFolder}/ssl/ls_etc_pki_ca_trust_anchors.txt" || true
	test -d /usr/local/share/ca-certificates/ && ls -laR /usr/local/share/ca-certificates/ &> "${backupFolder}/ssl/ls_usr_local_share_ca_certs.txt" || true
	test -f /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem && grep "^# " /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem > "${backupFolder}/ssl/ca_bundle_headers.txt" || true
	test -d /etc/ssl/certs/ && tar czf "${backupFolder}/ssl/etc_ssl_certs.tar.gz" /etc/ssl/certs/ &>/dev/null
	test -f /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem && cp /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem "${backupFolder}/ssl/ca_bundle.pem" || true
	test -d /etc/pki/ca-trust/source/anchors/ && \ls /etc/pki/ca-trust/source/anchors/|while read -r z;do echo ":::: $z";openssl x509 -noout -subject -in "/etc/pki/ca-trust/source/anchors/$z";done > "${backupFolder}/ssl/anchor_subjects.txt" || true
	test -f /etc/ssl/certs/ca-certificates.crt && cp /etc/ssl/certs/ca-certificates.crt "${backupFolder}/ssl/ca_certificates.crt" || true
}

# One line per cert for the ':: ssl expiry' section of collection_info.txt, plus an
# ALERT_CRITICAL line when the cert is already expired. $1 is the label, the PEM comes
# on stdin (never through a pipe: the caller needs the two variables back, and a pipe
# would run this in a subshell). openssl x509 reads the first cert of a chain = the leaf.
ssl_expiry_lines="" ssl_alerts=""
function ssl_expiry_line ()
{
	local pem cn san end
	pem="$(cat)"
	end="$(printf '%s\n' "$pem" | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)"
	test -n "$end" || { ssl_expiry_lines+="${1}: (unable to decode)"$'\n'; return; }
	cn="$(printf '%s\n' "$pem" | openssl x509 -noout -subject -nameopt sep_multiline 2>/dev/null | grep -m1 -oP 'CN=\K.*')"
	# CN alone is not the hostname: on the customer GC the CN is a different node than
	# the SAN traefik actually answers for, so list the SANs when the cert has any.
	san="$(printf '%s\n' "$pem" | openssl x509 -noout -ext subjectAltName 2>/dev/null | grep -oP 'DNS:\K[^,\s]+' | paste -sd, -)"
	local who="CN=${cn}${san:+ SAN=${san}}"
	if printf '%s\n' "$pem" | openssl x509 -noout -checkend 0 &>/dev/null;then
		ssl_expiry_lines+="${1}: ${who} notAfter=${end}"$'\n'
	else
		ssl_expiry_lines+="${1}: ${who} notAfter=${end} EXPIRED"$'\n'
		ssl_alerts+="ALERT_CRITICAL: SSL for ${1} (${who}) has expired at ${end} (now is $(date -u '+%F %T %Z'))"$'\n'
	fi
}

# GC-only post-collection check for the failure seen most often in the field: an
# expired cert. Two independent sources - the k8s secrets carrying tls.crt (the
# MetalSoft SSL traefik serves, k3s-serving, webhook certs), and the k3s node cert
# files (apiserver, kubelet, CAs, etcd), which traefik never touches but which take
# the cluster down when they lapse. The node files are checked even when the cluster
# is unreachable - that is exactly when an expired apiserver cert is the suspect.
function gc_ssl_expiry ()
{
	local f secret
	{
		for f in /var/lib/rancher/k3s/server/tls/*.crt /var/lib/rancher/k3s/server/tls/etcd/*.crt /var/lib/rancher/k3s/agent/*.crt;do
			test -f "$f" || continue
			echo ":::: $f"
			openssl x509 -noout -subject -issuer -dates -in "$f" 2>&1
			ssl_expiry_line "$f" < "$f"
		done
	} > "${backupFolder}/ssl/k3s_node_certs.txt" 2>&1 || true
	test -s "${backupFolder}/ssl/k3s_node_certs.txt" || echo ":: no k3s cert files under /var/lib/rancher/k3s (not a k3s node, or a different distribution)" > "${backupFolder}/ssl/k3s_node_certs.txt"
	if [ -n "$cluster_unreachable" ];then
		ssl_expiry_lines+="k8s secrets: skipped (cluster unreachable)"$'\n'
	elif [ -z "$tls_secrets" ];then
		ssl_expiry_lines+="k8s secrets: none carrying tls.crt, or the listing failed (see ssl/k8s_tls_certs.txt)"$'\n'
	else
		while read -r secret;do
			test -n "$secret" || continue
			ssl_expiry_line "secret ${secret}" < <(timeout 30 $k_orig -n "${secret%%/*}" get secret "${secret##*/}" -o jsonpath='{.data.tls\.crt}' 2>/dev/null | base64 -d 2>/dev/null)
		done <<< "$tls_secrets"
	fi
}

function get_disks ()
{
	# host_cmd, like df -i below: df walks every mount, so one slow or remounting
	# network filesystem stalls the collector before any of the rest is written.
	host_cmd "${backupFolder}/disk/df.txt" 60 df -h
	# Inodes: a filesystem can be 50% full by bytes and still refuse every write.
	host_cmd "${backupFolder}/disk/df_inodes.txt" 60 df -i
	# Both read every block device, which is where a stuck controller or a dead disk
	# shows up - and where they hang.
	host_cmd "${backupFolder}/disk/lsblk.txt" 30 lsblk
	host_cmd "${backupFolder}/disk/fdisk.txt" 30 fdisk -l
	# What actually consumes the filesystem. df reports /var at 81%; this says whether that
	# is container images, PV data under the k3s data-dir, or logs - the difference between
	# "prune images" and "move the PVs onto the big volume". -x keeps a separately mounted
	# child from being counted against its parent. No -s: GNU du refuses to combine it
	# with --max-depth.
	{
		echo ":: du -hx --max-depth=1 per runtime data-dir. Covers k3s/RKE2 and the vanilla"
		echo ":: kubeadm layout (containerd/docker/CRI-O image stores, etcd): the image store"
		echo ":: is usually what fills the filesystem and its path is distro-specific."
		# Two limits, because du walks the whole tree to size it and container layers are
		# millions of inodes on slow storage: 120s so one huge directory cannot starve the
		# paths after it, and a 300s total so the candidate list growing (9 paths now, to
		# cover every runtime) cannot multiply into 20 minutes of collector runtime.
		_dubudget=300
		_dut0=$SECONDS
		# One scratch file for du's stderr, reused per path rather than created inside the
		# loop, so there is nothing to leak on the `continue` paths. /dev/null when mktemp
		# fails: `[ -s /dev/null ]` is false, so the reporting below simply goes quiet.
		# Tested for emptiness, not just exit status, like the two other mktemp call sites
		# in this file: an empty path would make `: > ""` and `du 2>""` fail on every
		# iteration and take the du output down with them.
		_duerr="$(mktemp 2>/dev/null)"
		test -n "$_duerr" || _duerr=/dev/null
		for _dp in /var/lib/rancher/k3s /var/lib/rancher/rke2 /var/lib/kubelet \
			/var/lib/containerd /var/lib/docker /var/lib/containers /var/lib/etcd \
			/etc/kubernetes /var/log;do
			echo -e "\n:::: ${_dp}\n"
			if [ ! -d "$_dp" ];then
				echo ":: not present on this host"
				continue
			fi
			if [ $(( SECONDS - _dut0 )) -ge "$_dubudget" ];then
				echo ":: skipped: the ${_dubudget}s budget for this file was spent on earlier paths"
				continue
			fi
			: > "$_duerr"
			# PIPESTATUS because the pipeline's status is sort's, so a du that timed out
			# would otherwise look like a directory that is genuinely empty.
			timeout 120 du -hx --max-depth=1 "$_dp" 2>"$_duerr" | sort -h
			test "${PIPESTATUS[0]}" -eq 124 && echo ":: (du timed out after 120s - not walked)"
			# NOT 2>/dev/null: an unreadable subdirectory makes du UNDERCOUNT, and a silent
			# undercount reads as an authoritative size - so "/var is 81% full but nothing
			# accounts for it" becomes a dead end. The root check at the top of this script
			# is commented out, so a non-root run is reachable and yields one such line per
			# directory; bounded to a count plus a sample for that reason.
			if [ -s "$_duerr" ];then
				echo ":: NOTE: du could not read $(grep -c . "$_duerr") path(s) below this one, so"
				echo ":: the sizes above are an UNDERCOUNT. First lines of du's own output:"
				head -3 "$_duerr" | sed 's/^/::   /'
			fi
		done
		test "$_duerr" != /dev/null && rm -f "$_duerr"
		unset _dp _dubudget _dut0 _duerr
	} > "${backupFolder}/disk/usage_breakdown.txt" 2>&1 || true
	# Cached image inventory. An image a pod references that is NOT listed here was
	# garbage-collected by kubelet - which is exactly what DiskPressure triggers - turning
	# a later ImagePullBackOff on an air-gapped site from a mystery into a sequence.
	# Every available CLI, not the first one that exists: an elif chain commits to one and
	# reports an empty list when that runtime is not the one holding the images. A host
	# where containerd merely backs docker has a socket and an empty k8s.io namespace, and
	# the answer is in `docker images`.
	{
		_imgfound=""
		if [ -S /run/k3s/containerd/containerd.sock ] && command -v k3s &>/dev/null;then
			_imgfound=1
			echo ":: k3s ctr images ls"
			timeout 120 k3s ctr -a /run/k3s/containerd/containerd.sock images ls 2>&1 || true
			echo
		fi
		if command -v crictl &>/dev/null;then
			_imgfound=1
			echo ":: crictl images"
			timeout 120 crictl images 2>&1 || true
			echo; echo ":: crictl imagefsinfo"
			timeout 60 crictl imagefsinfo 2>&1 || true
			echo
		fi
		if command -v ctr &>/dev/null && [ -S /run/containerd/containerd.sock ];then
			_imgfound=1
			# -n k8s.io: kubelet's images live in that containerd namespace, not the default.
			echo ":: ctr -n k8s.io images ls"
			timeout 120 ctr -a /run/containerd/containerd.sock -n k8s.io images ls 2>&1 || true
			echo
		fi
		if command -v docker &>/dev/null;then
			_imgfound=1
			echo ":: docker images"
			timeout 120 docker images 2>&1 || true
			echo
		fi
		test -n "$_imgfound" || echo ":: skipped: no container runtime CLI (k3s ctr, crictl, ctr, docker) on this host"
		unset _imgfound
	} > "${backupFolder}/disk/images.txt" 2>&1 || true
}

# Per-pod network namespace state: neighbour cache, routes, addresses, link state.
# This is unobtainable after the fact and survives container restarts, so it is the
# only place a stale gateway ARP entry or a broken veth shows up. Uses `ip netns`
# (the CNI writes /run/netns/cni-*), so no crictl/nsenter dependency and no exec into
# containers. Everything is best-effort: needs root, and the netns files may be absent
# with other CNIs.
function get_pod_netns ()
{
	local out="${backupFolder}/network/pod_netns.txt" ipmap ns podid nslist addr br
	if ! command -v ip &>/dev/null;then
		echo ":: skipped: 'ip' is not installed on this host" > "$out"
		return 0
	fi
	nslist="$(ip netns list 2>/dev/null | awk '{print $1}')"
	if [ -z "$nslist" ];then
		{
			echo ":: no network namespaces listed by 'ip netns list'."
			echo ":: The CNI does not expose them under /run/netns (flannel/k3s does; Calico"
			echo ":: and others keep them unlinked). Nothing collected."
		} > "$out"
		return 0
	fi
	# 'ip netns list' succeeds for an unprivileged user - it only reads /run/netns - but
	# 'ip netns exec' needs CAP_SYS_ADMIN. Verified: as nobody, list returns rc=0 and
	# exec fails "Operation not permitted". Without this probe a non-root run emits one
	# "(failed)" block per namespace and never says why.
	if ! ip netns exec "$(printf '%s\n' "$nslist" | head -1)" true 2>/dev/null;then
		{
			echo ":: cannot enter network namespaces (need root / CAP_SYS_ADMIN)."
			echo ":: $(printf '%s\n' "$nslist" | grep -c .) namespaces are present but unreadable by uid $(id -u)."
			echo ":: Re-run the collector as root to capture per-pod routes and ARP caches."
		} > "$out"
		return 0
	fi
	# podIP -> namespace/name, via custom-columns: on -o wide the RESTARTS column
	# renders as "2 (8d ago)" and shifts every field after it, so positional awk on
	# -o wide silently yields "ago)" instead of the IP.
	ipmap="$(timeout 60 $k_orig get pod -A --no-headers \
		-o custom-columns=IP:.status.podIP,NS:.metadata.namespace,NAME:.metadata.name 2>/dev/null)"
	{
		echo ":: SCOPE: this is the LOCAL node only ($(hostname 2>/dev/null)). The cluster has"
		echo ":: $(timeout 30 $k_orig get nodes --no-headers 2>/dev/null | grep -c .) node(s); pods scheduled elsewhere have no entry here, and the same"
		echo ":: applies to network/iptables*, network/ss.txt, network/conntrack.txt and"
		echo ":: network/sysctl_net.txt. Re-run the collector on another node to capture it."
		echo
		echo ":: Host CNI bridge state. Compare each bridge's lladdr against the lladdr the"
		echo ":: pods below have cached for their default gateway - a mismatch is a stale ARP"
		echo ":: entry, which survives container restarts and breaks all egress from the pod."
		# Do not assume the bridge is named cni0: that is flannel/k3s. Enumerate instead.
		for br in $(ip -o link show type bridge 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1);do
			echo "-- bridge ${br}"
			ip -d link show "$br" 2>&1 | head -3 || true
			ip -o addr show "$br" 2>&1 || true
			echo "-- host neighbours on ${br}"
			ip neigh show dev "$br" 2>&1 || true
		done
		test -n "$(ip -o link show type bridge 2>/dev/null)" || echo "-- (no bridge interfaces; CNI may be routed-mode)"
		echo
		while read -r ns;do
			test -n "$ns" || continue
			echo "================================================================"
			# One exec for the addresses, reused for both the pod label and the dump:
			# 36 namespaces x an extra exec each is pure waste.
			addr="$(timeout 10 ip netns exec "$ns" ip -o addr show 2>&1)"
			podid=""
			for _ip in $(printf '%s\n' "$addr" | grep -oE 'inet [0-9.]+' | awk '{print $2}');do
				podid="$(printf '%s\n' "$ipmap" | awk -v i="$_ip" '$1==i{print $2"/"$3;exit}')"
				test -n "$podid" && break
			done
			unset _ip
			echo ":::: netns ${ns}${podid:+  ->  ${podid}}"
			echo "-- ip -o addr"; printf '%s\n' "$addr"
			echo "-- ip route";   timeout 10 ip netns exec "$ns" ip route 2>&1 || echo "   (failed)"
			echo "-- ip neigh";   timeout 10 ip netns exec "$ns" ip neigh 2>&1 || echo "   (failed)"
		done <<< "$nslist"
	} > "$out" 2>&1 || true
	return 0
}

function get_k8s_cluster ()
{
	timeout 60 $k_orig version > "${backupFolder}/k8s/cluster/version.txt" 2>&1 || true
	timeout 120 $k_orig describe nodes > "${backupFolder}/k8s/cluster/nodes.txt" 2>&1 || true
	timeout 60 $k_orig top nodes > "${backupFolder}/k8s/cluster/top_nodes.txt" 2>&1 || true
	timeout 60 $k_orig top pods -A > "${backupFolder}/k8s/cluster/top_pods.txt" 2>&1 || true

	# Events are pruned by kube-apiserver --event-ttl (1h by default), so this is a
	# narrow window no matter what we do. Widen what we can: -o wide adds the source
	# and object, the yaml keeps firstTimestamp/count/series (a 1h-old event with
	# count=80514 tells you it has been failing for weeks), and a Warning-only view
	# makes the file scannable.
	{
		echo ":: NOTE: the API only retains events for ~1h (kube-apiserver --event-ttl)."
		echo ":: For older history use the 'count'/'firstTimestamp' fields in events.yaml,"
		echo ":: the Events section of k8s/logs/describe_pod_*.txt, and container restart counts."
		echo
		get_events_wide
	} > "${backupFolder}/k8s/cluster/events.txt" 2>&1 || true
	timeout 60 $k_orig get events -A -o yaml > "${backupFolder}/k8s/cluster/events.yaml" 2>&1 || true
	get_events_wide --field-selector type=Warning > "${backupFolder}/k8s/cluster/events_warnings.txt" 2>&1 || true

	# Service endpoints: which pod IPs actually back a ClusterIP. Without this the only
	# way to learn that (say) kube-dns points at 10.42.0.4 is to read the NAT rules.
	k_cmd "${backupFolder}/k8s/cluster/endpoints.txt" 60 get endpoints -A -o wide
	k_cmd "${backupFolder}/k8s/cluster/endpointslices.txt" 60 get endpointslices -A
	# Separates "one component is broken" from "the apiserver itself is degraded".
	k_cmd "${backupFolder}/k8s/cluster/apiserver_readyz.txt" 60 get --raw '/readyz?verbose'
	k_cmd "${backupFolder}/k8s/cluster/apiservices.txt" 60 get apiservices
	# CoreDNS Corefile: forward target, cache, plugin order. Read-only, no secrets.
	k_cmd "${backupFolder}/k8s/cluster/coredns_configmap.yaml" 60 -n kube-system get cm coredns -o yaml
	# kube-proxy ConfigMap: says whether services are programmed in iptables, ipvs or
	# nftables mode, which decides which of the network/ dumps is the meaningful one.
	# k3s has no kube-proxy ConfigMap (it embeds kube-proxy) - the file will say NotFound.
	k_cmd "${backupFolder}/k8s/cluster/kube-proxy_configmap.yaml" 60 -n kube-system get cm kube-proxy -o yaml
	# kube-system ConfigMaps only - deliberately NOT secrets: kube-system holds
	# cluster-admin tokens and pulling them into an uploaded archive is not acceptable.
	k_cmd "${backupFolder}/k8s/resources/kube-system_configmaps.yaml" 120 -n kube-system get cm -o yaml

	# PersistentVolumes in full. The `get pv` table in k8s/resources/stats.txt carries
	# capacity, claim and reclaim policy but NOT spec.hostPath.path / spec.local.path -
	# and the path is the field every storage question turns on: where does this data
	# physically live, and will relocating the data-dir strand it.
	k_cmd "${backupFolder}/k8s/cluster/pv_pvc.yaml" 120 get pv,pvc -A -o yaml
	k_cmd "${backupFolder}/k8s/cluster/storageclasses.yaml" 60 get sc -o yaml
	# The derived view: each node-local PV path with its size, backing filesystem and
	# SELinux label. Statically-provisioned PVs commonly point outside the provisioner's
	# directory, so the path has to be read from the PV rather than assumed.
	{
		echo ":: PersistentVolumes and, for each node-local path they reference, the size of"
		echo ":: that path, the filesystem backing it and its SELinux label."
		echo
		timeout 60 $k_orig get pv -o custom-columns='NAME:.metadata.name,SC:.spec.storageClassName,RECLAIM:.spec.persistentVolumeReclaimPolicy,STATUS:.status.phase,CLAIM_NS:.spec.claimRef.namespace,CLAIM:.spec.claimRef.name,HOSTPATH:.spec.hostPath.path,LOCAL:.spec.local.path' 2>&1 || true
		# Same two limits as disk/usage_breakdown.txt, for the same reason: a cluster with
		# eight 100Gi PVs on slow storage would otherwise add 8x120s to the collector. -x
		# so a nested mount under a PV path is not walked into and counted here.
		_pvbudget=300
		_pvt0=$SECONDS
		timeout 60 $k_orig get pv -o jsonpath='{range .items[*]}{.spec.hostPath.path}{"\n"}{.spec.local.path}{"\n"}{end}' 2>/dev/null \
			| grep -v '^$' | sort -u | while read -r _p;do
			echo -e "\n:::: ${_p}\n"
			if [ ! -e "$_p" ];then
				echo ":: path does not exist on this node"
				continue
			fi
			# Bounded like the du below: a PV path is the one place in this archive where a
			# network filesystem is expected, and df/stat on a slow or remounting mount is
			# where the collector would otherwise sit. (A hard-mounted NFS server that is gone
			# blocks in D state, which no timeout can interrupt - this covers slow, not dead.)
			timeout 15 df -h "$_p" 2>&1 || true
			timeout 15 ls -Zd "$_p" 2>&1 || true
			if [ $(( SECONDS - _pvt0 )) -ge "$_pvbudget" ];then
				echo ":: du skipped: the ${_pvbudget}s budget for this file was spent on earlier paths"
				continue
			fi
			timeout 120 du -shx "$_p" 2>&1 || true
		done
		unset _pvbudget _pvt0
	} > "${backupFolder}/k8s/cluster/storage_paths.txt" 2>&1 || true

	# Admission webhooks. One with failurePolicy: Fail whose backing Service has no
	# endpoints blocks every create and update of the resources it intercepts, and the
	# resulting timeout names the webhook, not the dead pod behind it.
	k_cmd "${backupFolder}/k8s/cluster/webhooks.yaml" 60 get validatingwebhookconfiguration,mutatingwebhookconfiguration -o yaml
	{
		echo ":: configuration / webhook / target / failurePolicy."
		echo ":: Cross-check the target against k8s/cluster/endpoints.txt: a Service with no"
		echo ":: endpoints behind a Fail policy is a blocker."
		echo
		if command -v jq &>/dev/null;then
			timeout 60 $k_orig get validatingwebhookconfiguration,mutatingwebhookconfiguration -o json 2>/dev/null \
				| jq -r '.items[] | .metadata.name as $n | .webhooks[]? | [$n, .name, (if .clientConfig.service then "\(.clientConfig.service.namespace)/\(.clientConfig.service.name)" else (.clientConfig.url // "-") end), (.failurePolicy // "Fail")] | @tsv' 2>&1 || true
		else
			echo ":: skipped: jq is not installed on this host"
		fi
	} > "${backupFolder}/k8s/cluster/webhooks_summary.txt" 2>&1 || true

	if command -v helm &>/dev/null; then
		{
			echo ":: kubeconfig used: ${kubeconfig:-<none found, helm used its own defaults>}"
			echo
			if [ -n "$kubeconfig" ]; then
				KUBECONFIG="$kubeconfig" timeout 60 helm list -A 2>&1
			else
				timeout 60 helm list -A 2>&1
			fi
		} > "${backupFolder}/k8s/cluster/helm_releases.txt" || true
	fi
}

function get_k8s ()
{
	{
		echo -e "\n:: kubectl get node -o wide\n"
		$k get node -o wide 2>&1 || true
		echo -e "\n:: kubectl get pod -A\n"
		$k get pod -A -o wide 2>&1 || true
		echo -e "\n:: kubectl get svc -A\n"
		$k get svc -A 2>&1 || true
		echo -e "\n:: kubectl get deploy -A -o wide\n"
		$k get deploy -A -o wide 2>&1 || true
		echo -e "\n:: kubectl get pv -A\n"
		$k get pv -A 2>&1 || true
		echo -e "\n:: kubectl get pvc -A\n"
		$k get pvc -A 2>&1 || true
		echo -e "\n:: kubectl get ipaddresspool -A\n"
		$k get ipaddresspool -A 2>&1 || true
		echo -e "\n:: kubectl -n metallb-system get pods\n"
		$k_orig -n metallb-system get pods 2>&1 || true
	} >> "${backupFolder}/k8s/resources/stats.txt"

	# MetalLB advertisement CRs, not just the address pool. A LoadBalancer Service can
	# hold an EXTERNAL-IP that nothing is announcing: the pool assigns the address, the
	# L2Advertisement/BGPAdvertisement is what puts it on the wire. Without these the
	# pool alone reads as "configured" when the VIP is unreachable.
	# `get all` on its own, NOT combined with the CRs: kubectl fails the entire request if
	# any single requested type is unknown - verified against a live cluster,
	# `get all,ipaddresspool,doesnotexist` returns rc=1 and no output at all - so on a GC
	# without MetalLB a combined call would throw away the workload listing too.
	k_cmd "${backupFolder}/k8s/resources/metallb.txt" 60 -n metallb-system get all -o wide
	# Ask the API which metallb.io types exist instead of hardcoding a list. A fixed list
	# goes stale in both directions: a live 0.16 cluster also exposes configurationstates
	# (which carries a Valid/ERRORSUMMARY column worth having) and servicel2statuses, while
	# an older install without communities/bfdprofiles would make a fixed list fail
	# outright by the rule above.
	# Keep the exit status, not just the output: a degraded discovery API returns NOTHING
	# with its error on stderr, and reporting that as "MetalLB is not installed" would be
	# a false statement made exactly when the cluster is unwell. Verified against a live
	# apiserver - discovery failure exits 1, an unknown api-group exits 0 with no output,
	# so rc separates "could not ask" from "asked, none exist".
	_mlbraw="$(timeout 30 $k_orig api-resources --api-group=metallb.io --no-headers -o name 2>&1)"
	_mlbrc=$?
	if [ "$_mlbrc" -eq 0 ];then
		_mlbtypes="$(printf '%s\n' "$_mlbraw" | grep -v '^$' | tr '\n' ',' | sed 's/,$//')"
	else
		_mlbtypes=""
	fi
	{
		if [ "$_mlbrc" -ne 0 ];then
			echo ":: could not list metallb.io types (api-resources exited ${_mlbrc}). This is"
			echo ":: NOT evidence that MetalLB is absent - the discovery API did not answer:"
			printf '%s\n' "$_mlbraw" | head -5
		elif [ -z "$_mlbtypes" ];then
			echo ":: no metallb.io resource types are registered on this cluster"
		else
			echo ":: types: ${_mlbtypes}"
			echo
			timeout 60 $k_orig get "$_mlbtypes" -A -o wide 2>&1 || true
		fi
	} > "${backupFolder}/k8s/resources/metallb_crs.txt" 2>&1 || true
	{
		if [ "$_mlbrc" -ne 0 ];then
			echo ":: could not list metallb.io types (api-resources exited ${_mlbrc}); see metallb_crs.txt"
		elif [ -z "$_mlbtypes" ];then
			echo ":: no metallb.io resource types are registered on this cluster"
		else
			timeout 60 $k_orig get "$_mlbtypes" -A -o yaml 2>&1 || true
		fi
	} > "${backupFolder}/k8s/resources/metallb_crs.yaml" 2>&1 || true
	unset _mlbtypes _mlbraw _mlbrc

	$k_orig -n metallb-system get pods --no-headers | unhealthy_pods | while read -r pod
do
	echo -e "\n:: Logs for metallb-system $pod\n" >> "${backupFolder}/k8s/resources/metallb_logs.txt"
	timeout 120 $k_orig -n metallb-system logs "$pod" --timestamps --all-containers=true --prefix=true >> "${backupFolder}/k8s/resources/metallb_logs.txt" 2>&1 || true
done

	$k get ingressroute --no-headers|awk '{print $1}'|while read -r z;do $k get ingressroute "$z" -o yaml > "${backupFolder}/k8s/ingress/ingressroute_${z}.yaml";done || true
	$k get ingressroutetcp --no-headers|awk '{print $1}'|while read -r z;do $k get ingressroutetcp "$z" -o yaml > "${backupFolder}/k8s/ingress/ingressroutetcp_${z}.yaml";done || true
	$k get ingressrouteudp --no-headers|awk '{print $1}'|while read -r z;do $k get ingressrouteudp "$z" -o yaml > "${backupFolder}/k8s/ingress/ingressrouteudp_${z}.yaml";done || true

	k_cmd "${backupFolder}/k8s/resources/networkpolicies.txt" 60 get networkpolicy -A -o wide
	k_cmd "${backupFolder}/k8s/resources/networkpolicies.yaml" 60 get networkpolicy -A -o yaml

	{
		echo ":: pods that are not Running, or Running with containers not ready (READY m/n, m<n)."
		echo ":: Completed/Succeeded pods are skipped."
		$k_orig get pod -A --no-headers | unhealthy_pods | while read -r pns pname;do
			echo -e "\n:::: k describe pod -n ${pns} ${pname}\n"
			timeout 60 $k_orig describe pod -n "$pns" "$pname" 2>&1 || true
			echo -e "\n:::: previous (pre-restart) logs for ${pns}/${pname}, tail\n"
			previous_logs "$pns" "$pname" 2>&1 | tail -300 || true
		done
	} &> "${backupFolder}/k8s/resources/not_running.txt" || true
}

if [ "$gather" == 'gc' ];then
	# Extract hostname from configuration files
	config_hostname=""
	if [ -f /root/manifests/configmaps.yaml ]; then
		config_hostname="$(grep -oP 'cookie_domain: "\.\K.*[^"]' /root/manifests/configmaps.yaml 2>/dev/null | head -1)"
	fi
	if [ -z "$config_hostname" ] && [ -f /root/manifests/ingressroutes.yaml ]; then
		config_hostname="$(grep replacement: /root/manifests/ingressroutes.yaml 2>/dev/null | cut -d/ -f3 | head -1)"
	fi

	# Use extracted hostname if available, otherwise fall back to envname
	if [ -n "$config_hostname" ]; then
		envnamelabel="-${envname}-${config_hostname}-gc"
	else
		envnamelabel="-${envname}-gc"
	fi
    test -n "$config_hostname" && newbackupFolder="$(echo "${backupFolder}"|sed "s/__/-${config_hostname}-/")"

	if ! type $k >/dev/null 2>&1 ;then echo -e "[\e[1;31m✗\e[0m] ${bold}$k${nc} was not found. Exiting.."; exit 1;fi
	# Store original k for operations that don't need namespace
	k_orig="$k"
	test -z "$envname" && envname=$(timeout 60 $k_orig get pod -A|grep -v '^default'|grep mysql|head -1|awk '{print $1}') && test -z "$config_hostname" && envnamelabel="-${envname}-gc"
	test -n "$envname" && echo -e "[i] Namespace [-n]: \e[1;31m${envname}\e[0m"

	# Update k to include namespace
	k="$k -n $envname"

	# TODO: in cases where env is not found, we should still collect info on what went wrong
	# timeout: an unreachable or wedged apiserver must not stall the run indefinitely.
	# This used to `exit 1`, which produced NO bundle at all - and a dead control plane is
	# exactly when the host-level data (dmesg, journals, ss, sysctls, conntrack, per-pod
	# netns, disk) matters most. Now it flags the condition and collects what it still can.
	# Two very different conditions, deliberately kept apart. Judging both by "the
	# namespace is not in the output" conflates them: a typo'd -n on a perfectly healthy
	# cluster would claim the cluster was unreachable, spend ~30s collecting host data,
	# and emit a bundle labelled CLUSTER_UNREACHABLE - while hiding the one thing the
	# operator needs, the list of namespaces that DO exist.
	ns_list="$(timeout 60 $k_orig get ns 2>&1)"; ns_rc=$?
	if [ "$ns_rc" -ne 0 ];then
		# apiserver unreachable/wedged: collect what is still reachable (host level).
		echo -e "[\e[1;31m✗\e[0m] Cluster unreachable (kubectl get ns exited ${ns_rc})."
		echo -e "${orange}[!] collecting host-level diagnostics only; see CLUSTER_UNREACHABLE.txt in the archive${nc}"
		cluster_unreachable=1
	elif ! printf '%s\n' "$ns_list" | grep -q "$envname";then
		# cluster is fine, the namespace simply is not there - almost always a wrong -n.
		# Fail fast and show what is available; collecting host data would not help.
		echo -e "[\e[1;31m✗\e[0m] Namespace \e[1;31m${envname}\e[0m not found. Exiting.."
		printf '%s\n' "$ns_list"
		exit 1
	fi
	#mysql_pod="$($k -n $envname get pods --no-headers|grep mysql-|awk '{print $1}' | head -n 1)"

	if [ -z "$cluster_unreachable" ];then
	kubeconfig="$(detect_kubeconfig || true)"
	test -n "$kubeconfig" && echo -e "[i] kubeconfig: ${kubeconfig}" || echo -e "${orange}[!] no working kubeconfig found; helm output may be empty${nc}"

	# MetalSoft version, read off the license deployment image tag (present in every release).
	ms_version="$(timeout 30 $k get deploy license -o jsonpath='{.spec.template.spec.containers[*].image}' 2>/dev/null \
		| tr ' ' '\n' | grep -oP ':v?\K[0-9]+\.[0-9]+\.[0-9]+[^ ]*' | head -1)"
	# bsi was removed in 7.0.0. Gate on the deployment actually existing (authoritative,
	# also covers unparsable tags like :latest) and keep the version for the report.
	timeout 30 $k get deploy bsi &>/dev/null && bsi_present=1
	fi
	test -n "$ms_version" && echo -e "[i] MetalSoft version: \e[1;32m${ms_version}\e[0m"
	if [ -z "$bsi_present" ];then
		if version_ge "${ms_version:-0}" 7.0.0; then
			echo "[i] bsi deployment absent (expected on >= 7.0.0): skipping BSI checks"
		elif [ -n "$ms_version" ];then
			# bsi should exist below 7.0.0 - its absence is itself a finding, not a skip.
			echo -e "${orange}[!] bsi deployment MISSING on MetalSoft ${ms_version} (< 7.0.0), where it is expected: skipping BSI checks${nc}"
		else
			echo "[i] bsi deployment absent (MetalSoft version undetermined): skipping BSI checks"
		fi
	fi

	create_dirs
	get_system
	get_runtime_config
	get_network
	get_pod_netns
	get_disks
	get_ssl
	# Before the reachability branch on purpose: when the cluster is down, whether this
	# node can still reach its registries is one of the first things worth knowing.
	get_egress

	if [ -n "$cluster_unreachable" ];then
		{
			echo ":: The cluster/namespace could not be reached, so only host-level data was"
			echo ":: collected. Namespace requested: ${envname}"
			echo
			echo ":: kubectl get ns"; timeout 60 $k_orig get ns 2>&1
			echo; echo ":: kubectl cluster-info"; timeout 60 $k_orig cluster-info 2>&1
			echo; echo ":: kubectl version"; timeout 60 $k_orig version 2>&1
			echo; echo ":: node resolv.conf / hosts and the runtime journals are in system/"
		} > "${backupFolder}/CLUSTER_UNREACHABLE.txt" 2>&1 || true
	else
	get_k8s_cluster

	if [ -z "$SKIP_DISK_LATENCY_CHECK" ];then
		echo "[i] checking disk latency [100mb temp file] .."
		if [ -n "$bsi_present" ];then
			echo -e "\n:: BSI: df -h\n" >> "${backupFolder}/disk/bsi_df.txt"
			timeout 60 $k exec -it deploy/bsi -- bash -c "df -h" >> "${backupFolder}/disk/bsi_df.txt" 2>&1
			echo -e "\n:: time dd if=/dev/zero of=/testfile bs=4096 count=24400 oflag=direct status=progress\n" >> "${backupFolder}/disk/latency.txt"
			timeout 300 $k exec -it deploy/bsi -- bash -c "time dd if=/dev/zero of=/testfile bs=4096 count=24400 oflag=direct status=progress;rm -f /testfile" >> "${backupFolder}/disk/latency.txt" 2>&1
			echo -e "\n:: time dd if=/dev/zero of=/var/log/testfile bs=4096 count=24400 oflag=direct status=progress\n" >> "${backupFolder}/disk/latency.txt"
			timeout 300 $k exec -it deploy/bsi -- bash -c "time dd if=/dev/zero of=/var/log/testfile bs=4096 count=24400 oflag=direct status=progress;rm -f /var/log/testfile" >> "${backupFolder}/disk/latency.txt" 2>&1
		else
			# No bsi container to write into (>= 7.0.0). Measure the node's own disks
			# instead, otherwise every 7.x dump ships an empty latency.txt.
			echo "############ bsi deployment absent${ms_version:+ (MetalSoft ${ms_version})}: measured on the node instead of inside bsi" >> "${backupFolder}/disk/bsi_df.txt"
			# PID in the name: /var/log is OUTSIDE the per-run backup folder, so a fixed
			# "testfile" there is shared state. Two collectors - or one leftover from a
			# killed run - write the same path and one rm -f pulls the file out from
			# under the other's dd, making both latency numbers fiction. Verified: run
			# B's rm makes run A's file vanish mid-write. A killed run also strands
			# ~96MB, and on the customer node /var/log is a separate 4.0G LV at 51%.
			for _dlpath in "${backupFolder}" /var/log;do
				echo -e "\n:: node: time dd if=/dev/zero of=${_dlpath}/${_dlfile} bs=4096 count=24400 oflag=direct status=progress\n" >> "${backupFolder}/disk/latency.txt"
				{ time timeout 300 dd if=/dev/zero of="${_dlpath}/${_dlfile}" bs=4096 count=24400 oflag=direct status=progress ; } >> "${backupFolder}/disk/latency.txt" 2>&1
				rm -f "${_dlpath}/${_dlfile}"
			done
			unset _dlpath
		fi
	else
		echo "[-] Skipping disk latency check"
		echo "############ disk latency check skipped" >> "${backupFolder}/disk/latency.txt"
	fi
	get_k8s
	echo "[i] probing in-cluster DNS from running pods.."
	dns_probe

	mkdir -p "${backupFolder}/mysql"
	if [ "$extended" == '1' ];then
		echo "[i] backing up mysql databases.."
		#backup all mysql DBs:
		mysqldump_opts='--skip-comments'
		# Dump ceiling, derived from real data size rather than a flat guess. The original
		# code had NO timeout here, so a wedged DB hung the collector forever; a flat
		# ceiling is no better, because it silently truncates a legitimately large dump
		# and a truncated .sql.gz is worse than a slow one. Our own QA env holds 12.2 GB
		# across 1237 tables, which a 1800s ceiling would have cut off mid-dump.
		# 1800s floor + ~1s per 3 MB => a sustained floor of roughly 3 MB/s before we give
		# up. Falls back to the flat 1800s if the size query itself fails.
		mysql_total_mb="$(timeout 60 $k exec deploy/mysql -- mysql -ANe \
			'SELECT COALESCE(ROUND(SUM(data_length+index_length)/1024/1024),0) FROM information_schema.tables' \
			2>/dev/null | tr -dc '0-9')"
		if [[ "$mysql_total_mb" =~ ^[0-9]+$ ]] && [ "$mysql_total_mb" -gt 0 ];then
			mysqldump_timeout=$(( 1800 + mysql_total_mb / 3 ))
		else
			mysqldump_timeout=1800
		fi
		echo "[i] mysql data ${mysql_total_mb:-?} MB; per-database dump ceiling ${mysqldump_timeout}s"
		all_dbs="$(timeout 60 $k exec deploy/mysql -- mysql -AN $mysqldump_opts -e 'show databases' | grep -Ev "^(Database|performance_schema|information_schema|sys)$")"
		while read -r z;do
			_outfile="${backupFolder}/mysql/mysqldatabase_${z}_${envname}.sql.gz"
			if [ "$z" == "mysql" ];then
				timeout "$mysqldump_timeout" $k exec deploy/mysql -- mysqldump $mysqldump_opts --set-gtid-purged=OFF --databases "$z" --triggers --routines --events --add-drop-table --add-drop-database --single-transaction| sed '/.*DROP DATABASE IF EXISTS `mysql`/d' |gzip > "$_outfile"
			else
				timeout "$mysqldump_timeout" $k exec deploy/mysql -- mysqldump $mysqldump_opts --set-gtid-purged=OFF --databases "$z" --triggers --routines --events --add-drop-table --add-drop-database --single-transaction|gzip > "$_outfile"
			fi
			_pipe_rc=("${PIPESTATUS[@]}")
			if (( ${_pipe_rc[0]} + ${_pipe_rc[1]:-0} + ${_pipe_rc[2]:-0} )) || ! gzip -t "$_outfile" 2>/dev/null; then
				echo "${lightred}[!] mysqldump warning for '$z': exit codes=${_pipe_rc[*]}, gzip integrity=$(gzip -t "$_outfile" 2>&1 || echo FAILED). File may be incomplete.${nc}"
			fi
		done <<< "$all_dbs"
	fi

	echo "[i] backing up mysql locks.."
	# get information_schema.innodb_trx
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SHOW ENGINE INNODB STATUS\G' &> "${backupFolder}/mysql/mysql_show_engine_innodb_status" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'show full processlist' &> "${backupFolder}/mysql/mysql_show_full_processlist" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'show global variables\G' &> "${backupFolder}/mysql/mysql_show_global_variables" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'show global status' &> "${backupFolder}/mysql/mysql_show_global_status" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'show session variables\G' &> "${backupFolder}/mysql/mysql_show_session_variables" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SELECT * FROM information_schema.innodb_trx\G' &> "${backupFolder}/mysql/mysql_information_schema.innodb_trx" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SELECT * FROM performance_schema.data_locks' &> "${backupFolder}/mysql/mysql_performance_schema.data_locks" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SELECT TABLE_SCHEMA,table_comment FROM INFORMATION_SCHEMA.TABLES WHERE table_name = "_database_version"' &> "${backupFolder}/mysql/mysql_database_version" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'SELECT table_schema "DB Name", ROUND(SUM(data_length + index_length) / 1024 / 1024, 1) "DB Size in MB" FROM information_schema.tables GROUP BY table_schema' &> "${backupFolder}/mysql/mysql_database_size" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'select * from events order by event_occurred_timestamp desc limit 2000' metalsoft &> "${backupFolder}/mysql/mysql_metalsoft_events_latest" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'select * from afc_queue_exception_history order by afc_exception_id desc limit 2000\G' metalsoft &> "${backupFolder}/mysql/mysql_metalsoft_afc_queue_exception_history" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'select * from afc_queue_debug_log where datacenter_name <> "master" order by afc_updated_timestamp desc limit 2000\G' metalsoft &> "${backupFolder}/mysql/mysql_metalsoft_afc_queue_debug_log" || true
	timeout 120 $k exec deploy/mysql -- mysql -Ae 'select * from afc_queue where datacenter_name <> "master" order by afc_updated_timestamp desc limit 2000\G' metalsoft &> "${backupFolder}/mysql/mysql_metalsoft_afc_queue" || true
	{
		echo "# Which tables are causing the most I/O"
		echo "# Cumulative since mysqld start. Sort key: total_wait_s. High write_ops + high avg_wait_us = hot table; high read_ops with table scans (see below) = missing index."
		timeout 120 $k exec deploy/mysql -- mysql -Ae "SELECT object_schema AS db, object_name AS tbl, count_star AS total_ops, count_read AS read_ops, count_write AS write_ops, count_insert AS inserts, count_update AS updates, count_delete AS deletes, ROUND(sum_timer_wait / 1000000000000, 2) AS total_wait_s, ROUND(avg_timer_wait / 1000000, 3) AS avg_wait_us, ROUND(max_timer_wait / 1000000, 3) AS max_wait_us FROM performance_schema.table_io_waits_summary_by_table WHERE count_star > 0 AND object_schema NOT IN ('mysql', 'performance_schema', 'sys', 'information_schema') ORDER BY sum_timer_wait DESC LIMIT 25"
		echo
		echo "# Within those tables, which indexes / table scans are responsible"
		echo "# idx = '** TABLE SCAN (no index) **' with high ops/total_wait_s means queries on that table hit no index."
		timeout 120 $k exec deploy/mysql -- mysql -Ae "SELECT object_schema AS db, object_name AS tbl, IFNULL(index_name, '** TABLE SCAN (no index) **') AS idx, count_star AS ops, ROUND(sum_timer_wait / 1000000000000, 2) AS total_wait_s FROM performance_schema.table_io_waits_summary_by_index_usage WHERE count_star > 0 AND object_schema NOT IN ('mysql', 'performance_schema', 'sys') ORDER BY sum_timer_wait DESC LIMIT 30"
	} &> "${backupFolder}/mysql/mysql_performance_schema.table_io" || true
	{
		echo "# Top statements by total time (digest = literals normalised to ?). Cumulative since mysqld start."
		echo "# rows_examined >> rows_sent, no_index_used > 0, or tmp_disk_tables > 0 = candidate for an index or a rewrite."
		timeout 120 $k exec deploy/mysql -- mysql -Ae "SELECT SCHEMA_NAME AS db, COUNT_STAR AS execs, ROUND(SUM_TIMER_WAIT / 1000000000000, 2) AS total_s, ROUND(AVG_TIMER_WAIT / 1000000000, 3) AS avg_ms, ROUND(MAX_TIMER_WAIT / 1000000000, 3) AS max_ms, SUM_ROWS_EXAMINED AS rows_examined, SUM_ROWS_SENT AS rows_sent, SUM_ROWS_AFFECTED AS rows_affected, SUM_CREATED_TMP_DISK_TABLES AS tmp_disk_tables, SUM_NO_INDEX_USED AS no_index_used, SUM_SORT_SCAN AS sort_scans, FIRST_SEEN, LAST_SEEN, LEFT(DIGEST_TEXT, 1000) AS query FROM performance_schema.events_statements_summary_by_digest WHERE SCHEMA_NAME IS NULL OR SCHEMA_NAME NOT IN ('mysql', 'performance_schema', 'sys', 'information_schema') ORDER BY SUM_TIMER_WAIT DESC LIMIT 30\G"
		echo
		echo "# Current InnoDB lock waits: who is blocked, by whom, on what. Empty when healthy."
		timeout 120 $k exec deploy/mysql -- mysql -Ae "SELECT * FROM sys.innodb_lock_waits\G"
		echo
		echo "# Largest tables. data_free_mb = fragmentation / reclaimable space. table_rows is an InnoDB estimate."
		timeout 120 $k exec deploy/mysql -- mysql -Ae "SELECT table_schema AS db, table_name AS tbl, engine, table_rows, ROUND(data_length / 1024 / 1024, 1) AS data_mb, ROUND(index_length / 1024 / 1024, 1) AS index_mb, ROUND((data_length + index_length) / 1024 / 1024, 1) AS total_mb, ROUND(data_free / 1024 / 1024, 1) AS data_free_mb FROM information_schema.tables WHERE table_schema NOT IN ('mysql', 'performance_schema', 'sys', 'information_schema') ORDER BY data_length + index_length DESC LIMIT 40"
		echo
		echo "# File I/O by file since mysqld start: which tablespace / redo / binlog is hot. Correlate with the disk latency check."
		timeout 120 $k exec deploy/mysql -- mysql -Ae "SELECT * FROM sys.io_global_by_file_by_bytes LIMIT 20"
	} &> "${backupFolder}/mysql/mysql_performance_summary" || true
	echo "[i] backing up mysql schema.."
	mysql_start="$SECONDS"
	timeout 180 $k exec deploy/mysql -- mysqldump --add-drop-table --no-data --single-transaction --skip-comments --triggers --routines --events metalsoft &> "${backupFolder}/mysql/mysql_database_schema.sql"
	mysqldump_exitcode="$?"
	test $mysqldump_exitcode -ne "0" && mysqldump_exitcode_error="${lightred}[mysqldump failed with exit code $mysqldump_exitcode]${nc}"
	mysql_end="$SECONDS"
	mysql_elapsed=$((mysql_end-mysql_start))
	echo "[+] ${mysql_elapsed} sec $mysqldump_exitcode_error"
	#backup all couchdb DBs:
	couchdbUrl="$($k get svc|grep couchdb|awk '{print $3":"$5}'|sed 's/ /:/g'|cut -d/ -f1)"
	test -n "${HTTP_PROXY:-}" && test -n "$couchdbUrl" && curl_no_proxy="env NO_PROXY=$(echo -n "$couchdbUrl"|cut -d: -f1)"
	test -n "${http_proxy:-}" && test -n "$couchdbUrl" && curl_no_proxy="env no_proxy=$(echo -n "$couchdbUrl"|cut -d: -f1)"

    # --max-time on every couchdb call: a Service IP with no endpoint behind it does
    # not refuse the connection, it black-holes it, and curl waits indefinitely.
    if [ "$($curl_no_proxy curl -s --max-time 15 -o /dev/null -w "%{http_code}" "${couchdbUrl}/_all_dbs")" != "200" ];then
      couchdb_admin_user="$($k get configmap common -o json|jq -r .data.couchdb_admin_user)"
      couchdb_admin_password="$($k get configmap common -o json|jq -r .data.couchdb_admin_password)"
      if [ -n "$couchdb_admin_user" ] && [ -n "$couchdb_admin_password" ];then
        couchdbUrl="${couchdb_admin_user}:${couchdb_admin_password}@${couchdbUrl}"
      fi
    fi

	mkdir -p "${backupFolder}/couchdb"
	if [[ "$couchdbUrl" =~ ^([^:]+):([^@]*)@(.+)$ ]]; then
		echo "[i] backing up couchdb: [${BASH_REMATCH[1]}:${BASH_REMATCH[2]:0:4}****@${BASH_REMATCH[3]}]"
	else
		echo "[i] backing up couchdb: [${couchdbUrl}]"
	fi
	if ! $curl_no_proxy curl -sS --max-time 15 "http://${couchdbUrl}/_all_dbs" | jq -rce . &>/dev/null; then
		echo "CouchDB: $curl_no_proxy http://${couchdbUrl}/_all_dbs did not return valid JSON. Is proxy being used?" > "${backupFolder}/couchdb/couchdb_pull_failed"
	fi
	# Deliberately SERIAL, unlike the pod-log loop. Measured on demo: this whole phase is
	# 1 second of a 252s run, so there is nothing to win - while running it -j wide would
	# multiply peak memory, because each worker pipes a full _all_docs?include_docs=true
	# response through jq, which buffers the entire document set. Tiny here, not
	# necessarily tiny on a production install.
	while read -r z;do
		test -n "$z" || continue
		$curl_no_proxy curl -sk --max-time 300 "http://${couchdbUrl}/$z/_all_docs?include_docs=true"|jq '{"docs": [.rows[].doc]}' | jq 'del(.docs[]._rev)'|jq -c .|gzip > "${backupFolder}/couchdb/couchdb_backup_${z}.gz"
	done < <(test -n "$couchdbUrl" && $curl_no_proxy curl -sk --max-time 15 "http://${couchdbUrl}/_all_dbs" | jq -r ".[]" 2>/dev/null)

	echo "[i] backing up k8s pod runtime logs.."
	# --all-containers + --prefix so init-container output is captured too (kubectl
	# otherwise silently picks one container: "Defaulted container X out of: X, Y (init)").
	# --timestamps because plenty of containers log without a clock of their own, which
	# makes them impossible to line up against events/dmesg.
	# --previous for anything that has restarted: the current log only shows the newest
	# crash cycle, and the interesting failure is usually in the one before.
	# ALL namespaces, not just ours: coredns, metrics-server, metallb and the CNI live in
	# kube-system, and their logs are exactly what gets asked for when DNS or LB breaks.
	# Naming: pods in our own namespace keep their historic pod_<name>.log filenames;
	# every other namespace is prefixed pod_<ns>_<name>.log, because pod names are only
	# unique within a namespace (two 'nginx' or two 'traefik-*' would overwrite).
	# Previous logs sit next to the current ones in the same folder.
	# Process substitution, NOT "cmd | while": a piped while-loop body runs in a subshell,
	# so background jobs started inside it are that subshell's children and the `wait`
	# after the loop - which runs in the parent - cannot see them. The script would then
	# tar the archive while log fetches were still writing into it.
	while read -r pns pname prestarts;do
		if [ -z "$pns" ] || [ -z "$pname" ];then continue;fi
		if [ "$pns" == "$envname" ];then
			_lf="pod_${pname}"; _df="describe_pod_${pname}"
		else
			_lf="pod_${pns}_${pname}"; _df="describe_pod_${pns}_${pname}"
		fi
		# One subshell per pod: every command below writes its own file, so there is
		# nothing to serialise. throttle caps concurrency at -j (default 4) - each worker
		# is a separate kubectl with its own client QPS budget, and this collector runs
		# against clusters that are already unhealthy, so the cap matters.
		(
			timeout 300 $k_orig -n "$pns" logs "$pname" --timestamps --all-containers=true --prefix=true \
				> "${backupFolder}/k8s/logs/${_lf}.log" 2>&1 || true
			if [ "${prestarts:-0}" -gt 0 ] 2>/dev/null;then
				previous_logs "$pns" "$pname" > "${backupFolder}/k8s/logs/${_lf}_previous.log" 2>&1 || true
			fi
			timeout 60 $k_orig -n "$pns" describe pod "$pname" > "${backupFolder}/k8s/logs/${_df}.txt" 2>&1 || true
		) &
		throttle "$parallel"
	done < <(timeout 60 $k_orig get pod -A --no-headers 2>/dev/null | awk '{print $1" "$2" "$5+0}')
	throttle 1   # NOT bare `wait`: see the throttle comment - bare wait blocks on the
	             # tee process substitutions this script installs on stdout/stderr.
	unset _lf _df
	# bsi was dropped in MetalSoft 7.0.0; skip its checks entirely when it is not deployed.
	if [ -n "$bsi_present" ];then
	timeout 60 $k exec -it deploy/bsi -- bash -c 'supervisorctl status all' > "${backupFolder}/k8s/bsi/supervisorctl.txt" 2>&1
	bsipod="$($k get pod --no-headers|grep ^bsi|awk '{print $1}')"
	test -n "$bsipod" && while read -r bsi;do
	if [ -z "$sqlUpgradeLogs" ];then
		varlogs="$(timeout 120 $k exec -it "$bsi" -- bash -c 'find /var/log/ExportVHosts/bsi/ \( -path "/var/log/ExportVHosts/bsi/BSI/Endpoints/JSONRPC/*" -or -path "/var/log/ExportVHosts/bsi/PHP_*" -or -path "/var/log/ExportVHosts/bsi/switchDevices/*" \) -type f -iname "*.log"' 2>/dev/null|tr -d '\r')"
	else
		varlogs="$(timeout 120 $k exec -it "$bsi" -- bash -c 'find /var/log/ExportVHosts/bsi/ \( -path "/var/log/ExportVHosts/bsi/BSI/Endpoints/JSONRPC/*" -or -path "/var/log/ExportVHosts/bsi/PHP_*" -or -path "/var/log/ExportVHosts/bsi/SQLUpgrader/*/finished_logs/*" -or -path "/var/log/ExportVHosts/bsi/switchDevices/*"  \) -type f -iname "*.log" -or -iname "*.sql"' 2>/dev/null|tr -d '\r')"
	fi

	test -n "$varlogs" && while read -r z;do timeout 120 $k cp "$bsi:${z}" "${backupFolder}/k8s/bsi/varlog/${bsi}_${z//\//_}" &>/dev/null;done <<< "$varlogs"

	varlogsbsi="$(timeout 120 $k exec -it "$bsi" -- bash -c 'find /var/log/ -maxdepth 1 -type f -iname "bsi-*.log"' 2>/dev/null|tr -d '\r')"
	test -n "$varlogsbsi" && while read -r z;do timeout 120 $k cp "$bsi:${z}" "${backupFolder}/k8s/bsi/varlog/${bsi}_${z//\//_}" &>/dev/null;done <<< "$varlogsbsi"
done <<< "$bsipod"
	else
		echo "bsi deployment not present${ms_version:+ (MetalSoft ${ms_version})}: BSI checks skipped (bsi was removed in 7.0.0)" > "${backupFolder}/k8s/bsi/supervisorctl.txt"
	fi

$k get secret --no-headers|awk '{print $1}'|while read -r z;do echo -e '\n---';$k get secret "$z" -o yaml;done > "${backupFolder}/k8s/resources/secrets.yaml"
$k get cm --no-headers|awk '{print $1}'|while read -r z;do echo -e '\n---';$k get cm "$z" -o yaml;done > "${backupFolder}/k8s/resources/configmaps.yaml"
# When the listing above fails, the while body never runs and the file is left EMPTY -
# which reads as "this namespace has no secrets/configmaps" rather than "the dump
# failed". Record the reason instead. Only fires when the file is already empty, so a
# successful dump is untouched.
test -s "${backupFolder}/k8s/resources/secrets.yaml" || \
	{ echo ":: nothing was dumped - the namespace has no secrets, or the listing failed:"; $k get secret 2>&1; } > "${backupFolder}/k8s/resources/secrets.yaml" 2>&1 || true
test -s "${backupFolder}/k8s/resources/configmaps.yaml" || \
	{ echo ":: nothing was dumped - the namespace has no configmaps, or the listing failed:"; $k get cm 2>&1; } > "${backupFolder}/k8s/resources/configmaps.yaml" 2>&1 || true

	# GC-specific SSL: TLS secret expiry.
	# Select by the presence of a tls.crt key, not by secret type: the MetalSoft SSL
	# secret traefik serves (<ns>-ssl) is type Opaque, and filtering on kubernetes.io/tls
	# skipped it - the one cert whose expiry cuts every SC off the controller. The list
	# is kept in $tls_secrets for gc_ssl_expiry so the cluster is asked only once.
	tls_secrets="$(timeout 60 $k_orig get secrets -A -o json 2>/dev/null | jq -r '.items[] | select(.data["tls.crt"] != null) | .metadata.namespace + "/" + .metadata.name' 2>/dev/null)"
	{
		printf '%s\n' "$tls_secrets" | while read -r secret; do
			test -n "$secret" || continue
			ns_name="${secret%%/*}"
			sec_name="${secret##*/}"
			echo ":::: $ns_name/$sec_name"
			timeout 30 $k_orig -n "$ns_name" get secret "$sec_name" -o jsonpath='{.data.tls\.crt}' 2>/dev/null | base64 -d 2>/dev/null | openssl x509 -noout -subject -enddate 2>/dev/null || echo "  (unable to decode)"
		done
	} > "${backupFolder}/ssl/k8s_tls_certs.txt" 2>&1 || true
	# Same trap as secrets.yaml: if the listing or jq fails the while body never runs and
	# the file is empty, which is indistinguishable from "this cluster has no TLS secrets".
	test -s "${backupFolder}/ssl/k8s_tls_certs.txt" || \
		{ echo ":: no secrets carrying tls.crt found, or the listing failed:"
		  command -v jq &>/dev/null || echo ":: jq is not installed on this host - the listing cannot run"
		  timeout 60 $k_orig get secrets -A 2>&1 | head -20; } > "${backupFolder}/ssl/k8s_tls_certs.txt" 2>&1 || true
	# GC-specific SSL: traefik cert logs.
	# There is no 'traefik' namespace: traefik is deployed per environment inside the
	# environment's own namespace (traefik-<ns>), so a cluster can hold several. Select
	# by chart label in the namespace being collected, and fall back to a name match.
	{
		traefik_deploys="$(timeout 30 $k get deploy -l app.kubernetes.io/name=traefik -o name 2>/dev/null)"
		test -z "$traefik_deploys" && traefik_deploys="$(timeout 30 $k get deploy -o name 2>/dev/null | grep traefik)"
		if [ -z "$traefik_deploys" ];then
			echo ":: no traefik deployment found in namespace ${envname}"
		else
			while read -r tdeploy;do
				test -n "$tdeploy" || continue
				echo ":::: ${envname}/${tdeploy} (cert lines only; full log in k8s/logs/pod_traefik-*.log)"
				# Piping kubectl's stderr straight into 'grep -i cert' turns a failed
				# fetch into "(no cert lines)" and hides it - that invisibility is what
				# kept the old '-n traefik' bug alive. Check PIPESTATUS instead of
				# buffering the log in a variable: traefik access logs can be huge.
				timeout 120 $k logs "$tdeploy" --timestamps 2>&1 | grep -i cert
				_trc=("${PIPESTATUS[@]}")
				if [ "${_trc[0]}" -ne 0 ];then
					echo "  (log fetch failed, kubectl/timeout exit ${_trc[0]})"
				elif [ "${_trc[1]}" -ne 0 ];then
					echo "  (log fetched, no cert-related lines)"
				fi
			done <<< "$traefik_deploys"
			unset _trc
		fi
	} > "${backupFolder}/ssl/traefik_certs.txt" 2>&1 || true

if [ "$extended" == '1' ];then
	echo "[i] backing up k8s resources.."
	# k8s backups
	$k api-resources --no-headers|awk '{print $1}'|while read -r z;do mkdir -p "${backupFolder}/k8s/api_resources/${z}";$k get "$z" --no-headers 2>/dev/null|awk '{print $1}'|while read -r a;do $k get "$z" "$a" -o yaml > "${backupFolder}/k8s/api_resources/${z}/${z}_${a}.yaml" 2>/dev/null;done;done || true

	echo "[i] backing up k8s container logs.."
	# -L follows the symlinks /var/log/containers is made of, so this reads through to
	# the real log files: bounded, because a full log directory on slow storage is
	# exactly the state being investigated.
	test -d /var/log/containers && mkdir -p "${backupFolder}/container_logs" && timeout 300 rsync -azL /var/log/containers/* "${backupFolder}/container_logs/" || true
fi

	fi   # end of the cluster-reachable branch

else # if gather=sc
	# Assign only when the derivation actually yields something. Unconditionally, a missing
	# compose file (or a changed URL= line) leaves envname EMPTY - clobbering any -n the
	# operator passed - and the archive ships as ms-diagnostics-<date>--sc.tar.gz with
	# nothing identifying the site, in the filename or in the push metadata. The
	# config_hostname block below already guards exactly this way.
	_sc_env="$(grep -oP '\s+- URL=.*' /opt/metalsoft/agents/docker-compose.yaml 2>/dev/null|tail -1 |cut -d/ -f3)"
	test -n "$_sc_env" && envname="$_sc_env"
	unset _sc_env

	# Extract hostname from docker-compose.yaml
	config_hostname=""
	if [ -f /opt/metalsoft/agents/docker-compose.yaml ]; then
		# grep -v on comment lines first: the shipped compose template carries commented
		# KEY=value examples (HTTP_PROXY, HTTPS_PORT, ...), so a stale commented-out
		# CONTROLLER_* line is a realistic shape - and head -1 would take it in preference
		# to the live one, pointing the archive name, both DNS probes, the egress matrix
		# and the TLS check at a host this agent does not talk to. Verified.
		config_hostname="$(grep -v '^[[:space:]]*#' /opt/metalsoft/agents/docker-compose.yaml 2>/dev/null | grep CONTROLLER_WS_URI= | cut -d/ -f3 | head -1)"
		if [ -z "$config_hostname" ]; then
			config_hostname="$(grep -v '^[[:space:]]*#' /opt/metalsoft/agents/docker-compose.yaml 2>/dev/null | grep CONTROLLER_REMOTE_CONSOLE_URI= | cut -d/ -f3 | head -1)"
		fi
		if [ -z "$config_hostname" ]; then
			config_hostname="$(grep -v '^[[:space:]]*#' /opt/metalsoft/agents/docker-compose.yaml 2>/dev/null | grep CONTROLLER_TCP_ADDRESS= | cut -d= -f2 | cut -d: -f1 | head -1)"
		fi
	fi
	# Last resort, and the most truthful source of the three: the environment the agent
	# container is ACTUALLY running with. The compose file can disagree with it - edited
	# after the last `up`, the CONTROLLER_* lines commented out, or the file replaced -
	# whereas this is what the running agent is talking to. Without it the controller,
	# the one endpoint an agent cannot work without, silently drops out of the DNS probe
	# and the egress matrix and the TLS check reports itself skipped.
	# ms-agent only, by name: it is the container that holds the controller URIs, and
	# naming it directly means no `docker ps` call and no reading of environments that
	# have nothing to do with the controller. Absent or not running, inspect fails and
	# the hostname simply stays empty.
	if [ -z "$config_hostname" ] && command -v docker &>/dev/null;then
		_cenv="$(timeout 60 docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' ms-agent 2>/dev/null)"
		config_hostname="$(printf '%s\n' "$_cenv" | grep -m1 'CONTROLLER_WS_URI=' | cut -d/ -f3)"
		test -n "$config_hostname" || config_hostname="$(printf '%s\n' "$_cenv" | grep -m1 'CONTROLLER_REMOTE_CONSOLE_URI=' | cut -d/ -f3)"
		test -n "$config_hostname" || config_hostname="$(printf '%s\n' "$_cenv" | grep -m1 'CONTROLLER_TCP_ADDRESS=' | cut -d= -f2 | cut -d: -f1)"
		unset _cenv
	fi

	# Assembled from the parts that actually have a value. A site controller has no
	# namespace of its own - on this demo agent $envname is empty (collection_info.txt
	# reports "namespace: <none>"), because the compose file carries no URL= line and -n
	# is not required on the SC side - so interpolating it unconditionally produced
	# ms-diagnostics-<date>--<host>-sc.tar.gz. Anything absent now contributes no segment
	# rather than an empty one, and the shape when both are known is unchanged.
	envnamelabel=""
	test -n "$envname"         && envnamelabel="${envnamelabel}-${envname}"
	test -n "$config_hostname" && envnamelabel="${envnamelabel}-${config_hostname}"
	envnamelabel="${envnamelabel}-sc"
	test -n "$config_hostname" && newbackupFolder="$(echo "${backupFolder}"|sed "s/__/-${config_hostname}/")"

	create_dirs
	get_system
	# Also on the SC side: the containerd config, the docker unit and its drop-ins, and
	# /etc/docker/daemon.json in context are what decide where an agent pulls from and how
	# dockerd was started, and none of it is reproduced anywhere else in an SC bundle. The
	# k3s/RKE2 paths in there simply report themselves absent on a compose host, which is
	# an answer; a missing runtime_config.txt is not.
	get_runtime_config
	get_network
	get_disks
	get_ssl

	get_egress
	echo "[i] backing up docker stats.."
	get_docker
	get_container_netns
	echo "[i] probing DNS from running containers.."
	docker_dns_probe
	test -f /opt/metalsoft/agents/docker-compose.yaml && timeout 120 rsync -a /opt/metalsoft/agents/ "${backupFolder}/docker/agents/" || true
	# Recursive walk of an NFS mount. Bounded, and it says so when it was cut short:
	# a truncated listing otherwise reads as a directory with fewer files in it.
	if [ -d /opt/metalsoft/nfs-storage ];then
		timeout 30 ls -lahR /opt/metalsoft/nfs-storage/ > "${backupFolder}/nfs/storage_ls.txt" 2>&1 \
			|| echo ":: (ls exited non-zero or timed out after 30s - the listing above may be partial)" >> "${backupFolder}/nfs/storage_ls.txt"
	fi
	# Every call to the daemon is bounded from here down. Verified: with DOCKER_HOST
	# pointed at an unreachable address the CLI was still blocked at 25s, so a wedged
	# dockerd - the state an SC bundle is usually collected in - stopped the run here
	# and produced no archive at all. host_cmd where the call is a plain command, so a
	# timed-out or failed collection says so in its own file instead of looking empty.
	host_cmd "${backupFolder}/docker/status.txt" 30 systemctl status docker
	host_cmd "${backupFolder}/docker/ps.txt"     60 docker ps -a
	# No `|| true`: grep exits 1 when nothing is restarting, which would run `true` and
	# overwrite PIPESTATUS with 0 (verified). An empty restarting.txt reads as "no
	# container is restarting" - a health signal - and without this it says exactly the
	# same thing when the daemon timed out and nothing was ever listed.
	timeout 60 docker ps|grep Restarting > "${backupFolder}/docker/restarting.txt"
	# Any non-zero from `docker ps`, not only the 124 of a timeout: docker absent exits 127
	# and a daemon that answers with an error exits 1, and BOTH leave this file empty, i.e.
	# saying the same thing as a healthy host. Captured into a variable first because
	# PIPESTATUS is overwritten by the next pipeline that runs.
	_psrc="${PIPESTATUS[0]}"
	if [ "$_psrc" -ne 0 ];then
		{
			echo ":: (docker ps exited ${_psrc} - 124 is the 60s timeout, 127 is docker not"
			echo ":: installed, anything else is the daemon refusing. Nothing was listed, so"
			echo ":: an empty file here is NOT a clean bill of health - see docker/ps.txt.)"
		} >> "${backupFolder}/docker/restarting.txt"
	fi
	unset _psrc
	# timeout, like the GC pod-log loop already has: `docker logs` against a wedged daemon
	# never returns, and a collector that hangs produces no bundle at all. It does not
	# truncate anything in the normal case.
	timeout 60 docker ps|grep Restarting|awk '{print $1}'|while read -r z;do timeout 300 docker logs "$z" --tail=1000 > "${backupFolder}/docker/restarting_${z}.txt" 2>&1;done || true
	host_cmd "${backupFolder}/docker/images.txt"    60 docker images -a
	host_cmd "${backupFolder}/docker/info.txt"      60 docker info
	host_cmd "${backupFolder}/docker/system_df.txt" 60 docker system df
	host_cmd "${backupFolder}/docker/networks.txt"  60 docker network ls
	host_cmd "${backupFolder}/docker/volumes.txt"   60 docker volume ls
	test -f /etc/docker/daemon.json && cp /etc/docker/daemon.json "${backupFolder}/docker/daemon.json" || true
	host_cmd "${backupFolder}/docker/journalctl.txt" 60 journalctl -u docker -n 500 --no-pager
	test -f /opt/metalsoft/agents/docker-compose.yaml && grep -oP '\s+\-\s+\K/opt/metalsoft/logs[^\:]*' /opt/metalsoft/agents/docker-compose.yaml|while read -r z;do echo "$z"|while read -r f;do find "$f" -type f \( -iname "*.log" -o -iname "*.log.1" \) -exec cp {} "${backupFolder}/docker/agents-logs/" \;;done;done
	# Full logs, deliberately untruncated - but bounded in time, same reason as above.
	test -f /opt/metalsoft/agents/docker-compose.yaml && timeout 60 docker ps -a --format '{{.Names}}.{{.ID}}'|while read -r z;do timeout 300 docker logs "${z%%.*}" > "${backupFolder}/docker/logs/${z}.log" 2>&1;done
	# SC-specific SSL: openssl to GC
	# config_hostname, not a CONTROLLER_TCP_ADDRESS grep: that variable is commented out
	# as of agent v7.2.0 ("should not be needed as of v7.2.0", verified in the compose
	# file on a current agent), so the grep returned nothing and this check was silently
	# skipped on every modern site controller. config_hostname is derived above from
	# CONTROLLER_WS_URI, then REMOTE_CONSOLE_URI, then TCP_ADDRESS, so it still resolves
	# on old agents. %%:* strips a port the URI forms carry.
	GCURL="${config_hostname:-}"
	GCURL="${GCURL%%:*}"
	# s_client blocks for the kernel's SYN-retry window against a controller that does
	# not answer - measured still blocked at 120s against a blackholed address - and "the
	# agent cannot reach the controller" is the condition this bundle is usually collected
	# under. host_cmd bounds it and writes the file whatever happens, including when
	# openssl is absent; </dev/null on the call, or s_client sits waiting on stdin after
	# the handshake instead of exiting.
	if [ -n "$GCURL" ];then
		host_cmd "${backupFolder}/ssl/openssl_443.txt" 20 openssl s_client -connect "${GCURL}:443" -servername "$GCURL" -tlsextdebug -status -bugs < /dev/null
	else
		echo ":: skipped: no controller hostname found in /opt/metalsoft/agents/docker-compose.yaml (CONTROLLER_WS_URI / CONTROLLER_REMOTE_CONSOLE_URI / CONTROLLER_TCP_ADDRESS)" > "${backupFolder}/ssl/openssl_443.txt"
	fi
	test -d /opt/metalsoft/ansible-jobs && tar czf "${backupFolder}/ansible-jobs.tar.gz" /opt/metalsoft/ansible-jobs &>/dev/null
fi

# Provenance. Read this file first on any bundle: it says which build of the collector
# produced it, so output missing because the customer is running an old copy is not
# mistaken for output missing because the collection failed. The timestamps come from
# the script file itself rather than a version string, so there is nothing to forget to
# bump - mtime is when this copy was installed. The clock block is here because the
# archive mixes three time bases: pod logs in UTC, dmesg in node-local time, and kubectl
# ages relative to the moment of collection.
test "$gather" == 'gc' && gc_ssl_expiry
{
	echo ":: collector"
	# One field per stat call: %n is the FILE NAME, not a newline, so a combined format
	# string silently runs the fields together.
	echo "path:  $(realpath "$0" 2>/dev/null || echo "$0")"
	stat -c 'mtime: %y' "$(realpath "$0")" 2>&1 || true
	stat -c 'ctime: %z' "$(realpath "$0")" 2>&1 || true
	echo "invoked as: $0 ${invocationArgs}"
	echo
	echo ":: clock at collection time"
	echo "utc:   $(date -u '+%F %T %Z')"
	echo "local: $(date '+%F %T %Z %z')"
	command -v timedatectl &>/dev/null && timedatectl show -p Timezone --value 2>/dev/null | sed 's/^/tz:    /'
	echo "elapsed: ${SECONDS}s"
	echo
	echo ":: environment"
	# timeout: hostname -f asks the resolver, and a broken resolver is precisely the
	# condition this bundle is often collected under.
	echo "hostname:   $(timeout 5 hostname -f 2>/dev/null || hostname 2>/dev/null)"
	echo "gather:     ${gather}"
	echo "namespace:  ${envname:-<none>}"
	echo "ms_version: ${ms_version:-<undetermined>}"
	echo "extended:   ${extended:-0}"
	if [ "$gather" == 'gc' ];then
		echo "kubeconfig: ${kubeconfig:-<none found>}"
		if [ -n "$cluster_unreachable" ];then
			echo "cluster:    UNREACHABLE (host-level data only; see CLUSTER_UNREACHABLE.txt)"
		else
			echo "cluster:    reachable"
		fi
		timeout 30 $k_orig version 2>&1 | head -4 || true
		echo
		echo ":: ssl expiry"
		printf '%s' "$ssl_expiry_lines"
		echo
		# Empty when nothing is wrong: an empty section means checked and clean.
		echo ":: alerts"
		printf '%s' "$ssl_alerts"
	fi
} > "${backupFolder}/collection_info.txt" 2>&1 || true
# Alerts also go to the console, red, so the operator sees them without opening the
# archive. Only alerts: the full expiry list stays in collection_info.txt.
test -n "$ssl_alerts" && printf '%s' "$ssl_alerts" | sed "s/^/${lightred}[!] /;s/\$/${nc}/"

echo "[i] creating an archive.."
test -f "$bash_log" && mv "$bash_log" "${backupFolder}/bash_log.txt" &>/dev/null
resultFilename="${originalBackupFolder}/ms-diagnostics-${thedate}${envnamelabel}.tar.gz"
test -z "$newbackupFolder" && newbackupFolder="$backupFolder"
test "$backupFolder" != "$newbackupFolder" && mv "${backupFolder}" "${newbackupFolder}"
tar czf "${resultFilename}" -C "$(dirname "${newbackupFolder%*/}")" "${newbackupFolder##*/}" >/dev/null 2>&1 && \
	rm -rf "$newbackupFolder" && {
	filesize="$(du -h "${resultFilename}" | awk '{print $1}')"
	echo -e "[\e[1;32m✓\e[0m][$filesize][${SECONDS}s] Please provide the following file to MetalSoft Team:\n${lightgreen}${resultFilename}${nc}"
} || { echo -e "[\e[1;31m✗\e[0m] Error: Unable to create: ${resultFilename}"; exit 2; }

	curl_log="${originalBackupFolder}/diagnostics-collector-curl-${thedate}.log"
	if [ "$pushfile" == "1" ];then
		echo -n "[i] Trying to auto-push the diagnostics file to MetalSoft [HTTPS]...${orange} "
		http_code="$(push_diag "https://diagnostics-report.metalsoft.io/?a=121&f=992&pushparam=1&ns=${envname}" "$resultFilename" "$curl_log")"
		curl_exit=$?
		if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
			echo -e "${nc}Done (HTTP $http_code)\n"
			rm -f "$curl_log"
		else
			echo -e "${nc}\n[\e[1;31m✗\e[0m] Push failed (HTTP ${http_code:-000}, curl exit ${curl_exit}). Trace: $curl_log"
			exit 1
		fi
	else
		if timeout 3 bash -c "</dev/tcp/176.223.248.10/443" 2>/dev/null; then
			if [ -z "$doNotAutoSend" ]; then
				http_code="$(push_diag "https://diagnostics-report.metalsoft.io/?a=121&f=992&autopush=1&ns=${envname}" "$resultFilename" "$curl_log")"
				curl_exit=$?
				autopush_tried=1
				# A successful auto-upload says nothing: the operator hands the file over
				# manually regardless of whether we already received it. No sleep before
				# exiting either - measured, output is not lost without it (0/12 over ssh),
				# and the message it used to pace is gone.
				if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
					rm -f "$curl_log"
					exit 0
				fi
				# A failure DOES need saying, because the file did not reach us and the
				# operator has to send it. Offering the interactive upload right after an
				# upload just failed is noise, so $autopush_tried suppresses that prompt.
				echo -e "${orange}[!] Auto-upload to MetalSoft failed (HTTP ${http_code:-000}, curl exit ${curl_exit}).${nc}"
				echo -e "${orange}[!] Please provide the diagnostics file to the MetalSoft Team manually.${nc}"
				echo -e "${gray}    curl trace: ${curl_log}${nc}"
			fi
		fi
		if [ -z "$doNotAutoSend" ] && [ -z "$autopush_tried" ];then
			# stderr is redirected into bash_log via tee; route prompt to /dev/tty so the user can see it.
			read -r -p "${orange}[?] Send the file to MetalSoft Team via HTTPS POST? [y/N]${nc} " yn </dev/tty 2>/dev/tty
			case $yn in
				[Yy]* )
					echo -n "[i] Trying to push the diagnostics file to MetalSoft [HTTPS]...${orange} "
					http_code="$(push_diag "https://diagnostics-report.metalsoft.io/?a=121&f=992&promptedpush=1&ns=${envname}" "$resultFilename" "$curl_log")"
					curl_exit=$?
					if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
						echo -e "${nc}Done (HTTP $http_code)\n"
						rm -f "$curl_log"
					else
						echo -e "${nc}\n[\e[1;31m✗\e[0m] Push failed (HTTP ${http_code:-000}, curl exit ${curl_exit}). Trace: $curl_log"
					fi
					;;
				* ) exit;;
			esac
		fi
	fi
